{
  "main": "dist/_worker.js/index.js",
  "name": "date-my-dish",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "RATINGS",
      "id": "24d232d9f632423e8e45dc04f6f8ddf0"
    }
  ],
  "$schema": "node_modules/wrangler/config-schema.json"
}
