{
  "main": "./src/worker.ts",
  "name": "date-my-dish",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat",
    "disable_nodejs_process_v2"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    // Maintenance mode: must be true while MAINTENANCE_MODE is "true" so the
    // Worker (src/worker.ts) sees static page requests. Set both back to turn it off.
    "run_worker_first": true
  },
  "vars": {
    "MAINTENANCE_MODE": "true"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "RATINGS",
      "id": "24d232d9f632423e8e45dc04f6f8ddf0"
    }
  ],
  "$schema": "node_modules/wrangler/config-schema.json"
}
