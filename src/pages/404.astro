---
import BaseLayout from "@layouts/BaseLayout.astro";
import { t } from "@i18n/utils";
import monogram from "@assets/brand/monogram.svg?raw";
---

<BaseLayout
  title="Page Not Found | Date My Dish"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div class="page-container flex flex-col items-start py-section">
    <div class="h-24 w-16 text-ink [&>svg]:h-full [&>svg]:w-full" aria-hidden="true" set:html={monogram} />
    <p class="eyebrow mt-10">404</p>
    <h1 class="mt-4 max-w-2xl text-heading-1 text-ink sm:text-display">
      {t("en", "notFound.title")}
    </h1>
    <p class="mt-6 max-w-measure font-body text-body-lg text-ink-muted">
      {t("en", "notFound.body")}
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/en/" class="btn btn-primary">
        {t("en", "notFound.home")} (English)
      </a>
      <a href="/fr/" lang="fr" class="btn btn-secondary">
        {t("fr", "notFound.home")} (Français)
      </a>
    </div>
  </div>
</BaseLayout>
