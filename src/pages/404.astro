---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Date My Dish"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div class="mx-auto flex max-w-narrow flex-col items-center px-4 py-section text-center">
    <img src="/favicon.svg" class="mb-6 h-24 w-24" alt="" width="96" height="96" />
    <h1 class="mb-4 font-heading text-heading-1 font-bold text-gray-900 sm:text-4xl dark:text-gray-100">
      Page Not Found
    </h1>
    <p class="mb-8 text-body-lg text-gray-600 dark:text-gray-400">
      This recipe seems to have gone missing from our kitchen. Let's get you back on track.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/en/"
        class="rounded-lg bg-brand-primary-dark px-6 py-3 font-ui text-body-sm font-semibold text-white no-underline shadow-sm transition-colors hover:bg-brand-primary"
      >
        Home (English)
      </a>
      <a
        href="/fr/"
        lang="fr"
        class="rounded-lg border border-brand-primary px-6 py-3 font-ui text-body-sm font-semibold text-brand-primary-text no-underline transition-colors hover:bg-gray-50 dark:hover:bg-gray-800/50"
      >
        Accueil (Français)
      </a>
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-4 text-body-sm">
      <a href="/en/recipes/" class="text-brand-primary-text hover:text-brand-accent">
        Browse Recipes
      </a>
      <span class="text-gray-300 dark:text-gray-500">|</span>
      <a href="/fr/recettes/" lang="fr" class="text-brand-primary-text hover:text-brand-accent">
        Parcourir les recettes
      </a>
    </div>
  </div>
</BaseLayout>
