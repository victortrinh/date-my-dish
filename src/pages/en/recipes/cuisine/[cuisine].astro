---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath, getCuisineLocalizedPath, getCuisineFromSlug } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "en";

const MIN_RECIPES_FOR_INDEX = 3;

export async function getStaticPaths() {
  const { getCuisineSlug } = await import("@i18n/utils");
  const recipes = await getCollection("recipes");
  const enRecipes = recipes.filter((r) => r.data.lang === "en");
  const cuisines = [...new Set(enRecipes.map((r) => r.data.recipeCuisine))];

  return cuisines.map((cuisine) => {
    const slug = getCuisineSlug(cuisine, "en");
    return {
      params: { cuisine: slug },
      props: {
        cuisineName: cuisine,
        recipes: enRecipes.filter((r) => r.data.recipeCuisine === cuisine),
      },
    };
  });
}

const { cuisineName, recipes } = Astro.props;
const cuisineSlug = Astro.params.cuisine!;
const cuisineLabel = t(locale, `cuisines.${getCuisineFromSlug(cuisineSlug, locale)}` as any) || cuisineName;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const shouldNoindex = sortedRecipes.length < MIN_RECIPES_FOR_INDEX;

const allRecipes = await getCollection("recipes");
const enRecipes = allRecipes.filter((r) => r.data.lang === "en");
const allCuisines = [...new Set(enRecipes.map((r) => r.data.recipeCuisine))];
allCuisines.sort((a, b) => {
  const countA = enRecipes.filter((r) => r.data.recipeCuisine === a).length;
  const countB = enRecipes.filter((r) => r.data.recipeCuisine === b).length;
  return countB - countA;
});

const cuisineDescriptions: Record<string, string> = {
  Italian: `Italian cooking is the art of doing more with less. Pecorino, black pepper, and pasta water become cacio e pepe. A slow braise transforms tough cuts into something tender enough to eat with a spoon. These are the dishes that built the most romantic food culture on earth, and they're all within reach of your home kitchen.

Whether you're rolling out fresh pappardelle or simply boiling dried spaghetti with intention, Italian date nights have a rhythm: uncork the wine first, let the sauce take its time, and never rush the table. Our Italian collection covers the full range, from 25-minute weeknight pastas to slow-cooked ragus that reward your patience.`,
  Mediterranean: `Sun, olive oil, and the conviction that vegetables deserve center stage. Mediterranean cooking pulls from coastal traditions where fresh ingredients do the heavy lifting and technique stays simple. These recipes bring that same philosophy to your kitchen, whether you're charring eggplant or frying calamari until golden.

The Mediterranean approach to date night is effortless by design: bold flavors, beautiful colors, and the kind of food that looks impressive without requiring a culinary degree.`,
};

const description = cuisineDescriptions[cuisineName] ||
  `Explore our ${cuisineLabel} recipes. From weeknight favorites to date night showstoppers, find your next dish.`;
const metaDescription = `${cuisineLabel} date night recipes that impress. From quick weeknight dishes to slow-cooked showstoppers, cook ${cuisineLabel.toLowerCase()} at home with confidence.`;
---

<BaseLayout
  title={`${cuisineLabel} Recipes | Date My Dish`}
  description={metaDescription}
  noindex={shouldNoindex}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','viewcategory');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `${cuisineLabel} Recipes`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^en\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
        { label: `${cuisineLabel} Cuisine` },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-warm-900 sm:text-4xl dark:text-warm-100">
        {cuisineLabel} Recipes
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-rose"></div>
      {cuisineDescriptions[cuisineName] && (
        <div class="mb-6 space-y-4 text-body-sm text-warm-600 dark:text-warm-400">
          {cuisineDescriptions[cuisineName].split("\n\n").map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
      <p class="text-body-sm text-warm-500 dark:text-warm-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recipe" : "recipes"}
      </p>
    </div>

    <!-- Cuisine Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/en/recipes/"
        class="rounded-lg border border-warm-200 px-4 py-2 font-ui text-body-sm font-medium text-warm-600 no-underline transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allCuisines.map((c) => {
        const cSlug = getCuisineLocalizedPath(locale, c).split("/").pop()!;
        const cLabel = t(locale, `cuisines.${getCuisineFromSlug(cSlug, locale)}` as any) || c;
        return (
          <a
            href={`${getCuisineLocalizedPath(locale, c)}/`}
            class:list={[
              "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
              c === cuisineName
                ? "bg-brand-wine text-white dark:text-white dark:hover:text-white shadow-md"
                : "border border-warm-200 text-warm-600 transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400",
            ]}
            aria-current={c === cuisineName ? "page" : undefined}
          >
            {cLabel}
          </a>
        );
      })}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {sortedRecipes.map((recipe: any, i: number) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-warm-500 dark:text-warm-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
