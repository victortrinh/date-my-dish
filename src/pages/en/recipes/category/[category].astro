---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "en";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  const enRecipes = recipes.filter((r) => r.data.lang === "en");
  const categories = [...new Set(enRecipes.flatMap((r) => r.data.recipeCategory))];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      recipes: enRecipes.filter((r) => r.data.recipeCategory.includes(category)),
    },
  }));
}

const { category, recipes } = Astro.props;
const categoryLabel = t(locale, `categories.${category}` as any) || category;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const allRecipes = await getCollection("recipes");
const enRecipes = allRecipes.filter((r) => r.data.lang === "en");
const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const allCategories = [...new Set(enRecipes.flatMap((r) => r.data.recipeCategory))];
allCategories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={`${categoryLabel} Recipes | Date My Dish`}
  description={`Browse our ${categoryLabel.toLowerCase()} recipes. Find your next favorite ${categoryLabel.toLowerCase()} dish.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `${categoryLabel} Recipes`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^en\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
        { label: categoryLabel },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-gray-900 sm:text-4xl dark:text-neutral-100">
        {categoryLabel}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-accent"></div>
      <p class="text-body-sm text-gray-500 dark:text-neutral-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recipe" : "recipes"}
      </p>
    </div>

    <!-- Category Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/en/recipes/"
        class="rounded-lg border border-gray-200 px-4 py-2 font-ui text-body-sm font-medium text-gray-600 no-underline transition-colors hover:border-brand-primary hover:text-brand-primary dark:border-neutral-600 dark:text-neutral-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allCategories.map((cat) => (
        <a
          href={`/en/recipes/category/${cat}/`}
          class:list={[
            "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
            cat === category
              ? "bg-brand-primary-dark text-white dark:text-white dark:hover:text-white shadow-md"
              : "border border-gray-200 text-gray-600 transition-colors hover:border-brand-primary hover:text-brand-primary dark:border-neutral-600 dark:text-neutral-400",
          ]}
          aria-current={cat === category ? "page" : undefined}
        >
          {t(locale, `categories.${cat}` as any) || cat}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {sortedRecipes.map((recipe: any) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-gray-500 dark:text-neutral-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
