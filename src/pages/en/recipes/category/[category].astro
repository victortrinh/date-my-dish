---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "en";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  const enRecipes = recipes.filter((r) => r.data.lang === "en");
  const categories = [...new Set(enRecipes.flatMap((r) => r.data.recipeCategory))];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      recipes: enRecipes.filter((r) => r.data.recipeCategory.includes(category)),
    },
  }));
}

const { category, recipes } = Astro.props;
const categoryLabel = t(locale, `categories.${category}` as any) || category;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title={`${categoryLabel} Recipes | Date My Dish`}
  description={`Browse our ${categoryLabel.toLowerCase()} recipes. Find your next favorite ${categoryLabel.toLowerCase()} dish.`}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
        { label: categoryLabel },
      ]}
    />

    <h1 class="mb-8 font-heading text-4xl font-bold text-gray-900">
      {categoryLabel}
    </h1>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedRecipes.map((recipe: any) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              difficulty={recipe.data.difficulty}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-gray-500">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
