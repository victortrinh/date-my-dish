---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "en";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  const enRecipes = recipes.filter((r) => r.data.lang === "en");
  const categories = [...new Set(enRecipes.flatMap((r) => r.data.recipeCategory))];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      recipes: enRecipes.filter((r) => r.data.recipeCategory.includes(category)),
    },
  }));
}

const { category, recipes } = Astro.props;
const categoryLabel = t(locale, `categories.${category}` as any) || category;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const categoryDescriptions: Record<string, string> = {
  dinner: "The main event. These are the dishes that anchor date night, the ones that fill your kitchen with aromas worth lingering over. From 25-minute pastas to slow-cooked braises, dinner is where the magic happens.\n\nWhether you're cooking for two or showing off for a crowd, every recipe here is built to impress without burning you out. Bold flavors, approachable techniques, and plates worth photographing.",
  appetizer: "The first bite sets expectations for the whole evening. These starters are designed to impress before the main course even hits the table.\n\nThink of appetizers as your opening line: confident, a little unexpected, and impossible to forget. Small plates, big impact.",
  dessert: "Sweet endings that leave a lasting impression. Every dessert here earns its spot on the table.",
  "side-dish": "The supporting cast that steals the show. Sides worth making room on the plate for.",
  breakfast: "Morning recipes worth waking up for. Start the day with something genuinely delicious.",
  lunch: "Midday meals that go beyond the sad desk salad. Fresh, satisfying, and ready when you are.",
  snack: "Quick bites for when hunger strikes between meals.",
  drink: "Sips and cocktails to pair with your favorite dishes.",
  sauce: "Sauces, dressings, and drizzles that elevate everything they touch.",
};

const allRecipes = await getCollection("recipes");
const enRecipes = allRecipes.filter((r) => r.data.lang === "en");
const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const allCategories = [...new Set(enRecipes.flatMap((r) => r.data.recipeCategory))];
allCategories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={`${categoryLabel} Recipes | Date My Dish`}
  description={categoryDescriptions[category]?.split("\n\n")[0] || `Browse our ${categoryLabel.toLowerCase()} recipes. Find your next favorite ${categoryLabel.toLowerCase()} dish.`}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','viewcategory');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `${categoryLabel} Recipes`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^en\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
        { label: categoryLabel },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-normal text-warm-900 sm:text-4xl dark:text-warm-100">
        {categoryLabel}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-rose"></div>
      {categoryDescriptions[category] && (
        categoryDescriptions[category].split("\n\n").map((paragraph) => (
          <p class="mb-2 text-body-sm text-warm-500 dark:text-warm-400">{paragraph}</p>
        ))
      )}
      <p class="text-body-sm text-warm-500 dark:text-warm-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recipe" : "recipes"}
      </p>
    </div>

    <!-- Category Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/en/recipes/"
        class="rounded-lg border border-warm-200 px-4 py-2 font-ui text-body-sm font-medium text-warm-600 no-underline transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allCategories.map((cat) => (
        <a
          href={`/en/recipes/category/${cat}/`}
          class:list={[
            "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
            cat === category
              ? "bg-brand-wine text-white dark:text-white dark:hover:text-white shadow-md"
              : "border border-warm-200 text-warm-600 transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400",
          ]}
          aria-current={cat === category ? "page" : undefined}
        >
          {t(locale, `categories.${cat}` as any) || cat}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {sortedRecipes.map((recipe: any, i: number) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-warm-500 dark:text-warm-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
