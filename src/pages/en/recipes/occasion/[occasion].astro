---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath, getOccasionLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { SITE_URL } from "@utils/constants";

const locale = "en";

const OCCASION_ORDER = ["date-night", "weeknight", "entertaining", "comfort", "celebration", "quick-meal"];

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  const enRecipes = recipes.filter((r) => r.data.lang === "en");
  const occasions = [...new Set(enRecipes.flatMap((r) => r.data.occasion || []))];

  return occasions.map((occasion) => ({
    params: { occasion },
    props: {
      occasion,
      recipes: enRecipes.filter((r) => (r.data.occasion || []).includes(occasion)),
    },
  }));
}

const { occasion, recipes } = Astro.props;
const occasionLabel = t(locale, `occasion.${occasion}` as any) || occasion;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const allRecipes = await getCollection("recipes");
const enRecipes = allRecipes.filter((r) => r.data.lang === "en");
const allOccasions = [...new Set(enRecipes.flatMap((r) => r.data.occasion || []))];
allOccasions.sort((a, b) => {
  const ai = OCCASION_ORDER.indexOf(a);
  const bi = OCCASION_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});

const MIN_RECIPES_FOR_INDEX = 3;
const shouldNoindex = sortedRecipes.length < MIN_RECIPES_FOR_INDEX;

const occasionDescriptions: Record<string, string> = {
  "date-night": "Cooking for someone you love is one of the most romantic things you can do. These date night recipes are built for exactly that: dishes with impressive plating, bold flavors, and timing that actually works when you're also trying to light candles and pick a playlist. Every recipe here has been tested so you can pull it off without breaking a sweat.\n\nThe best part? You get to choose your own adventure. Cook it together and make the kitchen part of the date, or surprise them with something beautiful already on the table. Either way, these recipes make dinner the main event.",
  weeknight: "You got home late, you're hungry, and the couch is calling. We get it. These weeknight recipes prove that 30 minutes is more than enough to make something worth sitting down for. No sad desk-lunch energy here, just real food that comes together fast.\n\nThe secret is smart technique, not shortcuts that kill flavor. You'll find dishes that lean on high heat, punchy sauces, and ingredients that do the heavy lifting. Because \"quick\" should never mean \"boring.\"",
  entertaining: "Hosting should feel like a party for you too, not a solo shift in the kitchen while everyone else has fun. These entertaining recipes are designed for exactly that: dishes you can partially prep ahead, assemble with confidence, and serve without stress.\n\nThe trick is choosing recipes that look stunning but don't demand your constant attention. Think platters that build themselves, sauces you made yesterday, and desserts already chilling in the fridge. Your guests will think you're effortless. Let them.",
  comfort: "Some nights call for the cozy side of cooking. Slow braises, rich sauces, crusty bread for dipping, and the kind of food that makes you want to stay in forever. These comfort recipes are built for rainy evenings, \"let's just stay home\" moods, and anyone who thinks sweatpants are valid dinner attire.\n\nThis is food that wraps around you like a blanket. No rush, no fuss, just deep flavors that fill the kitchen with the kind of smell that makes everything feel right.",
  celebration: "Special occasion recipes worth celebrating. From anniversaries to milestones.",
  "quick-meal": "Delicious meals ready in no time. Fast, fresh, and full of flavor.",
};
---

<BaseLayout
  title={`${occasionLabel} Recipes | Date My Dish`}
  description={occasionDescriptions[occasion] || `Browse our ${occasionLabel.toLowerCase()} recipes. Find your next favorite dish.`}
  noindex={shouldNoindex}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','viewcategory');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `${occasionLabel} Recipes`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^en\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `${SITE_URL}${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
        { label: occasionLabel },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-normal text-warm-900 sm:text-4xl dark:text-warm-100">
        {occasionLabel}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-rose"></div>
      {occasionDescriptions[occasion]?.split("\n\n").map((paragraph) => (
        <p class="mb-2 text-body-sm text-warm-500 dark:text-warm-400">
          {paragraph}
        </p>
      ))}
      <p class="text-body-sm text-warm-500 dark:text-warm-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recipe" : "recipes"}
      </p>
    </div>

    <!-- Occasion Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/en/recipes/"
        class="rounded-lg border border-warm-200 px-4 py-2 font-ui text-body-sm font-medium text-warm-600 no-underline transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allOccasions.map((occ) => (
        <a
          href={getOccasionLocalizedPath(locale, occ)}
          class:list={[
            "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
            occ === occasion
              ? "bg-brand-wine text-white dark:text-white dark:hover:text-white shadow-md"
              : "border border-warm-200 text-warm-600 transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400",
          ]}
          aria-current={occ === occasion ? "page" : undefined}
        >
          {t(locale, `occasion.${occ}` as any) || occ}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {sortedRecipes.map((recipe: any, i: number) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-warm-500 dark:text-warm-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
