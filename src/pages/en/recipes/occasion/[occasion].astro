---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath, getOccasionLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "en";

const OCCASION_ORDER = ["date-night", "weeknight", "entertaining", "comfort", "celebration", "quick-meal"];

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  const enRecipes = recipes.filter((r) => r.data.lang === "en");
  const occasions = [...new Set(enRecipes.flatMap((r) => r.data.occasion || []))];

  return occasions.map((occasion) => ({
    params: { occasion },
    props: {
      occasion,
      recipes: enRecipes.filter((r) => (r.data.occasion || []).includes(occasion)),
    },
  }));
}

const { occasion, recipes } = Astro.props;
const occasionLabel = t(locale, `occasion.${occasion}` as any) || occasion;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const allRecipes = await getCollection("recipes");
const enRecipes = allRecipes.filter((r) => r.data.lang === "en");
const allOccasions = [...new Set(enRecipes.flatMap((r) => r.data.occasion || []))];
allOccasions.sort((a, b) => {
  const ai = OCCASION_ORDER.indexOf(a);
  const bi = OCCASION_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});

const occasionDescriptions: Record<string, string> = {
  "date-night": "Romantic recipes to impress your special someone. Cook together, plate beautifully, and make dinner the main event.",
  weeknight: "Quick and satisfying recipes for busy evenings. Minimal effort, maximum flavor.",
  entertaining: "Show-stopping dishes perfect for hosting friends and family. Make every gathering memorable.",
  comfort: "Warm, cozy recipes that feel like a hug on a plate. Perfect for when you need a pick-me-up.",
  celebration: "Special occasion recipes worth celebrating. From anniversaries to milestones.",
  "quick-meal": "Delicious meals ready in no time. Fast, fresh, and full of flavor.",
};
---

<BaseLayout
  title={`${occasionLabel} Recipes | Date My Dish`}
  description={occasionDescriptions[occasion] || `Browse our ${occasionLabel.toLowerCase()} recipes. Find your next favorite dish.`}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','viewcategory');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `${occasionLabel} Recipes`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^en\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-section-sm">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
        { label: occasionLabel },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-neutral-900 sm:text-4xl dark:text-neutral-100">
        {occasionLabel}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-accent"></div>
      <p class="mb-2 text-body-sm text-neutral-500 dark:text-neutral-400">
        {occasionDescriptions[occasion]}
      </p>
      <p class="text-body-sm text-neutral-500 dark:text-neutral-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recipe" : "recipes"}
      </p>
    </div>

    <!-- Occasion Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/en/recipes/"
        class="rounded-lg border border-neutral-200 px-4 py-2 font-ui text-body-sm font-medium text-neutral-600 no-underline transition-colors hover:border-brand-primary hover:text-brand-primary dark:border-neutral-600 dark:text-neutral-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allOccasions.map((occ) => (
        <a
          href={`${getOccasionLocalizedPath(locale, occ)}/`}
          class:list={[
            "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
            occ === occasion
              ? "bg-brand-primary-dark text-white dark:text-white dark:hover:text-white shadow-md"
              : "border border-neutral-200 bg-white text-neutral-700 shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-primary hover:text-brand-primary hover:shadow-md dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300",
          ]}
          aria-current={occ === occasion ? "page" : undefined}
        >
          {t(locale, `occasion.${occ}` as any) || occ}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {sortedRecipes.map((recipe: any, i: number) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-neutral-500 dark:text-neutral-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
