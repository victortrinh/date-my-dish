---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import RecipeLayout from "@layouts/RecipeLayout.astro";
import RecipeSchema from "@components/RecipeSchema.astro";
import RecipeContent from "@components/RecipeContent.astro";
import IngredientList from "@components/IngredientList.astro";
import NutritionCard from "@components/NutritionCard.astro";
import RecipeDetailCard from "@components/RecipeDetailCard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import AuthorBioCard from "@components/AuthorBioCard.astro";
import JumpToRecipe from "@components/JumpToRecipe.astro";
import ShareButton from "@components/ShareButton.astro";
import SocialShareButtons from "@components/SocialShareButtons.astro";
import StarRating from "@components/StarRating.astro";
import BookmarkButton from "@components/BookmarkButton.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import ImpressFactor from "@components/ImpressFactor.astro";
import DateNightTips from "@components/DateNightTips.astro";
import FAQSection from "@components/FAQSection.astro";
import RelatedRecipes from "@components/RelatedRecipes.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import QuickAnswer from "@components/QuickAnswer.astro";
import { t, getRecipeLocalizedPath, getOccasionLocalizedPath, getTagLocalizedPath, tagSlugMap } from "@i18n/utils";
import { formatDuration } from "@utils/format";
import { difficultyColors } from "@utils/recipe";
import type { ImageMetadata } from "astro";
import ratingsData from "../../../../data/ratings.json";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes
    .filter((recipe) => recipe.data.lang === "en")
    .map((recipe) => {
      const slug = recipe.id.replace(/^en\//, "");
      return {
        params: { slug },
        props: { recipe },
      };
    });
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;
const locale = "en";
const slug = recipe.id.replace(/^en\//, "");
const heroImage = data.heroImage as ImageMetadata;
const sourceUrl = `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`;
const ratingData = (ratingsData as Record<string, { averageRating: number; ratingCount: number }>)[slug];

---

<RecipeLayout
  title={`${data.title} | Date My Dish`}
  description={data.description}
  locale={locale}
  ogImage={heroImage.src}
  translationSlug={data.translationSlug}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','pagevisit');</script>
  </Fragment>
  <RecipeSchema
    slot="head"
    title={data.title}
    description={data.description}
    slug={slug}
    lang={locale}
    author={data.author}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
    heroImageUrl={heroImage.src}
    prepTime={data.prepTime}
    cookTime={data.cookTime}
    totalTime={data.totalTime}
    recipeYield={data.recipeYield}
    recipeCategory={data.recipeCategory}
    recipeCuisine={data.recipeCuisine}
    keywords={data.keywords}
    ingredientGroups={data.ingredientGroups}
    instructionGroups={data.instructionGroups}
    nutrition={data.nutrition}
    faqs={data.faqs}
    ratingData={ratingData}
    video={data.video}
  />

  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <!-- Full-width zone: Breadcrumbs + Hero + Meta -->
    <div class="mx-auto max-w-prose lg:max-w-none">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
          { label: data.title },
        ]}
      />

      <!-- Hero Image -->
      <div class="no-print relative mb-8 overflow-hidden rounded-xl">
        <Picture
          src={heroImage}
          alt={data.heroImageAlt}
          widths={[400, 600, 900]}
          sizes="(max-width: 896px) 100vw, 896px"
          formats={["avif", "webp"]}
          class="w-full max-h-[280px] object-cover sm:max-h-[380px] lg:max-h-[500px]"
          loading="eager"
          fetchpriority="high"
          data-pin-url={sourceUrl}
          data-pin-description={`${data.title} | ${data.description} | Date My Dish`}
        />
      </div>

      <!-- Title & Meta -->
      <header class="no-print mb-8">
        <h1 class="mb-4 font-heading text-heading-1 font-bold text-warm-900 sm:text-4xl dark:text-warm-100">
          {data.title}
        </h1>
        <p class="mb-6 text-body-lg text-warm-600 dark:text-warm-400">{data.description}</p>

        {data.summary && <QuickAnswer summary={data.summary} title={data.title} />}

        <!-- Meta Bar -->
        <div class="mb-6 flex flex-wrap items-center gap-4 rounded-xl bg-warm-100 p-4 dark:bg-warm-800">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-warm-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-body-sm text-warm-500 dark:text-warm-400">{t(locale, "recipe.prepTime")}</span>
            <span class="font-medium text-body-sm">{formatDuration(data.prepTime, locale)}</span>
          </div>
          <div class="h-4 w-px bg-warm-300 dark:bg-warm-600"></div>
          <div class="flex items-center gap-2">
            <span class="text-body-sm text-warm-500 dark:text-warm-400">{t(locale, "recipe.cookTime")}</span>
            <span class="font-medium text-body-sm">{formatDuration(data.cookTime, locale)}</span>
          </div>
          <div class="h-4 w-px bg-warm-300 dark:bg-warm-600"></div>
          <div class="flex items-center gap-2">
            <span class="text-body-sm text-warm-500 dark:text-warm-400">{t(locale, "recipe.totalTime")}</span>
            <span class="font-medium text-body-sm">{formatDuration(data.totalTime, locale)}</span>
          </div>
          <div class="h-4 w-px bg-warm-300 dark:bg-warm-600"></div>
          <div class="flex items-center gap-2">
            <span class="text-body-sm text-warm-500 dark:text-warm-400">{t(locale, "recipe.servings")}</span>
            <span class="font-medium text-body-sm">{data.recipeYield}</span>
          </div>
          <div class="h-4 w-px bg-warm-300 dark:bg-warm-600"></div>
          <span class={`rounded-full px-3 py-1 text-body-sm font-medium ${difficultyColors[data.difficulty]}`}>
            {t(locale, `recipe.${data.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
          </span>
          {data.impressFactor && (
            <>
              <div class="h-4 w-px bg-warm-300 dark:bg-warm-600"></div>
              <ImpressFactor locale={locale} rating={data.impressFactor} />
            </>
          )}
        </div>

        {data.occasion && data.occasion.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {data.occasion.map((occ: string) => (
              <a href={`${getOccasionLocalizedPath(locale, occ)}/`} class="rounded-full bg-brand-rose/10 px-3 py-1 text-caption font-medium text-brand-rose-text no-underline transition-colors hover:bg-brand-rose/20">
                {t(locale, `occasion.${occ}` as any) || occ}
              </a>
            ))}
          </div>
        )}

        {data.tags && data.tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {data.tags.map((tag: string) => {
              const hasPage = tag in tagSlugMap;
              const tagLabel = t(locale, `tags.${tag}` as any) || tag.charAt(0).toUpperCase() + tag.slice(1);
              return hasPage ? (
                <a href={`${getTagLocalizedPath(locale, tag)}/`} class="rounded-full border border-warm-200 px-3 py-1 text-caption font-medium text-warm-500 no-underline transition-colors hover:border-brand-wine hover:text-brand-wine-text dark:border-warm-600 dark:text-warm-400">
                  {tagLabel}
                </a>
              ) : (
                <span class="rounded-full border border-warm-200 px-3 py-1 text-caption font-medium text-warm-500 dark:border-warm-600 dark:text-warm-400">
                  {tagLabel}
                </span>
              );
            })}
          </div>
        )}

        <div class="flex flex-wrap items-center gap-4">
          <JumpToRecipe locale={locale} />
          <div class="flex flex-wrap items-center gap-2 border-l border-warm-200 pl-4 dark:border-warm-700">
            <button onclick="window.print()" class="no-print btn btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
              </svg>
              {t(locale, "recipe.printRecipe")}
            </button>
            <ShareButton locale={locale} title={data.title} url={sourceUrl} />
            <SocialShareButtons locale={locale} url={sourceUrl} title={data.title} imageUrl={heroImage.src} description={data.description} />
            <BookmarkButton locale={locale} enSlug={slug} />
          </div>
        </div>
      </header>
    </div>

    <!-- Two-column zone (hidden in print — card handles print) -->
    <div class="no-print recipe-two-col mx-auto grid max-w-prose grid-cols-1 gap-8 lg:max-w-none lg:grid-cols-[1fr_320px]">
      <!-- Main column -->
      <div class="recipe-main-col min-w-0">
        <TableOfContents locale={locale} />
        <div class="prose mb-12 max-w-none">
          <Content />
        </div>
        <RecipeContent
          locale={locale}
          title={data.title}
          prepTime={data.prepTime}
          cookTime={data.cookTime}
          totalTime={data.totalTime}
          recipeYield={data.recipeYield}
          difficulty={data.difficulty}
          instructionGroups={data.instructionGroups}
          sourceUrl={sourceUrl}
        />
      </div>

      <!-- Sidebar (desktop only) -->
      <aside class="recipe-sidebar hidden lg:block">
        <div class="sticky top-[73px] space-y-6 self-start overflow-y-auto rounded-xl border border-warm-200 bg-white p-5 dark:border-warm-800 dark:bg-warm-900" style="max-height: calc(100vh - 89px);">
          <div class="rounded-lg bg-warm-100 p-4 dark:bg-warm-800/30">
            <IngredientList locale={locale} ingredientGroups={data.ingredientGroups} idPrefix="sidebar-ing" recipeYield={data.recipeYield} />
          </div>
          {data.nutrition && (
            <div>
              <NutritionCard locale={locale} nutrition={data.nutrition} compact={true} />
            </div>
          )}
        </div>
      </aside>
    </div>

    <!-- Inline ingredients (mobile only, hidden in print) -->
    <div class="no-print recipe-inline-ingredients mx-auto mt-8 max-w-prose rounded-xl bg-warm-50 p-6 lg:hidden dark:bg-warm-800/30">
      <IngredientList locale={locale} ingredientGroups={data.ingredientGroups} idPrefix="inline-ing" recipeYield={data.recipeYield} />
      {data.nutrition && (
        <div class="mt-4">
          <NutritionCard locale={locale} nutrition={data.nutrition} compact={true} />
        </div>
      )}
    </div>

    <!-- Recipe Detail Card -->
    <div class="mx-auto mt-8 max-w-prose">
      <RecipeDetailCard
        locale={locale}
        title={data.title}
        heroImage={heroImage}
        heroImageAlt={data.heroImageAlt}
        prepTime={data.prepTime}
        cookTime={data.cookTime}
        totalTime={data.totalTime}
        recipeYield={data.recipeYield}
        difficulty={data.difficulty}
        ingredientGroups={data.ingredientGroups}
        instructionGroups={data.instructionGroups}
        calories={data.nutrition?.calories}
        impressFactor={data.impressFactor}
        sourceUrl={sourceUrl}
      />
    </div>

    <!-- Full-width zone: bottom sections -->
    <div class="mx-auto max-w-prose">
      {data.dateNightTips && (
        <DateNightTips locale={locale} tips={data.dateNightTips} />
      )}

      <!-- Author Bio -->
      <div class="mt-8 no-print">
        <AuthorBioCard locale={locale} />
      </div>

      <!-- Newsletter -->
      <div class="mt-8 no-print">
        <NewsletterSignup locale={locale} compact={true} />
      </div>

      <!-- Star Rating -->
      <StarRating locale={locale} slug={slug} averageRating={ratingData?.averageRating} ratingCount={ratingData?.ratingCount} />

      <!-- FAQs -->
      <FAQSection locale={locale} faqs={data.faqs} />

      <!-- Related Recipes -->
      <RelatedRecipes
        locale={locale}
        currentSlug={slug}
        categories={data.recipeCategory}
      />
    </div>
  </article>
  <script is:inline>
    (function() {
      var canonical = document.querySelector('link[rel="canonical"]');
      var title = document.querySelector('h1');
      if (!canonical || !title) return;
      document.querySelectorAll('.prose img').forEach(function(img) {
        if (!img.dataset.pinUrl) {
          img.dataset.pinUrl = canonical.href;
          img.dataset.pinDescription = title.textContent + ' | Date My Dish';
        }
      });
    })();
  </script>
  <script async defer src="https://assets.pinterest.com/js/pinit.js" data-pin-hover="true" data-pin-tall="true" data-pin-round="true" is:inline></script>
</RecipeLayout>
