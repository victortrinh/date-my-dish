---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import RecipeLayout from "@layouts/RecipeLayout.astro";
import RecipeSchema from "@components/RecipeSchema.astro";
import RecipeContent from "@components/RecipeContent.astro";
import IngredientList from "@components/IngredientList.astro";
import NutritionCard from "@components/NutritionCard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import AuthorBioCard from "@components/AuthorBioCard.astro";
import JumpToRecipe from "@components/JumpToRecipe.astro";
import ShareButton from "@components/ShareButton.astro";
import SocialShareButtons from "@components/SocialShareButtons.astro";
import StarRating from "@components/StarRating.astro";
import BookmarkButton from "@components/BookmarkButton.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import Comments from "@components/Comments.astro";
import ImpressFactor from "@components/ImpressFactor.astro";
import DateNightTips from "@components/DateNightTips.astro";
import FAQSection from "@components/FAQSection.astro";
import RelatedRecipes from "@components/RelatedRecipes.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath } from "@i18n/utils";
import { formatDuration } from "@utils/format";
import type { ImageMetadata } from "astro";
import ratingsData from "../../../../data/ratings.json";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes
    .filter((recipe) => recipe.data.lang === "en")
    .map((recipe) => {
      const slug = recipe.id.replace(/^en\//, "");
      return {
        params: { slug },
        props: { recipe },
      };
    });
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;
const locale = "en";
const slug = recipe.id.replace(/^en\//, "");
const heroImage = data.heroImage as ImageMetadata;
const sourceUrl = `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`;
const ratingData = (ratingsData as Record<string, { averageRating: number; ratingCount: number }>)[slug];

const difficultyColors = {
  easy: "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
  medium: "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400",
  hard: "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400",
};
---

<RecipeLayout
  title={`${data.title} | Date My Dish`}
  description={data.description}
  locale={locale}
  ogImage={heroImage.src}
  translationSlug={data.translationSlug}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
>
  <Fragment slot="head">
    <script is:inline>pintrk('track', 'pagevisit');</script>
  </Fragment>
  <RecipeSchema
    slot="head"
    title={data.title}
    description={data.description}
    slug={slug}
    lang={locale}
    author={data.author}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
    heroImageUrl={heroImage.src}
    prepTime={data.prepTime}
    cookTime={data.cookTime}
    totalTime={data.totalTime}
    recipeYield={data.recipeYield}
    recipeCategory={data.recipeCategory}
    recipeCuisine={data.recipeCuisine}
    keywords={data.keywords}
    ingredientGroups={data.ingredientGroups}
    instructionGroups={data.instructionGroups}
    nutrition={data.nutrition}
    faqs={data.faqs}
    ratingData={ratingData}
    video={data.video}
  />

  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <!-- Full-width zone: Breadcrumbs + Hero + Meta -->
    <div class="mx-auto max-w-prose">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
          { label: data.title },
        ]}
      />

      <!-- Hero Image -->
      <div class="no-print relative mb-8 overflow-hidden rounded-2xl">
        <Picture
          src={heroImage}
          alt={data.heroImageAlt}
          widths={[400, 600, 900]}
          sizes="(max-width: 896px) 100vw, 896px"
          formats={["avif", "webp"]}
          class="w-full max-h-[280px] object-cover sm:max-h-[380px] lg:max-h-[500px]"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- Title & Meta -->
      <header class="no-print mb-8">
        <h1 class="mb-4 font-heading text-heading-1 font-bold text-gray-900 sm:text-4xl dark:text-neutral-100">
          {data.title}
        </h1>
        <p class="mb-6 text-body-lg text-gray-600 dark:text-neutral-400">{data.description}</p>

        <!-- Meta Bar -->
        <div class="mb-6 flex flex-wrap items-center gap-4 rounded-xl bg-gray-200 p-4 dark:bg-neutral-800">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-body-sm text-gray-500 dark:text-neutral-400">{t(locale, "recipe.prepTime")}</span>
            <span class="font-medium text-body-sm">{formatDuration(data.prepTime, locale)}</span>
          </div>
          <div class="h-4 w-px bg-gray-300 dark:bg-neutral-600"></div>
          <div class="flex items-center gap-2">
            <span class="text-body-sm text-gray-500 dark:text-neutral-400">{t(locale, "recipe.cookTime")}</span>
            <span class="font-medium text-body-sm">{formatDuration(data.cookTime, locale)}</span>
          </div>
          <div class="h-4 w-px bg-gray-300 dark:bg-neutral-600"></div>
          <div class="flex items-center gap-2">
            <span class="text-body-sm text-gray-500 dark:text-neutral-400">{t(locale, "recipe.totalTime")}</span>
            <span class="font-medium text-body-sm">{formatDuration(data.totalTime, locale)}</span>
          </div>
          <div class="h-4 w-px bg-gray-300 dark:bg-neutral-600"></div>
          <div class="flex items-center gap-2">
            <span class="text-body-sm text-gray-500 dark:text-neutral-400">{t(locale, "recipe.servings")}</span>
            <span class="font-medium text-body-sm">{data.recipeYield}</span>
          </div>
          <div class="h-4 w-px bg-gray-300 dark:bg-neutral-600"></div>
          <span class={`rounded-full px-3 py-1 text-body-sm font-medium ${difficultyColors[data.difficulty]}`}>
            {t(locale, `recipe.${data.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
          </span>
          {data.impressFactor && (
            <>
              <div class="h-4 w-px bg-gray-300 dark:bg-neutral-600"></div>
              <ImpressFactor locale={locale} rating={data.impressFactor} />
            </>
          )}
        </div>

        {data.occasion && data.occasion.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {data.occasion.map((occ: string) => (
              <span class="rounded-full bg-brand-accent/10 px-3 py-1 text-caption font-medium text-brand-accent-text">
                {t(locale, `occasion.${occ}` as any) || occ}
              </span>
            ))}
          </div>
        )}

        <div class="flex flex-wrap items-center gap-3">
          <JumpToRecipe locale={locale} />
          <button
            onclick="window.print()"
            class="no-print inline-flex items-center gap-2 rounded-lg border border-gray-200 px-5 py-3 font-ui text-body-sm font-medium text-gray-600 transition-colors hover:bg-gray-200 dark:border-neutral-600 dark:text-neutral-400 dark:hover:bg-neutral-800"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            {t(locale, "recipe.printRecipe")}
          </button>
          <ShareButton locale={locale} title={data.title} url={sourceUrl} />
          <SocialShareButtons locale={locale} url={sourceUrl} title={data.title} imageUrl={heroImage.src} description={data.description} />
          <BookmarkButton locale={locale} enSlug={slug} />
        </div>
      </header>
    </div>

    <!-- Two-column zone -->
    <div class="recipe-two-col mx-auto grid max-w-prose grid-cols-1 gap-8 lg:max-w-none lg:grid-cols-[1fr_320px]">
      <!-- Main column -->
      <div class="recipe-main-col min-w-0">
        <!-- Table of Contents -->
        <TableOfContents locale={locale} />

        <!-- Blog Prose -->
        <div class="no-print prose mb-12 max-w-none">
          <Content />
        </div>

        <!-- Recipe Card (Instructions + Print info) -->
        <RecipeContent
          locale={locale}
          title={data.title}
          prepTime={data.prepTime}
          cookTime={data.cookTime}
          totalTime={data.totalTime}
          recipeYield={data.recipeYield}
          difficulty={data.difficulty}
          instructionGroups={data.instructionGroups}
          sourceUrl={sourceUrl}
        />
      </div>

      <!-- Sidebar (desktop only) -->
      <aside class="recipe-sidebar hidden lg:block">
        <div class="sticky top-[73px] space-y-6 self-start overflow-y-auto rounded-xl border border-gray-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900" style="max-height: calc(100vh - 89px);">
          <!-- Ingredients -->
          <div class="rounded-lg bg-gray-100 p-4 dark:bg-neutral-800/30">
            <IngredientList locale={locale} ingredientGroups={data.ingredientGroups} idPrefix="sidebar-ing" recipeYield={data.recipeYield} />
          </div>

          <!-- Nutrition (compact) -->
          {data.nutrition && (
            <div class="no-print">
              <NutritionCard locale={locale} nutrition={data.nutrition} compact={true} />
            </div>
          )}
        </div>
      </aside>
    </div>

    <!-- Inline ingredients (mobile/tablet only) — hidden on lg -->
    <div class="recipe-inline-ingredients mx-auto mt-8 max-w-prose rounded-xl bg-gray-50 p-6 lg:hidden dark:bg-neutral-800/30">
      <IngredientList locale={locale} ingredientGroups={data.ingredientGroups} idPrefix="inline-ing" recipeYield={data.recipeYield} />
      {data.nutrition && (
        <div class="mt-4 no-print">
          <NutritionCard locale={locale} nutrition={data.nutrition} compact={true} />
        </div>
      )}
    </div>

    <!-- Full-width zone: bottom sections -->
    <div class="mx-auto max-w-prose">
      {data.dateNightTips && (
        <DateNightTips locale={locale} tips={data.dateNightTips} />
      )}

      <!-- Author Bio -->
      <div class="mt-8 no-print">
        <AuthorBioCard locale={locale} />
      </div>

      <!-- Newsletter -->
      <div class="mt-8 no-print">
        <NewsletterSignup locale={locale} compact={true} />
      </div>

      <!-- Star Rating -->
      <StarRating locale={locale} slug={slug} />

      <!-- Comments -->
      <Comments locale={locale} identifier={slug} url={sourceUrl} title={data.title} />

      <!-- FAQs -->
      <FAQSection locale={locale} faqs={data.faqs} />

      <!-- Related Recipes -->
      <RelatedRecipes
        locale={locale}
        currentSlug={slug}
        categories={data.recipeCategory}
      />
    </div>
  </article>
</RecipeLayout>
