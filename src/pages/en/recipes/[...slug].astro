---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import RecipeLayout from "@layouts/RecipeLayout.astro";
import RecipeSchema from "@components/RecipeSchema.astro";
import RecipeContent from "@components/RecipeContent.astro";
import IngredientList from "@components/IngredientList.astro";
import NutritionCard from "@components/NutritionCard.astro";
import RecipeDetailCard from "@components/RecipeDetailCard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import AuthorBioCard from "@components/AuthorBioCard.astro";
import ShareButton from "@components/ShareButton.astro";
import SocialShareButtons from "@components/SocialShareButtons.astro";
import StarRating from "@components/StarRating.astro";
import BookmarkButton from "@components/BookmarkButton.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import DateNightTips from "@components/DateNightTips.astro";
import FAQSection from "@components/FAQSection.astro";
import RelatedRecipes from "@components/RelatedRecipes.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath, getOccasionLocalizedPath } from "@i18n/utils";
import authorPhoto from "@assets/images/victor-vu.webp";
import { formatDuration } from "@utils/format";
import { difficultyColors } from "@utils/recipe";
import type { ImageMetadata } from "astro";
import ratingsData from "../../../../data/ratings.json";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes
    .filter((recipe) => recipe.data.lang === "en")
    .map((recipe) => {
      const slug = recipe.id.replace(/^en\//, "");
      return {
        params: { slug },
        props: { recipe },
      };
    });
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;
const locale = "en";
const slug = recipe.id.replace(/^en\//, "");
const heroImage = data.heroImage as ImageMetadata;
const sourceUrl = `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`;
const ratingData = (ratingsData as Record<string, { averageRating: number; ratingCount: number }>)[slug];

---

<RecipeLayout
  title={`${data.title} | Date My Dish`}
  description={data.description}
  locale={locale}
  ogImage={heroImage.src}
  translationSlug={data.translationSlug}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','pagevisit');</script>
  </Fragment>
  <RecipeSchema
    slot="head"
    title={data.title}
    description={data.description}
    slug={slug}
    lang={locale}
    author={data.author}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
    heroImageUrl={heroImage.src}
    prepTime={data.prepTime}
    cookTime={data.cookTime}
    totalTime={data.totalTime}
    recipeYield={data.recipeYield}
    recipeCategory={data.recipeCategory}
    recipeCuisine={data.recipeCuisine}
    keywords={data.keywords}
    ingredientGroups={data.ingredientGroups}
    instructionGroups={data.instructionGroups}
    nutrition={data.nutrition}
    faqs={data.faqs}
    ratingData={ratingData}
    video={data.video}
  />

  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <!-- Full-width zone: Breadcrumbs + Hero + Meta -->
    <div class="mx-auto max-w-prose lg:max-w-none">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: t(locale, "nav.recipes"), href: "/en/recipes/" },
          { label: data.title },
        ]}
      />

      <!-- Hero Section -->
      <header class="no-print mb-8 bg-warm-50 p-6 dark:bg-warm-900/50 sm:p-8 lg:px-0 lg:py-12">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16">
          <!-- Left: Content -->
          <div class="order-2 flex flex-col justify-center lg:order-1">
            {(data.occasion && data.occasion.length > 0) ? (
              <div class="mb-4">
                <a href={`${getOccasionLocalizedPath(locale, data.occasion[0])}/`} class="inline-block rounded-full bg-brand-wine/10 px-4 py-1.5 font-ui text-caption font-semibold uppercase tracking-wider text-brand-wine no-underline transition-colors hover:bg-brand-wine/20 dark:bg-brand-wine-dark/10 dark:text-brand-wine-dark dark:hover:bg-brand-wine-dark/20">
                  {t(locale, `occasion.${data.occasion[0]}` as any)}
                </a>
              </div>
            ) : data.recipeCategory && data.recipeCategory.length > 0 ? (
              <div class="mb-4">
                <span class="inline-block rounded-full bg-brand-wine/10 px-4 py-1.5 font-ui text-caption font-semibold uppercase tracking-wider text-brand-wine dark:bg-brand-wine-dark/10 dark:text-brand-wine-dark">
                  {t(locale, `categories.${data.recipeCategory[0]}` as any) || data.recipeCategory[0]}
                </span>
              </div>
            ) : null}

            <h1 class="mb-4 font-heading text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">
              {data.title}
            </h1>

            <p class="mb-8 font-body text-body-lg text-warm-600 dark:text-warm-400">
              {data.description}
            </p>

            <!-- Author + Jump to Recipe -->
            <div class="mb-8 flex flex-wrap items-center gap-5">
              <div class="flex items-center gap-3">
                <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full">
                  <Picture
                    src={authorPhoto}
                    alt={t(locale, "author.photoAlt")}
                    widths={[48, 96]}
                    sizes="48px"
                    formats={["avif", "webp"]}
                    class="h-full w-full object-cover"
                    loading="eager"
                    data-pin-nopin="true"
                  />
                </div>
                <div>
                  <span class="block font-ui text-body-sm font-semibold text-warm-800 dark:text-warm-200">
                    {t(locale, "author.by")} {data.author || "Victor"}
                  </span>
                  <span class="block font-ui text-caption font-medium uppercase tracking-wider text-brand-wine dark:text-brand-wine-dark">
                    {t(locale, "author.recipeAuthor")}
                  </span>
                </div>
              </div>
              <a
                href="#recipe-card"
                class="rounded-full bg-brand-wine px-6 py-3 font-ui text-body-sm font-semibold text-white no-underline transition-colors hover:bg-brand-wine/90"
              >
                {t(locale, "recipe.jumpToRecipe")}
              </a>
            </div>

            <!-- Meta Bar -->
            <div class="grid grid-cols-4 divide-x divide-warm-200 overflow-hidden rounded-xl border border-warm-200 bg-white dark:divide-warm-700 dark:border-warm-700 dark:bg-warm-800">
              <div class="px-2 py-3 text-center sm:p-4">
                <span class="block font-ui text-[10px] font-semibold uppercase tracking-wider text-warm-400 sm:text-caption">
                  {t(locale, "recipe.prep")}
                </span>
                <span class="mt-1 block font-body text-sm font-semibold text-warm-800 dark:text-warm-200 sm:text-lg">
                  {formatDuration(data.prepTime, locale)}
                </span>
              </div>
              <div class="px-2 py-3 text-center sm:p-4">
                <span class="block font-ui text-[10px] font-semibold uppercase tracking-wider text-warm-400 sm:text-caption">
                  {t(locale, "recipe.cook")}
                </span>
                <span class="mt-1 block font-body text-sm font-semibold text-warm-800 dark:text-warm-200 sm:text-lg">
                  {formatDuration(data.cookTime, locale)}
                </span>
              </div>
              <div class="px-2 py-3 text-center sm:p-4">
                <span class="block font-ui text-[10px] font-semibold uppercase tracking-wider text-warm-400 sm:text-caption">
                  {t(locale, "recipe.total")}
                </span>
                <span class="mt-1 block font-body text-sm font-semibold text-warm-800 dark:text-warm-200 sm:text-lg">
                  {formatDuration(data.totalTime, locale)}
                </span>
              </div>
              <div class="px-2 py-3 text-center sm:p-4">
                <span class="block font-ui text-[10px] font-semibold uppercase tracking-wider text-warm-400 sm:text-caption">
                  {t(locale, "recipe.difficulty")}
                </span>
                <span class={`mt-2 inline-block rounded-full px-2 py-0.5 text-[10px] font-medium sm:px-3 sm:text-caption ${difficultyColors[data.difficulty]}`}>
                  {t(locale, `recipe.${data.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
                </span>
              </div>
            </div>
          </div>

          <!-- Right: Hero Image -->
          <div class="relative order-1 lg:order-2">
            <Picture
              src={heroImage}
              alt={data.heroImageAlt}
              widths={[400, 600, 900]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              formats={["avif", "webp"]}
              class="h-[300px] w-full rounded-2xl object-cover sm:h-[400px] lg:h-full lg:min-h-[500px]"
              loading="eager"
              fetchpriority="high"
              data-pin-url={sourceUrl}
              data-pin-description={`${data.title} | ${data.description} | Date My Dish`}
            />
            {data.summary && (
              <div class="absolute bottom-4 left-4 max-w-[200px] rounded-xl bg-white/95 p-3 shadow-lg backdrop-blur-sm dark:bg-warm-800/95 sm:bottom-6 sm:left-6 sm:max-w-[240px] sm:p-4">
                <p class="line-clamp-3 font-caveat text-base leading-snug text-brand-wine dark:text-brand-wine-dark sm:line-clamp-4 sm:text-lg">
                  &ldquo;{data.summary}&rdquo;
                </p>
              </div>
            )}
          </div>
        </div>
      </header>

      <!-- Secondary Actions -->
      <div class="no-print mb-6 flex flex-wrap items-center gap-2">
        <button onclick="window.print()" class="btn btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          {t(locale, "recipe.printRecipe")}
        </button>
        <ShareButton locale={locale} title={data.title} url={sourceUrl} />
        <SocialShareButtons locale={locale} url={sourceUrl} title={data.title} imageUrl={heroImage.src} description={data.description} />
        <BookmarkButton locale={locale} enSlug={slug} />
      </div>
    </div>

    <!-- Two-column zone (hidden in print — card handles print) -->
    <div class="no-print recipe-two-col mx-auto grid max-w-prose grid-cols-1 gap-8 lg:max-w-none lg:grid-cols-[1fr_320px]">
      <!-- Main column -->
      <div class="recipe-main-col min-w-0">
        <TableOfContents locale={locale} />
        <div class="prose mb-12 max-w-none">
          <Content />
        </div>
        <RecipeContent
          locale={locale}
          title={data.title}
          prepTime={data.prepTime}
          cookTime={data.cookTime}
          totalTime={data.totalTime}
          recipeYield={data.recipeYield}
          difficulty={data.difficulty}
          instructionGroups={data.instructionGroups}
          sourceUrl={sourceUrl}
        />
      </div>

      <!-- Sidebar (desktop only) -->
      <aside class="recipe-sidebar hidden lg:block">
        <div class="sticky top-[73px] space-y-6 self-start overflow-y-auto rounded-xl border border-warm-200 bg-white p-5 dark:border-warm-800 dark:bg-warm-900" style="max-height: calc(100vh - 89px);">
          <div class="rounded-lg bg-warm-100 p-4 dark:bg-warm-800/30">
            <IngredientList locale={locale} ingredientGroups={data.ingredientGroups} idPrefix="sidebar-ing" recipeYield={data.recipeYield} />
          </div>
          {data.nutrition && (
            <div>
              <NutritionCard locale={locale} nutrition={data.nutrition} compact={true} />
            </div>
          )}
        </div>
      </aside>
    </div>

    <!-- Inline ingredients (mobile only, hidden in print) -->
    <div class="no-print recipe-inline-ingredients mx-auto mt-8 max-w-prose rounded-xl bg-warm-50 p-6 lg:hidden dark:bg-warm-800/30">
      <IngredientList locale={locale} ingredientGroups={data.ingredientGroups} idPrefix="inline-ing" recipeYield={data.recipeYield} />
      {data.nutrition && (
        <div class="mt-4">
          <NutritionCard locale={locale} nutrition={data.nutrition} compact={true} />
        </div>
      )}
    </div>

    <!-- Recipe Detail Card -->
    <div class="mx-auto mt-8 max-w-prose">
      <RecipeDetailCard
        locale={locale}
        title={data.title}
        heroImage={heroImage}
        heroImageAlt={data.heroImageAlt}
        prepTime={data.prepTime}
        cookTime={data.cookTime}
        totalTime={data.totalTime}
        recipeYield={data.recipeYield}
        difficulty={data.difficulty}
        ingredientGroups={data.ingredientGroups}
        instructionGroups={data.instructionGroups}
        calories={data.nutrition?.calories}
        impressFactor={data.impressFactor}
        sourceUrl={sourceUrl}
      />
    </div>

    <!-- Full-width zone: bottom sections -->
    <div class="mx-auto max-w-prose">
      {data.dateNightTips && (
        <DateNightTips locale={locale} tips={data.dateNightTips} />
      )}

      <!-- Author Bio -->
      <div class="mt-8 no-print">
        <AuthorBioCard locale={locale} />
      </div>

      <!-- Newsletter -->
      <div class="mt-8 no-print">
        <NewsletterSignup locale={locale} compact={true} />
      </div>

      <!-- Star Rating -->
      <StarRating locale={locale} slug={slug} averageRating={ratingData?.averageRating} ratingCount={ratingData?.ratingCount} />

      <!-- FAQs -->
      <FAQSection locale={locale} faqs={data.faqs} />

      <!-- Related Recipes -->
      <RelatedRecipes
        locale={locale}
        currentSlug={slug}
        categories={data.recipeCategory}
      />
    </div>
  </article>
  <script is:inline>
    (function() {
      var canonical = document.querySelector('link[rel="canonical"]');
      var title = document.querySelector('h1');
      if (!canonical || !title) return;
      document.querySelectorAll('.prose img').forEach(function(img) {
        if (!img.dataset.pinUrl) {
          img.dataset.pinUrl = canonical.href;
          img.dataset.pinDescription = title.textContent + ' | Date My Dish';
        }
      });
    })();
  </script>
  <script async defer src="https://assets.pinterest.com/js/pinit.js" data-pin-hover="true" data-pin-tall="true" data-pin-round="true" is:inline></script>
</RecipeLayout>
