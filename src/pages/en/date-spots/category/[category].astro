---
import { getCollection } from "astro:content";
import DateSpotListing from "@components/DateSpotListing.astro";
import { t, tf } from "@i18n/utils";
import { DATE_SPOT_CATEGORIES, categoryPath, spotCategory } from "@utils/date-spots";

// One page per Date Spot category that has content.
export async function getStaticPaths() {
  const spots = await getCollection("dateSpots");
  return DATE_SPOT_CATEGORIES
    .filter((category) => spots.some(({ data }) => spotCategory(data) === category))
    .map((category) => ({
      params: { category: categoryPath(category, "en").split("/").at(-2) },
      props: { category, spots: spots.filter(({ data }) => spotCategory(data) === category) },
    }));
}

const { category, spots } = Astro.props;
const label = t("en", `dateSpot.category.${category}`);
const title = tf("en", "dateSpot.categoryTitle", { category: label });
---
<DateSpotListing
  spots={spots}
  locale="en"
  title={title}
  description={tf("en", "dateSpot.categoryDescription", { category: label })}
  breadcrumbs={[{ label: t("en", "nav.dateSpots"), href: "/en/date-spots/" }, { label }]}
  alternatePath={categoryPath(category, "fr")}
/>
