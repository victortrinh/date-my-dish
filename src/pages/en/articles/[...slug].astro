---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import ArticleLayout from "@layouts/ArticleLayout.astro";
import ArticleSchema from "@components/ArticleSchema.astro";
import AuthorBioCard from "@components/AuthorBioCard.astro";
import FAQSection from "@components/FAQSection.astro";
import ArticleRelatedRecipes from "@components/ArticleRelatedRecipes.astro";
import ShareButton from "@components/ShareButton.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import SocialShareButtons from "@components/SocialShareButtons.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getArticleLocalizedPath } from "@i18n/utils";
import authorPhoto from "@assets/images/victor-vu.webp";
import type { ImageMetadata } from "astro";
import { SITE_URL } from "@utils/constants";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles
    .filter((article) => article.data.lang === "en")
    .map((article) => {
      const slug = article.id.replace(/^en\//, "");
      return {
        params: { slug },
        props: { article },
      };
    });
}

const { article } = Astro.props;
const { Content } = await render(article);
const { data } = article;
const locale = "en";
const slug = article.id.replace(/^en\//, "");
const heroImage = data.heroImage as ImageMetadata;
const sourceUrl = `${SITE_URL}${getArticleLocalizedPath(locale, slug)}`;

const formattedDate = data.publishDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<ArticleLayout
  title={`${data.title} | Date My Dish`}
  description={data.description}
  locale={locale}
  ogImage={heroImage.src}
  translationSlug={data.translationSlug}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','pagevisit');</script>
  </Fragment>
  <ArticleSchema
    slot="head"
    title={data.title}
    description={data.description}
    slug={slug}
    lang={locale}
    author={data.author}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
    heroImageUrl={heroImage.src}
    keywords={data.keywords}
    faqs={data.faqs}
  />

  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <!-- Full-width zone: Breadcrumbs + Hero -->
    <div class="mx-auto max-w-prose lg:max-w-none">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: t(locale, "breadcrumbs.articles"), href: "/en/articles/" },
          { label: data.title },
        ]}
      />

      <!-- Hero Section (editorial two-column layout) -->
      <header class="no-print mb-8 p-6 sm:p-8 lg:px-0 lg:py-12">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16">
          <!-- Left: Content -->
          <div class="order-2 flex flex-col justify-start lg:order-1">
            {data.articleCategory && (
              <div class="mb-4">
                <span class="inline-block rounded-full bg-brand-wine/10 px-4 py-1.5 font-ui text-caption font-semibold uppercase tracking-wider text-brand-wine dark:bg-brand-wine-dark/10 dark:text-brand-wine-dark">
                  {t(locale, `tags.${data.articleCategory}` as "tags.cooking-techniques" | "tags.food-science" | "tags.guides" | "tags.ingredients" | "tags.kitchen-tips" | "tags.drinks")}
                </span>
              </div>
            )}

            <h1 class="mb-4 font-heading text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">
              {data.title}
            </h1>

            <p class="mb-8 font-body text-body-lg text-warm-600 dark:text-warm-400">
              {data.description}
            </p>

            <!-- Author + Meta -->
            <div class="mb-8 flex flex-wrap items-center gap-5">
              <div class="flex items-center gap-3">
                <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full">
                  <Picture
                    src={authorPhoto}
                    alt={t(locale, "author.photoAlt")}
                    widths={[48, 96]}
                    sizes="48px"
                    formats={["avif", "webp"]}
                    class="h-full w-full object-cover"
                    loading="eager"
                    data-pin-nopin="true"
                  />
                </div>
                <div>
                  <span class="block font-ui text-body-sm font-semibold text-warm-800 dark:text-warm-200">
                    {t(locale, "author.by")} {data.author || "Victor"}
                  </span>
                  <span class="block font-ui text-caption font-medium text-warm-500 dark:text-warm-400">
                    {formattedDate}
                    {data.readingTime && ` · ${data.readingTime} ${t(locale, "article.readTime")}`}
                  </span>
                </div>
              </div>
            </div>

            <!-- Share -->
            <div class="flex flex-wrap items-center gap-4 text-body-sm text-warm-500 dark:text-warm-400">
              <ShareButton locale={locale} title={data.title} url={sourceUrl} />
              <SocialShareButtons locale={locale} url={sourceUrl} title={data.title} imageUrl={heroImage.src} description={data.description} />
            </div>
          </div>

          <!-- Right: Hero Image -->
          <div class="relative order-1 lg:order-2">
            <Picture
              src={heroImage}
              alt={data.heroImageAlt}
              widths={[400, 600, 900]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              formats={["avif", "webp"]}
              class="h-[600px] w-full rounded-2xl object-cover"
              loading="eager"
              fetchpriority="high"
              data-pin-url={sourceUrl}
              data-pin-description={`${data.title} | ${data.description} | Date My Dish`}
            />
          </div>
        </div>
      </header>
    </div>

    <!-- Content zone: prose width -->
    <div class="mx-auto max-w-prose">
      <!-- Blog Prose -->
      <div class="prose mb-12 max-w-none">
        <Content />
      </div>

      <!-- Related Recipes -->
      {data.relatedRecipes && data.relatedRecipes.length > 0 && (
        <ArticleRelatedRecipes locale={locale} recipeSlugs={data.relatedRecipes} />
      )}

      <!-- Author Bio -->
      <div class="mt-8 no-print">
        <AuthorBioCard locale={locale} />
      </div>

      <!-- Newsletter -->
      <div class="mt-8 no-print">
        <NewsletterSignup locale={locale} compact={true} />
      </div>

      <!-- FAQs -->
      <FAQSection locale={locale} faqs={data.faqs} />

    </div>
  </article>
</ArticleLayout>
