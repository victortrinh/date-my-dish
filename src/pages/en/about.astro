---
import BrandDescriptor from "@components/BrandDescriptor.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";
import { SITE_URL } from "@utils/constants";
const locale = "en";
---
<BaseLayout title={`${t(locale, "about.pageTitle")} | Date My Dish`} description={t(locale, "seo.homeDescription")}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "AboutPage",
    name: t(locale, "about.pageTitle"), url: `${SITE_URL}/en/about/`,
    mainEntity: { "@type": "Organization", name: "Date My Dish", url: SITE_URL },
    contributor: { "@type": "Person", name: "Victor Vu" },
  })} />
  <section class="mx-auto max-w-prose px-4 py-section">
    <Breadcrumbs locale={locale} items={[{ label: t(locale, "about.pageTitle") }]} />
    <h1 class="mt-8 font-heading text-4xl text-warm-900 dark:text-warm-100">{t(locale, "about.pageTitle")} Date My Dish</h1>
    <p class="mt-6 text-2xl text-warm-700 dark:text-warm-300"><BrandDescriptor locale={locale} /></p>
    <p class="mt-6 text-warm-600 dark:text-warm-400">Montréal · Date Spots</p>
    <p class="mt-8 text-warm-700 dark:text-warm-300">{t(locale, "author.by")} Victor Vu</p>
  </section>
</BaseLayout>
