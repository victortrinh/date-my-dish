---
import { Picture } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import AuthorBioCard from "@components/AuthorBioCard.astro";
import { t } from "@i18n/utils";
import heroImage from "@assets/images/victor-about.webp";

const locale = "en";
const siteUrl = "https://datemydish.com";
const heroImageUrl = `${siteUrl}/images/victor-about.webp`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Victor Vu",
  url: `${siteUrl}/en/about/`,
  image: heroImageUrl,
  jobTitle: "Home Cook & Recipe Creator",
  description: "Montreal-based home cook behind Date My Dish, sharing romantic recipes and date night cooking inspiration.",
  sameAs: [
    "https://www.instagram.com/datemydishdotcom",
    "https://www.pinterest.com/datemydish",
  ],
  knowsAbout: ["Cooking", "Romantic Recipes", "Date Night Cooking", "Montreal Cuisine", "French-Canadian Cooking"],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: t(locale, "about.pageTitle"),
  url: `${siteUrl}/en/about/`,
  description: "Meet Victor, the Montreal home cook behind Date My Dish. Romantic recipes, date night tips, and cooking inspiration for unforgettable evenings together.",
  mainEntity: {
    "@type": "Person",
    name: "Victor Vu",
  },
};
---

<BaseLayout
  title={`${t(locale, "about.pageTitle")} | Date My Dish`}
  description="Meet Victor, the Montreal home cook behind Date My Dish. Romantic recipes, date night tips, and cooking inspiration for unforgettable evenings together."
  ogImage={heroImageUrl}
  translationSlug="a-propos"
  contentType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />

  <div class="mx-auto max-w-narrow px-4 py-section-sm">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "about.pageTitle") }]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-neutral-900 sm:text-4xl dark:text-neutral-100">
        {t(locale, "about.title")}
      </h1>
      <div class="h-1 w-12 rounded-full bg-brand-accent"></div>
    </div>

    <div class="mb-10 flex flex-col items-center gap-8 md:flex-row md:items-start md:gap-10">
      <div class="w-full shrink-0 overflow-hidden rounded-2xl md:w-64">
        <Picture
          src={heroImage}
          alt="Victor Vu, home cook and creator of Date My Dish, standing in his Montreal kitchen wearing an apron with arms crossed"
          widths={[400, 600, 900]}
          sizes="(max-width: 768px) 100vw, 256px"
          formats={["avif", "webp"]}
          class="aspect-[4/3] w-full object-cover object-[center_30%] md:aspect-auto md:max-h-none"
          loading="eager"
        />
      </div>
      <p class="text-lg text-neutral-700 dark:text-neutral-300">
        Hi, I'm Victor! I'm a home cook based in Montreal who believes that cooking for someone
        is one of the most genuine expressions of care and affection. Date My Dish is where I share
        romantic recipes and date night cooking inspiration: dishes designed to impress that special someone,
        whether it's a first date, an anniversary, or a cozy night in.
      </p>
    </div>

    <div class="prose max-w-none">

      <h2>A Montreal Food Story</h2>

      <p>
        Growing up in Montreal surrounded by an incredible food culture, I developed an early appreciation
        for how cuisine brings people together. In a bilingual household, food was always the language
        everyone understood, whether it was a classic French crêpe on a Sunday morning or my grandmother's
        weeknight pasta. That love for gathering around the table never left me.
      </p>

      <p>
        Over the past decade, I've cooked my way through hundreds of recipes, from Italian classics
        to Korean fusion, refining techniques across cuisines. I've spent years studying the craft
        through Montreal's vibrant food scene, learning from the city's markets, restaurants,
        and the diverse culinary traditions that make this place special.
      </p>

      <p>
        I noticed a gap in resources focused specifically on romantic home cooking. Plenty of recipe sites
        exist, but very few help you plan an unforgettable evening at home. That's where Date My Dish was born.
      </p>

      <h2>Why "Date My Dish"?</h2>

      <p>
        Because every recipe should be worth falling for. I want you to look at a dish and think,
        "I need to make that." Whether you're planning a date night or simply want to elevate
        an ordinary evening, the goal is always the same: food that creates a moment.
        It's not about perfection; it's about effort and intention.
      </p>

      <h2>How I Develop Recipes</h2>

      <p>
        Every recipe on Date My Dish goes through multiple rounds of testing in my home kitchen.
        I cook each dish at least three times before publishing, adjusting seasoning, timing,
        and technique until it's right. The prep times and cook times you see are honest:
        measured during real cooking sessions, not estimated.
      </p>

      <p>
        I focus on recipes that balance impressiveness with approachability. You don't need
        professional training or specialty equipment. You need good ingredients, clear instructions,
        and the confidence to trust the process.
      </p>

      <h2>What You'll Find Here</h2>

      <ul>
        <li>Romantic recipe collections from appetizers through desserts, tested in a real home kitchen</li>
        <li>Cooking techniques and food science articles to sharpen your skills</li>
        <li>Date night planning guidance, including wine pairings and atmosphere tips</li>
        <li>Seasonal recipe inspiration spanning Italian, Asian, Mediterranean, and fusion cuisines</li>
        <li>Step-by-step instructions with honest prep and cook times from real testing</li>
        <li>Every recipe available in both English and French</li>
      </ul>

      <p>
        Thanks for being here. I hope you find something that makes your next evening
        a little more special, and a lot more delicious.
      </p>
    </div>

    <div class="mt-12">
      <AuthorBioCard locale={locale} showLink={false} />
    </div>
  </div>
</BaseLayout>
