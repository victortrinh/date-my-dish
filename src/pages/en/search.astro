---
import BaseLayout from "@layouts/BaseLayout.astro";
import SearchBar from "@components/SearchBar.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";

const locale = "en";
---

<BaseLayout
  title={`${t(locale, "search.title")} | Date My Dish`}
  description="Search recipes on Date My Dish."
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "nav.search") }]}
    />

    <h1 class="mb-8 font-heading text-4xl font-bold text-gray-900 dark:text-gray-100">
      {t(locale, "search.title")}
    </h1>

    <SearchBar locale={locale} />
  </div>
</BaseLayout>
