---
import BaseLayout from "@layouts/BaseLayout.astro";
import SearchBar from "@components/SearchBar.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";

const locale = "en";
---

<BaseLayout
  title={`${t(locale, "search.title")} | Date My Dish`}
  description="Search recipes on Date My Dish."
  noindex={true}
>
  <div class="mx-auto max-w-narrow px-4 py-section-sm">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "nav.search") }]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-neutral-900 sm:text-4xl dark:text-neutral-100">
        {t(locale, "search.title")}
      </h1>
      <div class="h-1 w-12 rounded-full bg-brand-accent"></div>
    </div>

    <SearchBar locale={locale} />
  </div>
</BaseLayout>
