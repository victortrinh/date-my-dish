---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import DateSpotCard from "@components/DateSpotCard.astro";
import { getCollection } from "astro:content";
import { SITE_URL } from "@utils/constants";
const spots = (await getCollection("dateSpots")).map(({ data }) => data).filter((spot) => spot.spotType === "restaurant").sort((a, b) => b.freshness.published.localeCompare(a.freshness.published));
const description = "Independent, human-reported Montréal restaurant recommendations with honest costs, booking guidance, and occasion-specific advice for planning a date.";
---
<BaseLayout title="Restaurant Reviews for Montréal Dates | Date My Dish" description={description}>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "ItemList", name: "Restaurant reviews", numberOfItems: spots.length, itemListElement: spots.map((spot, index) => ({ "@type": "ListItem", position: index + 1, url: `${SITE_URL}/en/reviews/${spot.locales.en.slug}/`, name: spot.name }))})} /></Fragment>
  <div class="mx-auto max-w-content px-4 py-section-sm"><Breadcrumbs locale="en" items={[{ label: "Reviews" }]} /><header class="mb-10"><h1 class="mb-3 text-heading-1 text-warm-900 dark:text-warm-100">Restaurant Date Spots</h1><p class="max-w-prose text-body-lg text-warm-600 dark:text-warm-300">Reported recommendations for deciding where to book, what the room feels like, what to order, and what two people will actually spend.</p></header>{spots.length > 0 ? <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>{spots.map((spot, index) => <DateSpotCard spot={spot} locale="en" loading={index === 0 ? "eager" : "lazy"} />)}</div> : <p>No Restaurant Date Spots are published yet.</p>}</div>
</BaseLayout>
