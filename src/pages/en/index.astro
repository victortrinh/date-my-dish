---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import ArticleCard from "@components/ArticleCard.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { Picture } from "astro:assets";
import { t } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import heroImage from "@assets/images/homepage-hero.jpg";

const locale = "en";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes
  .filter((r) => r.data.lang === "en")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const allArticles = await getCollection("articles");
const articles = allArticles
  .filter((a) => a.data.lang === "en")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const recentPosts = [...recipes, ...articles]
  .sort((a, b) => {
    const dateDiff = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.id.localeCompare(b.id);
  })
  .slice(0, 3);

const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const categories = [...new Set(recipes.flatMap((r) => r.data.recipeCategory))];
categories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={t(locale, "seo.homeTitle")}
  description={t(locale, "seo.homeDescription")}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Date My Dish",
      alternateName: "datemydish.com",
      url: "https://datemydish.com",
      inLanguage: ["en", "fr"],
      potentialAction: {
        "@type": "SearchAction",
        target: "https://datemydish.com/en/search/?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Date My Dish",
      url: "https://datemydish.com",
      logo: "https://datemydish.com/images/og-default.jpg",
      sameAs: [
        "https://www.instagram.com/datemydishdotcom",
        "https://www.pinterest.com/datemydish",
      ],
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-warm-50 dark:bg-warm-950">
    <div class="mx-auto flex max-w-content flex-col items-center gap-8 px-4 py-16 sm:py-20 md:flex-row md:gap-12 md:py-28">
      <!-- Text (left 60%) -->
      <div class="flex-1 text-center md:text-left">
        <h1 class="mb-5 font-heading text-3xl font-bold text-warm-800 dark:text-warm-50 sm:text-4xl lg:text-5xl">
          {t(locale, "home.heroTitle")}
        </h1>
        <p class="mx-auto max-w-lg text-body-lg text-warm-500 dark:text-warm-400 md:mx-0">
          {t(locale, "home.heroSubtitle")}
        </p>
        <a
          href="/en/recipes/"
          class="btn btn-primary mt-8 shadow-lg hover:shadow-xl sm:px-8 sm:py-3 sm:text-base"
        >
          {t(locale, "home.viewAllRecipes")}
        </a>
      </div>
      <!-- Photo (right 40%) -->
      <div class="w-full md:w-2/5">
        <Picture
          src={heroImage}
          alt="A beautifully plated dish ready to impress"
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 40vw"
          formats={["avif", "webp"]}
          class="w-full rounded-2xl object-cover shadow-lg"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Recent Posts -->
  {recentPosts.length > 0 && (
    <section class="bg-warm-100 px-4 py-section dark:bg-warm-900" aria-labelledby="recent-posts">
      <div class="mx-auto max-w-content">
        <SectionHeading id="recent-posts">{t(locale, "home.recentPosts")}</SectionHeading>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
          {recentPosts.map((post, index) => {
            const slug = post.id.replace(/^en\//, "");
            const isFeatured = index === 0;
            return post.collection === "recipes" ? (
              <div class:list={[isFeatured && "sm:col-span-2 lg:col-span-2"]}>
                <RecipeCard
                  title={post.data.title}
                  description={post.data.description}
                  slug={slug}
                  locale={locale}
                  heroImage={post.data.heroImage as ImageMetadata}
                  heroImageAlt={post.data.heroImageAlt}
                  prepTime={(post.data as any).prepTime}
                  totalTime={(post.data as any).totalTime}
                  difficulty={(post.data as any).difficulty}
                  headingLevel="h3"
                  featured={isFeatured}
                />
              </div>
            ) : (
              <div class:list={[isFeatured && "sm:col-span-2 lg:col-span-2"]}>
                <ArticleCard
                  title={post.data.title}
                  description={post.data.description}
                  slug={slug}
                  locale={locale}
                  heroImage={post.data.heroImage as ImageMetadata}
                  heroImageAlt={post.data.heroImageAlt}
                  publishDate={post.data.publishDate}
                  readingTime={(post.data as any).readingTime}
                  headingLevel="h3"
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Recipes -->
  {recipes.length > 0 && (
    <section class="mx-auto max-w-content px-4 py-section">
      <SectionHeading>{t(locale, "home.featuredRecipes")}</SectionHeading>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {recipes.slice(0, 6).map((recipe) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
            />
          );
        })}
      </div>
      {recipes.length > 6 && (
        <div class="mt-10 text-center">
          <a href="/en/recipes/" class="btn btn-outline-brand">
            {t(locale, "home.viewAllRecipes")}
          </a>
        </div>
      )}
    </section>
  )}

  <!-- Categories -->
  {categories.length > 0 && (
    <section class="bg-warm-100 px-4 py-section dark:bg-warm-900">
      <div class="mx-auto max-w-content">
        <SectionHeading>{t(locale, "home.categories")}</SectionHeading>
        <div class="flex flex-wrap justify-center gap-3">
          {categories.map((cat) => (
            <a
              href={`/en/recipes/category/${cat}/`}
              class="rounded-lg border border-warm-200 bg-white px-6 py-2.5 font-ui text-sm font-medium text-warm-700 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-wine hover:text-brand-wine hover:shadow-md dark:border-warm-700 dark:bg-warm-800 dark:text-warm-300"
            >
              {t(locale, `categories.${cat}` as any) || cat}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
