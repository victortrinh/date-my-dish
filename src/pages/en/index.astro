---
import BaseLayout from "@layouts/BaseLayout.astro";
import { t } from "@i18n/utils";

const locale = "en";
---

<BaseLayout
  title={t(locale, "seo.homeTitle")}
  description={t(locale, "seo.homeDescription")}
>
  <div class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h1 class="mb-4 font-handwritten text-5xl text-brand-blue">
      {t(locale, "home.heroTitle")}
    </h1>
    <p class="text-xl text-gray-600">
      {t(locale, "home.heroSubtitle")}
    </p>
  </div>
</BaseLayout>
