---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import { Picture } from "astro:assets";
import { t } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import heroImage from "@assets/images/homepage-hero.jpg";

const locale = "en";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes
  .filter((r) => r.data.lang === "en")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const categories = [...new Set(recipes.flatMap((r) => r.data.recipeCategory))];
categories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={t(locale, "seo.homeTitle")}
  description={t(locale, "seo.homeDescription")}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Date My Dish",
      url: "https://datemydish.com",
      inLanguage: ["en", "fr"],
      potentialAction: {
        "@type": "SearchAction",
        target: "https://datemydish.com/en/search/?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Date My Dish",
      url: "https://datemydish.com",
      sameAs: [
        "https://www.instagram.com/datemydish",
        "https://www.pinterest.com/datemydish",
      ],
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <Picture
        src={heroImage}
        alt="A beautifully plated dish ready to impress"
        widths={[600, 900, 1200]}
        sizes="100vw"
        formats={["avif", "webp"]}
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/60"></div>
    </div>
    <div class="relative px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="mb-4 font-handwritten text-5xl text-white drop-shadow-lg md:text-6xl">
        {t(locale, "home.heroTitle")}
      </h1>
      <p class="mx-auto max-w-xl text-lg text-white/90 drop-shadow">
        {t(locale, "home.heroSubtitle")}
      </p>
      <a
        href="/en/recipes/"
        class="mt-8 inline-block rounded-full bg-brand-primary px-8 py-3 font-ui font-semibold text-white no-underline shadow-lg transition-colors hover:bg-brand-primary-dark"
      >
        {t(locale, "home.viewAllRecipes")}
      </a>
    </div>
  </section>

  <!-- Featured Recipes -->
  {recipes.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-gray-900 dark:text-gray-100">
        {t(locale, "home.featuredRecipes")}
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {recipes.slice(0, 6).map((recipe) => {
          const slug = recipe.id.replace(/^en\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
            />
          );
        })}
      </div>
    </section>
  )}

  <!-- Categories -->
  {categories.length > 0 && (
    <section class="bg-gray-50 dark:bg-gray-800 px-4 py-16">
      <div class="mx-auto max-w-6xl">
        <h2 class="mb-8 text-center font-heading text-3xl font-bold text-gray-900 dark:text-gray-100">
          {t(locale, "home.categories")}
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {categories.map((cat) => (
            <a
              href={`/en/recipes/category/${cat}/`}
              class="rounded-full border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-900 px-5 py-2 font-ui text-sm font-medium text-gray-700 dark:text-gray-300 no-underline shadow-sm transition-colors hover:border-brand-primary hover:text-brand-primary"
            >
              {t(locale, `categories.${cat}` as any) || cat}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
