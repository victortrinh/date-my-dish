---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";

const locale = "en";
---

<BaseLayout
  title={`${t(locale, "contact.pageTitle")} | Date My Dish`}
  description="Get in touch with Victor at Date My Dish. Questions about a recipe, collaboration ideas, or just want to say hi?"
>
  <div class="mx-auto max-w-narrow px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "contact.pageTitle") }]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-gray-900 sm:text-4xl dark:text-gray-100">
        {t(locale, "contact.pageTitle")}
      </h1>
      <div class="h-1 w-12 rounded-full bg-brand-accent"></div>
    </div>

    <div class="prose max-w-none">
      <p>
        Have a question about a recipe? Want to collaborate? Or just want to say hi?
        I'd love to hear from you!
      </p>

      <p>
        The best way to reach me is through social media:
      </p>

      <ul>
        <li><a href="https://instagram.com/datemydish" target="_blank" rel="noopener noreferrer">Instagram — @datemydish</a></li>
        <li><a href="https://pinterest.com/datemydish" target="_blank" rel="noopener noreferrer">Pinterest — @datemydish</a></li>
      </ul>

      <p>
        You can also email me at <a href="mailto:hello@datemydish.com">hello@datemydish.com</a>.
      </p>
    </div>
  </div>
</BaseLayout>
