---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";

const locale = "en";
---

<BaseLayout
  title={`${t(locale, "contact.pageTitle")} | Date My Dish`}
  description="Connect with Victor from Date My Dish on Instagram. Recipe questions, date night planning ideas, collaborations, and feedback — let's create something special."
>
  <div class="mx-auto max-w-narrow px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "contact.pageTitle") }]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-gray-900 sm:text-4xl dark:text-neutral-100">
        {t(locale, "contact.pageTitle")}
      </h1>
      <div class="h-1 w-12 rounded-full bg-brand-accent"></div>
    </div>

    <div class="prose max-w-none">
      <p>
        Whether you have a question about one of my recipes, need advice for planning the perfect
        date night, or want to explore collaboration opportunities, I'd love to hear from you.
        Date My Dish is more than just a recipe site — it's a community of food lovers who believe
        that cooking together creates lasting memories.
      </p>

      <h2>How to Connect</h2>

      <p>
        The best way to reach me is through Instagram DMs. I typically respond within 24-48 hours!
      </p>

      <p>
        <a href="https://www.instagram.com/datemydishdotcom" target="_blank" rel="noopener noreferrer">Instagram — @datemydishdotcom</a>
      </p>

      <p>
        You can also find us on <a href="https://www.pinterest.com/datemydish" target="_blank" rel="noopener noreferrer">Pinterest — @datemydish</a> for recipe inspiration and boards.
      </p>

      <h2>What You Can Reach Out About</h2>

      <ul>
        <li><strong>Recipe questions</strong> — ingredient substitutions, techniques, modifications, or troubleshooting</li>
        <li><strong>Date night planning</strong> — menu suggestions, wine pairings, atmosphere tips</li>
        <li><strong>Collaboration & media inquiries</strong> — partnerships, press, interviews, features</li>
        <li><strong>Feedback & suggestions</strong> — share your recipe experiences or suggest new dishes you'd like to see</li>
      </ul>

      <p>
        Whether you're a beginner or an experienced cook, don't hesitate to reach out.
        Every message matters, and I'm here to help make your next evening truly special.
      </p>
    </div>
  </div>
</BaseLayout>
