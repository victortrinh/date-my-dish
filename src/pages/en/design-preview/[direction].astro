---
// Dev-only preview of the four candidate visual directions on real content.
// Production builds generate no pages here (getStaticPaths returns nothing),
// so nothing reaches dist/, the sitemap or the validators.
import "../../../styles/design-preview.css";
import "../../../styles/directions/wine-label.css";
import "../../../styles/directions/metro.css";
import "../../../styles/directions/greystone.css";
import "../../../styles/directions/magazine.css";
import { getCollection } from "astro:content";
import { t } from "@i18n/utils";
import { copyLocale, isVenueReview, priceLabel, verdictLabel } from "@utils/date-spots";

const DIRECTIONS = {
  "wine-label": {
    name: "Natural wine label",
    fonts: "family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Jost:wght@400;500&family=Literata:ital,opsz,wght@0,7..72,400;1,7..72,400",
    displayTitle: "Date <em>my</em> Dish",
  },
  metro: {
    name: "Métro / Expo 67 system",
    fonts: "family=Schibsted+Grotesk:wght@400;500;700;800",
    displayTitle: "Date My Dish",
  },
  greystone: {
    name: "Greystone evening",
    fonts: "family=Young+Serif&family=Libre+Caslon+Text:ital,wght@0,400;1,400&family=Hanken+Grotesk:wght@400;500;600",
    displayTitle: "Date My Dish",
  },
  magazine: {
    name: "Food-magazine standard",
    fonts: "family=Libre+Caslon+Display&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&family=Work+Sans:wght@400;500;600",
    displayTitle: "Date My Dish",
  },
} as const;
type Direction = keyof typeof DIRECTIONS;

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return ["wine-label", "metro", "greystone", "magazine"].map((direction) => ({ params: { direction } }));
}

const direction = Astro.params.direction as Direction;
const config = DIRECTIONS[direction];
const marks = import.meta.glob("/src/assets/brand/*/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const wordmark = marks[`/src/assets/brand/${direction}/wordmark.svg`];
const monogram = marks[`/src/assets/brand/${direction}/monogram.svg`];

const locale = "en";
const lc = copyLocale(locale);
const spots = (await getCollection("dateSpots")).map(({ data }) => data);
const review = spots.find((spot) => spot.id === "moccione") ?? spots[0];
const copy = review.locales[lc];
const cards = spots.filter((spot) => spot.id !== review.id).slice(0, 3);
const cardMeta = (spot: (typeof spots)[number]) => {
  const c = spot.locales[lc];
  return [("cuisine" in c ? c.cuisine : undefined), spot.priceRange && priceLabel(spot.priceRange, locale)].filter(Boolean).join(" · ");
};
const qualifier = "verdictQualifier" in copy ? copy.verdictQualifier : undefined;
const essentials = isVenueReview(review) ? [
  [t(locale, "dateSpot.cuisine"), "cuisine" in copy ? copy.cuisine : undefined],
  [t(locale, "dateSpot.neighbourhood"), review.neighbourhood],
  [t(locale, "dateSpot.perPersonLabel"), copy.essentials.cost],
  [t(locale, "dateSpot.canYouTalk"), copy.essentials.canYouTalk],
  [t(locale, "dateSpot.booking"), copy.essentials.booking],
].filter(([, v]) => v) : [];
const dots = ["var(--cat-1)", "var(--cat-2)", "var(--cat-4)", "var(--cat-5)"];
---
<!doctype html>
<html lang="en" data-direction={direction}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{config.name} · DMD preview</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${config.fonts}&display=swap`} />
  <script is:inline>
    (function () {
      var p = new URLSearchParams(location.search);
      if (p.get("theme") === "dark") document.documentElement.classList.add("dark");
      if (p.get("motion") !== "off") document.documentElement.classList.add("js-reveal");
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="wordmark" href="#" aria-label="Date My Dish" set:html={wordmark} />
      <nav class="nav" aria-label="Main">
        <a href="#" aria-current="page">Reviews</a>
        <a href="#">Date Spots</a>
        <a href="#">Chefs</a>
        <a href="#">About</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="home-hero wrap">
      <p class="eyebrow" style="--dot: var(--cat-4)">Montréal</p>
      <h1 class="display" set:html={config.displayTitle} />
      <p class="lede">{t(locale, "site.tagline")}</p>
    </section>

    <section class="section wrap" aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest" class="h2">Latest reviews</h2>
        <a class="btn btn-secondary" href="#">All reviews</a>
      </div>
      <div class="cards">
        {cards.map((spot, i) => (
          <a class="card" href="#" data-reveal>
            <div class="card-media"><img src={spot.image.src} alt={spot.locales[lc].imageAlt} width={spot.image.width} height={spot.image.height} loading="lazy" /></div>
            <div class="card-body">
              <p class="eyebrow station" style={`--dot: ${dots[i % dots.length]}`}>{spot.neighbourhood}</p>
              <h3 class="card-title"><span>{spot.name}</span></h3>
              <p class="meta">{cardMeta(spot)}</p>
              <span class="stamp" data-verdict={spot.reviewVerdict}>{verdictLabel(spot.reviewVerdict, locale)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <article class="wrap" aria-labelledby="review-title">
      <div class="review-head review-hero">
        <div style="display:grid;gap:1.5rem">
          <p class="eyebrow station" style="--dot: var(--cat-2)">{t(locale, "dateSpot.review")} · {review.neighbourhood}</p>
          <h2 id="review-title" class="h1">{review.name}<span>, {review.neighbourhood}</span></h2>
          <p class="lede">{copy.opening}</p>
          <p class="meta">{t(locale, "dateSpot.by")} {review.reporterByline} · Checked {review.freshness.lastChecked}</p>
        </div>
        <figure class="hero-media"><img src={review.image.src} alt={copy.imageAlt} width={review.image.width} height={review.image.height} /></figure>
      </div>
      <div class="review-grid">
        <section class="verdict" aria-labelledby="verdict-title">
          <p id="verdict-title" class="eyebrow">Is {review.name} worth it?</p>
          <span class="stamp" data-verdict={review.reviewVerdict}>{verdictLabel(review.reviewVerdict, locale)}{qualifier && <span class="qualifier">, {qualifier}</span>}</span>
          {"verdictHeadline" in copy && copy.verdictHeadline && <p class="h2">{copy.verdictHeadline}</p>}
          <p>{copy.verdictReason.split("\n\n")[0]}</p>
        </section>
        <aside class="essentials" aria-labelledby="essentials-title" data-reveal>
          <h2 id="essentials-title" class="h3">{t(locale, "dateSpot.essentials")}</h2>
          <dl>{essentials.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
          <div class="actions">
            <a class="btn btn-primary" href="#">{t(locale, "dateSpot.book")}</a>
            <a class="btn btn-secondary" href="#">{t(locale, "dateSpot.map")}</a>
          </div>
        </aside>
      </div>
    </article>

    <section class="wrap board" aria-label="Brand marks">
      <figure><div set:html={wordmark} /><figcaption>Wordmark</figcaption></figure>
      <figure><div class="tile" set:html={monogram} /><figcaption>Monogram (favicon, avatar)</figcaption></figure>
      <figure><div class="tile dark-tile" set:html={monogram} /><figcaption>Monogram, reversed</figcaption></figure>
      <figure>
        <div class="swatches">
          <span style="background:var(--surface)" /><span style="background:var(--surface-raised)" /><span style="background:var(--ink)" /><span style="background:var(--ink-muted)" /><span style="background:var(--accent)" /><span style="background:var(--verdict-conditional)" />
        </div>
        <figcaption>Surface · raised · ink · muted · accent · conditional</figcaption>
      </figure>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap meta">Preview: {config.name}. Not a production page.</div>
  </footer>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!root.classList.contains("js-reveal")) return;
      var items = document.querySelectorAll("[data-reveal]");
      if (!("IntersectionObserver" in window)) { items.forEach(function (el) { el.classList.add("is-in"); }); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } });
      }, { rootMargin: "0px 0px -10% 0px" });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
