---
import BrandDescriptor from "@components/BrandDescriptor.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import DateSpotCard from "@components/DateSpotCard.astro";
import { t } from "@i18n/utils";
import { SITE_URL } from "@utils/constants";
import { getCollection } from "astro:content";
const locale = "fr";
const recentSpots = (await getCollection("dateSpots"))
  .sort((a, b) => b.data.freshness.published.localeCompare(a.data.freshness.published))
  .slice(0, 6);
---
<BaseLayout title={t(locale, "seo.homeTitle")} description={t(locale, "seo.homeDescription")}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Date My Dish",
      alternateName: "datemydish.com",
      url: SITE_URL,
      inLanguage: ["en", "fr"],
      potentialAction: {
        "@type": "SearchAction",
        target: `${SITE_URL}/fr/recherche/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Date My Dish",
      url: SITE_URL,
      logo: `${SITE_URL}/images/og-default.jpg`,
      sameAs: [
        "https://www.instagram.com/datemydishdotcom",
        "https://www.pinterest.com/datemydish",
      ],
    })} />
  </Fragment>

  <section class="bg-warm-100 px-4 py-section dark:bg-warm-900">
    <div class="mx-auto max-w-content">
      <p class="mb-5 font-ui text-sm tracking-widest text-brand-wine-text dark:text-brand-wine-dark">Montréal</p>
      <h1 class="max-w-4xl font-heading text-4xl leading-tight text-warm-800 dark:text-warm-50 sm:text-6xl">Date My Dish</h1>
      <p class="mt-6 max-w-3xl font-heading text-2xl text-warm-600 dark:text-warm-300"><BrandDescriptor locale={locale} /></p>
    </div>
  </section>
  {recentSpots.length > 0 && <section class="mx-auto max-w-content px-4 py-section" aria-labelledby="date-spots">
    <h2 id="date-spots" class="mb-8 font-heading text-3xl text-warm-900 dark:text-warm-100">Date Spots</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{recentSpots.map((spot) => <DateSpotCard spot={spot} locale={locale} />)}</div>
  </section>}
</BaseLayout>
