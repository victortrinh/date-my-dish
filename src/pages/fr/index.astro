---
import BrandDescriptor from "@components/BrandDescriptor.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import DateSpotCard from "@components/DateSpotCard.astro";
import VerdictBadge from "@components/date-spots/VerdictBadge.astro";
import { t } from "@i18n/utils";
import { SITE_URL } from "@utils/constants";
import { getCollection } from "astro:content";
const locale = "fr";
const dateSpotsPath = "/fr/lieux/";
const recentSpots = (await getCollection("dateSpots"))
  .sort((a, b) => b.data.freshness.published.localeCompare(a.data.freshness.published))
  .slice(0, 6);
---
<BaseLayout title={t(locale, "seo.homeTitle")} description={t(locale, "seo.homeDescription")}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Date My Dish",
      alternateName: "datemydish.com",
      url: SITE_URL,
      inLanguage: ["en", "fr"],
      potentialAction: {
        "@type": "SearchAction",
        target: `${SITE_URL}/fr/recherche/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Date My Dish",
      url: SITE_URL,
      logo: `${SITE_URL}/icon-512.png`,
      sameAs: [
        "https://www.instagram.com/datemydishdotcom",
        "https://www.pinterest.com/datemydish",
      ],
    })} />
  </Fragment>

  <section class="page-container pt-section-sm pb-section-sm sm:pt-section">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end lg:gap-16">
      <div class="min-w-0">
        <p class="eyebrow">Montréal</p>
        <h1 class="mt-5 text-5xl text-ink sm:text-display">Date My Dish</h1>
        <p class="mt-6 max-w-measure font-display text-heading-3 text-ink-muted"><BrandDescriptor locale={locale} /></p>
      </div>
      <div class="border-t border-line-strong pt-6">
        <h2 class="font-ui text-body-sm font-medium text-ink-subtle">{t(locale, "home.verdictsTitle")}</h2>
        <ul class="mt-4 space-y-3">
          {(["favourite", "conditional", "pass"] as const).map((verdict) => <li><VerdictBadge verdict={verdict} locale={locale} /></li>)}
        </ul>
      </div>
    </div>
  </section>
  {recentSpots.length > 0 && <section class="page-container pb-section" aria-labelledby="date-spots">
    <div class="flex flex-wrap items-end justify-between gap-6 border-t border-line-strong pt-6">
      <h2 id="date-spots" class="text-heading-2 text-ink">{t(locale, "nav.dateSpots")}</h2>
      <a href={dateSpotsPath} class="btn btn-secondary">{t(locale, "home.allDateSpots")}</a>
    </div>
    <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">{recentSpots.map((spot, index) => <DateSpotCard spot={spot} locale={locale} headingLevel={3} loading={index === 0 ? "eager" : "lazy"} />)}</div>
  </section>}
</BaseLayout>
