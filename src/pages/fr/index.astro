---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { Picture } from "astro:assets";
import { t, getCategorySlug } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import heroImage from "@assets/images/homepage-hero.jpg";

const locale = "fr";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes
  .filter((r) => r.data.lang === "fr")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const allArticles = await getCollection("articles");
const articles = allArticles
  .filter((a) => a.data.lang === "fr")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const recentPosts = [...recipes, ...articles]
  .sort((a, b) => {
    const dateDiff = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.id.localeCompare(b.id);
  })
  .slice(0, 3);

const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const categories = [...new Set(recipes.flatMap((r) => r.data.recipeCategory))];
categories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={t(locale, "seo.homeTitle")}
  description={t(locale, "seo.homeDescription")}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Date My Dish",
      url: "https://datemydish.com",
      inLanguage: ["en", "fr"],
      potentialAction: {
        "@type": "SearchAction",
        target: "https://datemydish.com/fr/recherche/?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Date My Dish",
      url: "https://datemydish.com",
      logo: "https://datemydish.com/images/og-default.jpg",
      sameAs: [
        "https://www.instagram.com/datemydishdotcom",
        "https://www.pinterest.com/datemydish",
      ],
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gray-900">
    <div class="absolute inset-0">
      <Picture
        src={heroImage}
        alt="Un plat magnifiquement dressé pour impressionner"
        widths={[600, 900, 1200]}
        sizes="100vw"
        formats={["avif", "webp"]}
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/70"></div>
    </div>
    <div class="relative px-4 py-28 text-center sm:py-36 lg:py-44">
      <h1 class="mb-5 font-handwritten text-3xl normal-case text-white drop-shadow-lg sm:text-4xl lg:text-5xl">
        {t(locale, "home.heroTitle")}
      </h1>
      <p class="mx-auto max-w-lg text-sm text-white/85 drop-shadow sm:text-base">
        {t(locale, "home.heroSubtitle")}
      </p>
      <a
        href="/fr/recettes/"
        class="mt-10 inline-block rounded-lg bg-brand-primary-dark px-6 py-2.5 font-ui text-sm font-semibold text-white no-underline shadow-lg transition-all hover:bg-brand-primary hover:text-white hover:shadow-xl dark:text-white dark:hover:text-white sm:px-8 sm:py-3 sm:text-base"
      >
        {t(locale, "home.viewAllRecipes")}
      </a>
    </div>
  </section>

  <!-- Recent Posts -->
  {recentPosts.length > 0 && (
    <section class="bg-gray-200 px-4 py-section dark:bg-neutral-900" aria-labelledby="recent-posts">
      <div class="mx-auto max-w-content">
        <div class="mb-10 text-center">
          <h2 id="recent-posts" class="font-heading text-heading-1 font-bold text-gray-900 dark:text-neutral-100">
            {t(locale, "home.recentPosts")}
          </h2>
          <div class="mx-auto mt-3 h-1 w-12 rounded-full bg-brand-accent"></div>
        </div>
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => {
            const slug = post.id.replace(/^fr\//, "");
            return post.collection === "recipes" ? (
              <RecipeCard
                title={post.data.title}
                description={post.data.description}
                slug={slug}
                locale={locale}
                heroImage={post.data.heroImage as ImageMetadata}
                heroImageAlt={post.data.heroImageAlt}
                prepTime={(post.data as any).prepTime}
                totalTime={(post.data as any).totalTime}
                difficulty={(post.data as any).difficulty}
                headingLevel="h3"
              />
            ) : (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                slug={slug}
                locale={locale}
                heroImage={post.data.heroImage as ImageMetadata}
                heroImageAlt={post.data.heroImageAlt}
                publishDate={post.data.publishDate}
                readingTime={(post.data as any).readingTime}
                headingLevel="h3"
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Recipes -->
  {recipes.length > 0 && (
    <section class="mx-auto max-w-content px-4 py-section">
      <div class="mb-10 text-center">
        <h2 class="font-heading text-heading-1 font-bold text-gray-900 dark:text-neutral-100">
          {t(locale, "home.featuredRecipes")}
        </h2>
        <div class="mx-auto mt-3 h-1 w-12 rounded-full bg-brand-accent"></div>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {recipes.slice(0, 6).map((recipe) => {
          const slug = recipe.id.replace(/^fr\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
            />
          );
        })}
      </div>
      {recipes.length > 6 && (
        <div class="mt-10 text-center">
          <a
            href="/fr/recettes/"
            class="inline-block rounded-lg border-2 border-brand-primary px-6 py-2.5 font-ui text-sm font-semibold text-brand-primary-text no-underline transition-colors hover:bg-brand-primary-dark hover:text-white dark:hover:text-white"
          >
            {t(locale, "home.viewAllRecipes")}
          </a>
        </div>
      )}
    </section>
  )}

  <!-- Categories -->
  {categories.length > 0 && (
    <section class="bg-gray-200 px-4 py-section dark:bg-neutral-900">
      <div class="mx-auto max-w-content">
        <div class="mb-10 text-center">
          <h2 class="font-heading text-heading-1 font-bold text-gray-900 dark:text-neutral-100">
            {t(locale, "home.categories")}
          </h2>
          <div class="mx-auto mt-3 h-1 w-12 rounded-full bg-brand-accent"></div>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          {categories.map((cat) => (
            <a
              href={`/fr/recettes/categorie/${getCategorySlug(cat, locale)}/`}
              class="rounded-lg border border-gray-300 bg-white px-6 py-2.5 font-ui text-sm font-medium text-gray-700 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-brand-primary hover:text-brand-primary hover:shadow-md dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
            >
              {t(locale, `categories.${cat}` as any) || cat}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
