---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";
import { profilePath } from "@utils/date-spots";

const profiles = (await getCollection("extendedProfiles")).map(({ data }) => data).sort((a, b) => b.published.localeCompare(a.published));
const title = t("fr", "profile.indexTitle");
---
<BaseLayout title={`${title} | Date My Dish`} description={t("fr", "profile.indexDescription")} noindex={profiles.length === 0}>
  <section data-pagefind-ignore={profiles.length === 0 || undefined} class="mx-auto max-w-content px-4 py-section">
    <Breadcrumbs locale="fr" items={[{ label: t("fr", "nav.chefs") }]} />
    <h1 class="my-8 font-heading text-4xl text-warm-900 dark:text-warm-100">{title}</h1>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {profiles.map((profile) => {
        const copy = profile.locales["fr-CA"];
        return (
          <a href={profilePath(copy.slug, "fr")} class="block border border-warm-200 bg-white no-underline dark:border-warm-700 dark:bg-warm-900">
            <img src={profile.image.src} width={profile.image.width} height={profile.image.height} alt={copy.imageAlt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
            <div class="p-6">
              <h2 class="text-heading-3 text-warm-900 dark:text-warm-100">{profile.subject.name}</h2>
              <p class="mt-1 font-ui text-body-sm text-warm-500 dark:text-warm-400">{profile.subject.venue} · {profile.subject.neighbourhood}</p>
              <p class="mt-3 text-warm-700 dark:text-warm-300">{copy.standfirst}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
