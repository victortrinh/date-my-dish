---
import { getCollection } from "astro:content";
import DateSpotListing from "@components/DateSpotListing.astro";
import { isVenueReview } from "@utils/date-spots";
import { t } from "@i18n/utils";
const spots = (await getCollection("dateSpots")).filter(({ data }) => isVenueReview(data));
---
<DateSpotListing spots={spots} locale="fr" title={t("fr", "nav.venueReviews")} />
