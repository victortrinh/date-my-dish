---
import { getCollection } from "astro:content";
import RestaurantDateSpot from "@components/RestaurantDateSpot.astro";
import { isRestaurantDateSpot } from "@utils/date-spots";

export async function getStaticPaths() {
  const spots = await getCollection("dateSpots");
  return spots.filter(isRestaurantDateSpot).map((spot) => ({
    params: { slug: spot.data.locales["fr-CA"].slug }, props: { spot },
  }));
}

const { spot } = Astro.props;
---
<RestaurantDateSpot spot={spot} locale="fr" />
