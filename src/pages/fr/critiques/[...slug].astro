---
import { getCollection } from "astro:content";
import RestaurantDateSpot from "@components/RestaurantDateSpot.astro";
export async function getStaticPaths() {
  const spots = await getCollection("dateSpots");
  return spots.filter(({ data }) => data.spotType === "restaurant").map(({ data: spot }) => ({ params: { slug: spot.locales["fr-CA"].slug }, props: { spot } }));
}
const { spot } = Astro.props;
---
<RestaurantDateSpot spot={spot} locale="fr" />
