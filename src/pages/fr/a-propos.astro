---
import BrandDescriptor from "@components/BrandDescriptor.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";
import { SITE_URL } from "@utils/constants";
const locale = "fr";
---
<BaseLayout title={`${t(locale, "about.pageTitle")} | Date My Dish`} description={t(locale, "seo.homeDescription")}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "AboutPage",
    name: t(locale, "about.pageTitle"), url: `${SITE_URL}/fr/a-propos/`,
    mainEntity: { "@type": "Organization", name: "Date My Dish", url: SITE_URL },
    contributor: { "@type": "Person", name: "Victor Vu" },
  })} />
  <section class="page-container pt-8 pb-section">
    <Breadcrumbs locale={locale} items={[{ label: t(locale, "about.pageTitle") }]} />
    <p class="eyebrow mt-10">{t(locale, "about.market")}</p>
    <h1 class="mt-5 max-w-4xl text-4xl text-ink sm:text-heading-1 lg:text-display">{t(locale, "about.pageTitle")} Date My Dish</h1>
    <p class="mt-6 max-w-measure font-display text-heading-3 text-ink-muted"><BrandDescriptor locale={locale} /></p>
    <div class="mt-section-sm max-w-measure space-y-6 border-t border-line-strong pt-8 font-body text-body-lg text-ink-muted">
      <p>{t(locale, "about.intro")}</p>
      <p>{t(locale, "about.verdicts")}</p>
      <p>{t(locale, "about.homeMarket")}</p>
      <p>{t(locale, "about.reporter")}</p>
    </div>
  </section>
</BaseLayout>
