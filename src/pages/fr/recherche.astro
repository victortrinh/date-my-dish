---
import BaseLayout from "@layouts/BaseLayout.astro";
import SearchBar from "@components/SearchBar.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";

const locale = "fr";
---

<BaseLayout
  title={`${t(locale, "search.title")} | Date My Dish`}
  description="Rechercher sur Date My Dish."
  noindex={true}
>
  <div class="page-container pt-8 pb-section">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "nav.search") }]}
    />

    <h1 class="mt-10 mb-12 max-w-4xl text-4xl text-ink sm:text-heading-1">
      {t(locale, "search.title")}
    </h1>

    <div class="max-w-narrow">
      <SearchBar locale={locale} />
    </div>
  </div>
</BaseLayout>
