---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath, getOccasionLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { SITE_URL } from "@utils/constants";

const locale = "fr";

const OCCASION_ORDER = ["date-night", "weeknight", "entertaining", "comfort", "celebration", "quick-meal"];

export async function getStaticPaths() {
  const { getOccasionSlug: getSlug } = await import("@i18n/utils");
  const recipes = await getCollection("recipes");
  const frRecipes = recipes.filter((r) => r.data.lang === "fr");
  const occasions = [...new Set(frRecipes.flatMap((r) => r.data.occasion || []))];

  return occasions.map((canonicalOccasion) => ({
    params: { occasion: getSlug(canonicalOccasion, "fr") },
    props: {
      canonicalOccasion,
      recipes: frRecipes.filter((r) => (r.data.occasion || []).includes(canonicalOccasion)),
    },
  }));
}

const { canonicalOccasion, recipes } = Astro.props;
const occasionLabel = t(locale, `occasion.${canonicalOccasion}` as any) || canonicalOccasion;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const allRecipes = await getCollection("recipes");
const frRecipes = allRecipes.filter((r) => r.data.lang === "fr");
const allOccasions = [...new Set(frRecipes.flatMap((r) => r.data.occasion || []))];
allOccasions.sort((a, b) => {
  const ai = OCCASION_ORDER.indexOf(a);
  const bi = OCCASION_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});

const MIN_RECIPES_FOR_INDEX = 3;
const shouldNoindex = sortedRecipes.length < MIN_RECIPES_FOR_INDEX;

const occasionDescriptions: Record<string, string> = {
  "date-night": "Cuisiner pour quelqu'un qu'on aime, c'est l'un des gestes les plus romantiques qui soit. Ces recettes de soirée en amoureux sont faites pour ça : des plats avec un dressage qui impressionne, des saveurs audacieuses, et un timing qui fonctionne même quand tu essaies aussi d'allumer des chandelles et de choisir la musique. Chaque recette ici a été testée pour que tu puisses tout réussir sans stress.\n\nLe plus beau? Tu choisis ton aventure. Cuisinez ensemble et faites de la cuisine une partie du rendez-vous, ou prépare une surprise avec quelque chose de magnifique déjà sur la table. Dans les deux cas, ces recettes font du souper l'événement de la soirée.",
  weeknight: "Tu rentres tard, t'as faim, et le divan t'appelle. On comprend. Ces recettes de soir de semaine prouvent que 30 minutes, c'est amplement suffisant pour faire quelque chose qui vaut la peine de s'asseoir à table. Pas de souper triste ici, juste de la vraie bouffe qui se prépare vite.\n\nLe secret, c'est la technique intelligente, pas des raccourcis qui tuent la saveur. Tu vas trouver des plats qui misent sur le feu vif, les sauces punchy et les ingrédients qui font le gros du travail. Parce que \"rapide\" devrait jamais vouloir dire \"plate.\"",
  entertaining: "Recevoir, ça devrait être un party pour toi aussi, pas un shift solo dans la cuisine pendant que tout le monde s'amuse. Ces recettes pour recevoir sont conçues exactement pour ça : des plats que tu peux préparer en partie d'avance, assembler avec confiance, et servir sans stress.\n\nL'astuce, c'est de choisir des recettes qui ont l'air spectaculaires mais qui ne demandent pas ton attention constante. Pense aux plateaux qui se montent tout seuls, aux sauces faites la veille, et aux desserts qui refroidissent déjà au frigo. Tes invités vont penser que c'est facile pour toi. Laisse-les croire.",
  comfort: "Certaines soirées appellent le côté douillet de la cuisine. Des braisés lents, des sauces riches, du pain croûté pour tremper, et le genre de bouffe qui donne envie de rester à la maison pour toujours. Ces recettes réconfortantes sont faites pour les soirées de pluie, les moods \"on reste donc ben chez nous\", et tous ceux qui pensent que le kit mou est une tenue de souper valide.\n\nC'est de la bouffe qui t'enveloppe comme une couverture. Pas de rush, pas de chichi, juste des saveurs profondes qui remplissent la cuisine du genre d'odeur qui fait que tout va bien.",
  celebration: "Des recettes pour les grandes occasions. Des anniversaires aux moments marquants.",
  "quick-meal": "Des repas délicieux prêts en un rien de temps. Rapides, frais et pleins de saveur.",
};
---

<BaseLayout
  title={`Recettes ${occasionLabel} | Date My Dish`}
  description={occasionDescriptions[canonicalOccasion] || `Parcourez nos recettes pour ${occasionLabel.toLowerCase()}. Trouvez votre prochain plat coup de cœur.`}
  noindex={shouldNoindex}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','viewcategory');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `Recettes ${occasionLabel}`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^fr\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `${SITE_URL}${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/fr/recettes/" },
        { label: occasionLabel },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-normal text-warm-900 sm:text-4xl dark:text-warm-100">
        {occasionLabel}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-rose"></div>
      {occasionDescriptions[canonicalOccasion]?.split("\n\n").map((paragraph) => (
        <p class="mb-2 text-body-sm text-warm-500 dark:text-warm-400">
          {paragraph}
        </p>
      ))}
      <p class="text-body-sm text-warm-500 dark:text-warm-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recette" : "recettes"}
      </p>
    </div>

    <!-- Occasion Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/fr/recettes/"
        class="rounded-lg border border-warm-200 px-4 py-2 font-ui text-body-sm font-medium text-warm-600 no-underline transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allOccasions.map((occ) => (
        <a
          href={getOccasionLocalizedPath(locale, occ)}
          class:list={[
            "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
            occ === canonicalOccasion
              ? "bg-brand-wine text-white dark:text-white dark:hover:text-white shadow-md"
              : "border border-warm-200 text-warm-600 transition-colors hover:border-brand-wine hover:text-brand-wine dark:border-warm-600 dark:text-warm-400",
          ]}
          aria-current={occ === canonicalOccasion ? "page" : undefined}
        >
          {t(locale, `occasion.${occ}` as any) || occ}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {sortedRecipes.map((recipe: any, i: number) => {
          const slug = recipe.id.replace(/^fr\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-warm-500 dark:text-warm-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
