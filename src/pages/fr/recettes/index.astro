---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { SITE_URL } from "@utils/constants";

const locale = "fr";

const allRecipes = await getCollection("recipes");
const recipes = allRecipes
  .filter((r) => r.data.lang === "fr")
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

---

<BaseLayout
  title={t(locale, "seo.recipesTitle")}
  description={t(locale, "seo.recipesDescription")}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: t(locale, "listing.allRecipes"),
      numberOfItems: recipes.length,
      itemListElement: recipes.map((recipe, i) => {
        const slug = recipe.id.replace(/^fr\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `${SITE_URL}${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-section-sm">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "nav.recipes") }]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-normal text-warm-900 sm:text-4xl dark:text-warm-100">
        {t(locale, "listing.allRecipes")}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-rose"></div>
      <p class="text-body-sm text-warm-500 dark:text-warm-400">
        {recipes.length} {recipes.length === 1 ? "recette" : "recettes"}
      </p>
    </div>

    <!-- Recipe Grid -->
    {recipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {recipes.map((recipe, i) => {
          const slug = recipe.id.replace(/^fr\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-warm-500 dark:text-warm-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
