---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getCategorySlug, getRecipeLocalizedPath } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "fr";

export async function getStaticPaths() {
  const { getCategorySlug: getSlug } = await import("@i18n/utils");
  const recipes = await getCollection("recipes");
  const frRecipes = recipes.filter((r) => r.data.lang === "fr");
  const categories = [...new Set(frRecipes.flatMap((r) => r.data.recipeCategory))];

  return categories.map((canonicalCategory) => ({
    params: { category: getSlug(canonicalCategory, "fr") },
    props: {
      canonicalCategory,
      recipes: frRecipes.filter((r) => r.data.recipeCategory.includes(canonicalCategory)),
    },
  }));
}

const { canonicalCategory, recipes } = Astro.props;
const categoryLabel = t(locale, `categories.${canonicalCategory}` as any) || canonicalCategory;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const categoryDescriptions: Record<string, string> = {
  dinner: "Le plat principal, celui qui donne le ton a toute la soiree. Des pates pretes en 25 minutes aux braises qui mijotent doucement, le souper, c'est la ou la magie opere.\n\nQue vous cuisiniez en duo ou pour epater la galerie, chaque recette ici est pensee pour impressionner sans vous epuiser. Des saveurs audacieuses, des techniques accessibles et des assiettes qui meritent une photo.",
  appetizer: "La premiere bouchee donne le ton a toute la soiree. Ces entrees sont concues pour impressionner avant meme que le plat principal arrive sur la table.\n\nVoyez les entrees comme votre replique d'ouverture : confiante, un brin inattendue et impossible a oublier. Petites assiettes, grand impact.",
  dessert: "Des finales sucrees qui laissent une impression durable. Chaque dessert ici merite sa place sur la table.",
  "side-dish": "Les seconds roles qui volent la vedette. Des accompagnements qui meritent qu'on leur fasse de la place dans l'assiette.",
  breakfast: "Des recettes matinales qui valent la peine de se lever. Commencez la journee avec quelque chose de vraiment delicieux.",
  lunch: "Des repas du midi qui vont au-dela de la salade triste au bureau. Frais, satisfaisants et prets quand vous l'etes.",
  snack: "Des bouchees rapides pour quand la faim frappe entre les repas.",
  drink: "Des boissons et cocktails a marier avec vos plats preferes.",
  sauce: "Sauces, vinaigrettes et filets qui elevent tout ce qu'ils touchent.",
};

const allRecipes = await getCollection("recipes");
const frRecipes = allRecipes.filter((r) => r.data.lang === "fr");
const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const allCategories = [...new Set(frRecipes.flatMap((r) => r.data.recipeCategory))];
allCategories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={`Recettes ${categoryLabel} | Date My Dish`}
  description={categoryDescriptions[canonicalCategory]?.split("\n\n")[0] || `Parcourez nos recettes de ${categoryLabel.toLowerCase()}. Trouvez votre prochain plat coup de cœur.`}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','viewcategory');</script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `Recettes ${categoryLabel}`,
      numberOfItems: sortedRecipes.length,
      itemListElement: sortedRecipes.map((recipe: any, i: number) => {
        const slug = recipe.id.replace(/^fr\//, "");
        return {
          "@type": "ListItem",
          position: i + 1,
          url: `https://datemydish.com${getRecipeLocalizedPath(locale, slug)}`,
          name: recipe.data.title,
        };
      }),
    })} />
  </Fragment>

  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/fr/recettes/" },
        { label: categoryLabel },
      ]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-gray-900 sm:text-4xl dark:text-neutral-100">
        {categoryLabel}
      </h1>
      <div class="mb-4 h-1 w-12 rounded-full bg-brand-accent"></div>
      {categoryDescriptions[canonicalCategory] && (
        categoryDescriptions[canonicalCategory].split("\n\n").map((paragraph) => (
          <p class="mb-2 text-body-sm text-gray-500 dark:text-neutral-400">{paragraph}</p>
        ))
      )}
      <p class="text-body-sm text-gray-500 dark:text-neutral-400">
        {sortedRecipes.length} {sortedRecipes.length === 1 ? "recette" : "recettes"}
      </p>
    </div>

    <!-- Category Filter -->
    <div class="mb-10 flex flex-wrap gap-2">
      <a
        href="/fr/recettes/"
        class="rounded-lg border border-gray-200 px-4 py-2 font-ui text-body-sm font-medium text-gray-600 no-underline transition-colors hover:border-brand-primary hover:text-brand-primary dark:border-neutral-600 dark:text-neutral-400"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allCategories.map((cat) => (
        <a
          href={`/fr/recettes/categorie/${getCategorySlug(cat, locale)}/`}
          class:list={[
            "rounded-lg px-4 py-2 font-ui text-body-sm font-medium no-underline",
            cat === canonicalCategory
              ? "bg-brand-primary-dark text-white dark:text-white dark:hover:text-white shadow-md"
              : "border border-gray-200 text-gray-600 transition-colors hover:border-brand-primary hover:text-brand-primary dark:border-neutral-600 dark:text-neutral-400",
          ]}
          aria-current={cat === canonicalCategory ? "page" : undefined}
        >
          {t(locale, `categories.${cat}` as any) || cat}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
        {sortedRecipes.map((recipe: any, i: number) => {
          const slug = recipe.id.replace(/^fr\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
              loading={i === 0 ? "eager" : "lazy"}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-gray-500 dark:text-neutral-400">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
