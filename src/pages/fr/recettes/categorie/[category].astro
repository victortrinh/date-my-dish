---
import BaseLayout from "@layouts/BaseLayout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

const locale = "fr";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  const frRecipes = recipes.filter((r) => r.data.lang === "fr");
  const categories = [...new Set(frRecipes.flatMap((r) => r.data.recipeCategory))];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      recipes: frRecipes.filter((r) => r.data.recipeCategory.includes(category)),
    },
  }));
}

const { category, recipes } = Astro.props;
const categoryLabel = t(locale, `categories.${category}` as any) || category;
const sortedRecipes = recipes.sort(
  (a: any, b: any) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const allRecipes = await getCollection("recipes");
const frRecipes = allRecipes.filter((r) => r.data.lang === "fr");
const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const allCategories = [...new Set(frRecipes.flatMap((r) => r.data.recipeCategory))];
allCategories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});
---

<BaseLayout
  title={`Recettes ${categoryLabel} | Date My Dish`}
  description={`Parcourez nos recettes de ${categoryLabel.toLowerCase()}. Trouvez votre prochain plat coup de cœur.`}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/fr/recettes/" },
        { label: categoryLabel },
      ]}
    />

    <h1 class="mb-8 font-heading text-4xl font-bold text-gray-900">
      {categoryLabel}
    </h1>

    <!-- Category Filter -->
    <div class="mb-8 flex flex-wrap gap-2">
      <a
        href="/fr/recettes/"
        class="rounded-full border border-gray-200 px-4 py-1.5 font-ui text-sm font-medium text-gray-600 no-underline transition-colors hover:border-brand-primary hover:text-brand-primary"
      >
        {t(locale, "listing.allCategories")}
      </a>
      {allCategories.map((cat) => (
        <a
          href={`/fr/recettes/categorie/${cat}/`}
          class:list={[
            "rounded-full px-4 py-1.5 font-ui text-sm font-medium no-underline",
            cat === category
              ? "bg-brand-primary text-white"
              : "border border-gray-200 text-gray-600 transition-colors hover:border-brand-primary hover:text-brand-primary",
          ]}
          aria-current={cat === category ? "page" : undefined}
        >
          {t(locale, `categories.${cat}` as any) || cat}
        </a>
      ))}
    </div>

    {sortedRecipes.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedRecipes.map((recipe: any) => {
          const slug = recipe.id.replace(/^fr\//, "");
          return (
            <RecipeCard
              title={recipe.data.title}
              description={recipe.data.description}
              slug={slug}
              locale={locale}
              heroImage={recipe.data.heroImage as ImageMetadata}
              heroImageAlt={recipe.data.heroImageAlt}
              prepTime={recipe.data.prepTime}
              totalTime={recipe.data.totalTime}
              difficulty={recipe.data.difficulty}
            />
          );
        })}
      </div>
    ) : (
      <p class="text-gray-500">{t(locale, "listing.noRecipesFound")}</p>
    )}
  </div>
</BaseLayout>
