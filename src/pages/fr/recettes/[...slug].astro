---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import RecipeLayout from "@layouts/RecipeLayout.astro";
import RecipeSchema from "@components/RecipeSchema.astro";
import RecipeContent from "@components/RecipeContent.astro";
import RecipeDetailCard from "@components/RecipeDetailCard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import AuthorBioCard from "@components/AuthorBioCard.astro";

import SocialShareButtons from "@components/SocialShareButtons.astro";
import StarRating from "@components/StarRating.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import DateNightTips from "@components/DateNightTips.astro";
import FAQSection from "@components/FAQSection.astro";
import RelatedRecipes from "@components/RelatedRecipes.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t, getRecipeLocalizedPath } from "@i18n/utils";
import authorPhoto from "@assets/images/victor-vu.webp";
import { formatDuration } from "@utils/format";
import { difficultyBadge } from "@utils/recipe";
import { SITE_URL } from "@utils/constants";
import type { ImageMetadata } from "astro";
import ratingsData from "../../../../data/ratings.json";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes
    .filter((recipe) => recipe.data.lang === "fr")
    .map((recipe) => {
      const slug = recipe.id.replace(/^fr\//, "");
      return {
        params: { slug },
        props: { recipe },
      };
    });
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;
const locale = "fr";
const slug = recipe.id.replace(/^fr\//, "");
const heroImage = data.heroImage as ImageMetadata;
const sourceUrl = `${SITE_URL}${getRecipeLocalizedPath(locale, slug)}`;
const ratingData = (ratingsData as Record<string, { averageRating: number; ratingCount: number }>)[slug];

---

<RecipeLayout
  title={`${data.title} | Date My Dish`}
  description={data.description}
  locale={locale}
  ogImage={heroImage.src}
  translationSlug={data.translationSlug}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
>
  <Fragment slot="head">
    <script is:inline>window.pintrk&&pintrk('track','pagevisit');</script>
  </Fragment>
  <RecipeSchema
    slot="head"
    title={data.title}
    description={data.description}
    slug={slug}
    lang={locale}
    author={data.author}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
    heroImageUrl={heroImage.src}
    prepTime={data.prepTime}
    cookTime={data.cookTime}
    totalTime={data.totalTime}
    recipeYield={data.recipeYield}
    recipeCategory={data.recipeCategory}
    recipeCuisine={data.recipeCuisine}
    keywords={data.keywords}
    ingredientGroups={data.ingredientGroups}
    instructionGroups={data.instructionGroups}
    nutrition={data.nutrition}
    faqs={data.faqs}
    ratingData={ratingData}
    video={data.video}
  />

  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <!-- Full-width zone: Breadcrumbs + Hero + Meta -->
    <div class="mx-auto max-w-prose lg:max-w-none">
      <Breadcrumbs
        locale={locale}
        items={[
          { label: t(locale, "nav.recipes"), href: "/fr/recettes/" },
          { label: data.title },
        ]}
      />

      <!-- Hero Section -->
      <header class="no-print mb-8 p-6 sm:p-8 lg:px-0 lg:py-12">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16">
          <!-- Left: Content -->
          <div class="order-2 flex flex-col justify-start lg:order-1">
            {data.recipeCategory && data.recipeCategory.length > 0 ? (
              <div class="mb-4">
                <span class="inline-block rounded-full bg-brand-wine/10 px-4 py-1.5 font-ui text-caption font-semibold uppercase tracking-wider text-brand-wine dark:bg-brand-wine-dark/10 dark:text-brand-wine-dark">
                  {t(locale, `categories.${data.recipeCategory[0]}` as any) || data.recipeCategory[0]}
                </span>
              </div>
            ) : null}

            <h1 class="mb-4 font-heading text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">
              {data.title}
            </h1>

            <p class="mb-8 font-body text-body-lg text-warm-600 dark:text-warm-400">
              {data.description}
            </p>

            <!-- Author + Jump to Recipe -->
            <div class="mb-8 flex flex-wrap items-center gap-5">
              <div class="flex items-center gap-3">
                <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full">
                  <Picture
                    src={authorPhoto}
                    alt={t(locale, "author.photoAlt")}
                    widths={[48, 96]}
                    sizes="48px"
                    formats={["avif", "webp"]} fallbackFormat="webp"
                    class="h-full w-full object-cover"
                    loading="eager"
                    data-pin-nopin="true"
                  />
                </div>
                <div>
                  <span class="block font-ui text-body-sm font-semibold text-warm-800 dark:text-warm-200">
                    {t(locale, "author.by")} {data.author || "Victor"}
                  </span>
                  <span class="block font-ui text-caption font-medium uppercase tracking-wider text-brand-wine dark:text-brand-wine-dark">
                    {t(locale, "author.recipeAuthor")}
                  </span>
                </div>
              </div>
              <a
                href="#recipe-card"
                class="btn btn-primary rounded-full px-8 py-4 text-base shadow-lg shadow-brand-wine/20 hover:shadow-xl"
              >
                {t(locale, "recipe.jumpToRecipe")}
              </a>
            </div>

            <!-- Meta Bar -->
            <div class:list={["grid grid-cols-2 gap-4 rounded-xl border border-brand-wine/5 bg-white p-4 shadow-sm dark:border-warm-700 dark:bg-warm-800", data.passiveTime ? "sm:grid-cols-5" : "sm:grid-cols-4"]}>
              <div class="text-center border-r border-brand-wine/10 dark:border-warm-700">
                <p class="mb-1 font-ui text-[10px] font-bold uppercase tracking-wider text-brand-wine/50 dark:text-brand-rose">
                  {t(locale, "recipe.prep")}
                </p>
                <p class="font-body text-sm font-bold text-warm-800 dark:text-warm-200">
                  {formatDuration(data.prepTime, locale)}
                </p>
              </div>
              <div class="text-center sm:border-r border-brand-wine/10 dark:border-warm-700">
                <p class="mb-1 font-ui text-[10px] font-bold uppercase tracking-wider text-brand-wine/50 dark:text-brand-rose">
                  {t(locale, "recipe.cook")}
                </p>
                <p class="font-body text-sm font-bold text-warm-800 dark:text-warm-200">
                  {formatDuration(data.cookTime, locale)}
                </p>
              </div>
              {data.passiveTime && (
                <div class="text-center border-r border-brand-wine/10 dark:border-warm-700">
                  <p class="mb-1 font-ui text-[10px] font-bold uppercase tracking-wider text-brand-wine/50 dark:text-brand-rose">
                    {t(locale, "recipe.passive")}
                  </p>
                  <p class="font-body text-sm font-bold text-warm-800 dark:text-warm-200">
                    {formatDuration(data.passiveTime, locale)}
                  </p>
                </div>
              )}
              <div class="text-center border-r border-brand-wine/10 dark:border-warm-700">
                <p class="mb-1 font-ui text-[10px] font-bold uppercase tracking-wider text-brand-wine/50 dark:text-brand-rose">
                  {t(locale, "recipe.total")}
                </p>
                <p class="font-body text-sm font-bold text-warm-800 dark:text-warm-200">
                  {formatDuration(data.totalTime, locale)}
                </p>
              </div>
              <div class="text-center">
                <p class="mb-1 font-ui text-[10px] font-bold uppercase tracking-wider text-brand-wine/50 dark:text-brand-rose">
                  {t(locale, "recipe.difficulty")}
                </p>
                <span class={difficultyBadge[data.difficulty]}>
                  {t(locale, `recipe.${data.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
                </span>
              </div>
            </div>
          </div>

          <!-- Right: Hero Image -->
          <div class="relative order-1 lg:order-2">
            <Picture
              src={heroImage}
              alt={data.heroImageAlt}
              widths={[400, 600, 900]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              formats={["avif", "webp"]} fallbackFormat="webp"
              class="h-[600px] w-full rounded-2xl object-cover"
              loading="eager"
              fetchpriority="high"
              data-pin-url={sourceUrl}
              data-pin-description={`${data.title} | ${data.description} | Date My Dish`}
            />
            {data.summary && (
              <div class="absolute bottom-4 left-4 max-w-[200px] rounded-xl bg-white/95 p-3 shadow-lg backdrop-blur-sm dark:bg-warm-800/95 sm:bottom-6 sm:left-6 sm:max-w-[240px] sm:p-4">
                <p class="line-clamp-3 font-caveat text-base leading-snug text-brand-wine dark:text-brand-wine-dark sm:line-clamp-4 sm:text-lg">
                  &ldquo;{data.summary}&rdquo;
                </p>
              </div>
            )}
          </div>
        </div>
      </header>

    </div>

    <!-- Two-column zone (hidden in print — card handles print) -->
    <div class:list={["no-print recipe-two-col mx-auto grid max-w-prose grid-cols-1 gap-8", data.dateNightTips && "lg:max-w-none lg:grid-cols-12 lg:gap-12"]}>
      <!-- Main column -->
      <div class:list={["recipe-main-col min-w-0", data.dateNightTips && "lg:col-span-8"]}>
        <TableOfContents locale={locale} />
        <div class="prose mb-12 max-w-none">
          <Content />
        </div>
        <RecipeContent
          locale={locale}
          title={data.title}
          prepTime={data.prepTime}
          cookTime={data.cookTime}
          totalTime={data.totalTime}
          passiveTime={data.passiveTime}
          recipeYield={data.recipeYield}
          difficulty={data.difficulty}
          instructionGroups={data.instructionGroups}
          sourceUrl={sourceUrl}
        />
      </div>

      {data.dateNightTips && (
        <!-- Sidebar (desktop only) -->
        <aside class="recipe-sidebar hidden lg:col-span-4 lg:block">
          <DateNightTips locale={locale} tips={data.dateNightTips} compact={true} />
        </aside>
      )}
    </div>

    <!-- DateNightTips (mobile/tablet only) -->
    {data.dateNightTips && (
      <div class="mx-auto mt-8 max-w-prose lg:hidden">
        <DateNightTips locale={locale} tips={data.dateNightTips} compact={true} />
      </div>
    )}

    <!-- Recipe Detail Card -->
    <div class="mx-auto mt-8 max-w-prose">
      <RecipeDetailCard
        locale={locale}
        title={data.title}
        heroImageSrc={heroImage.src}
        prepTime={data.prepTime}
        cookTime={data.cookTime}
        totalTime={data.totalTime}
        recipeYield={data.recipeYield}
        ingredientGroups={data.ingredientGroups}
        instructionGroups={data.instructionGroups}
        nutrition={data.nutrition}
        impressFactor={data.impressFactor}
        sourceUrl={sourceUrl}
      >
        <div slot="social" class="no-print flex flex-wrap items-center justify-center gap-1 border-t border-warm-100 px-6 py-4 dark:border-warm-800 lg:px-8">
          <SocialShareButtons locale={locale} url={sourceUrl} title={data.title} imageUrl={heroImage.src} description={data.description} />
        </div>
      </RecipeDetailCard>
    </div>

    <!-- Full-width zone: bottom sections -->
    <div class="mx-auto max-w-prose">
      <!-- Author Bio -->
      <div class="mt-8 no-print">
        <AuthorBioCard locale={locale} />
      </div>

      <!-- Newsletter -->
      <div class="mt-8 no-print">
        <NewsletterSignup locale={locale} compact={true} />
      </div>

      <!-- Star Rating -->
      <StarRating locale={locale} slug={slug} averageRating={ratingData?.averageRating} ratingCount={ratingData?.ratingCount} />

      <!-- FAQs -->
      <FAQSection locale={locale} faqs={data.faqs} />

      <!-- Related Recipes -->
      <RelatedRecipes
        locale={locale}
        currentSlug={slug}
        categories={data.recipeCategory}
      />
    </div>
  </article>
  <script is:inline>
    (function() {
      var canonical = document.querySelector('link[rel="canonical"]');
      var title = document.querySelector('h1');
      if (!canonical || !title) return;
      document.querySelectorAll('.prose img').forEach(function(img) {
        if (!img.dataset.pinUrl) {
          img.dataset.pinUrl = canonical.href;
          img.dataset.pinDescription = title.textContent + ' | Date My Dish';
        }
      });
    })();
  </script>
  <script async defer src="https://assets.pinterest.com/js/pinit.js" data-pin-hover="true" data-pin-tall="true" data-pin-round="true" is:inline></script>
</RecipeLayout>
