---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import RecipeLayout from "@layouts/RecipeLayout.astro";
import RecipeSchema from "@components/RecipeSchema.astro";
import RecipeContent from "@components/RecipeContent.astro";
import JumpToRecipe from "@components/JumpToRecipe.astro";
import FAQSection from "@components/FAQSection.astro";
import RelatedRecipes from "@components/RelatedRecipes.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";
import type { ImageMetadata } from "astro";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes
    .filter((recipe) => recipe.data.lang === "fr")
    .map((recipe) => {
      const slug = recipe.id.replace(/^fr\//, "");
      return {
        params: { slug },
        props: { recipe },
      };
    });
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { data } = recipe;
const locale = "fr";
const slug = recipe.id.replace(/^fr\//, "");
const heroImage = data.heroImage as ImageMetadata;

function formatDuration(iso: string): string {
  const match = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!match) return iso;
  const hours = match[1] ? parseInt(match[1]) : 0;
  const minutes = match[2] ? parseInt(match[2]) : 0;
  if (hours > 0) return `${hours}h${minutes > 0 ? ` ${minutes} ${t(locale, "recipe.minutes")}` : ""}`;
  return `${minutes} ${t(locale, "recipe.minutes")}`;
}

const difficultyColors = {
  easy: "bg-green-100 text-green-800",
  medium: "bg-yellow-100 text-yellow-800",
  hard: "bg-red-100 text-red-800",
};
---

<RecipeLayout
  title={`${data.title} | Date My Dish`}
  description={data.description}
  locale={locale}
  ogImage={heroImage.src}
  translationSlug={data.translationSlug}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
>
  <RecipeSchema
    slot="head"
    title={data.title}
    description={data.description}
    slug={slug}
    lang={locale}
    author={data.author}
    publishDate={data.publishDate}
    updatedDate={data.updatedDate}
    heroImageUrl={heroImage.src}
    prepTime={data.prepTime}
    cookTime={data.cookTime}
    totalTime={data.totalTime}
    recipeYield={data.recipeYield}
    recipeCategory={data.recipeCategory}
    recipeCuisine={data.recipeCuisine}
    keywords={data.keywords}
    ingredientGroups={data.ingredientGroups}
    instructionGroups={data.instructionGroups}
    nutrition={data.nutrition}
    faqs={data.faqs}
  />

  <article class="mx-auto max-w-4xl px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <Breadcrumbs
      locale={locale}
      items={[
        { label: t(locale, "nav.recipes"), href: "/fr/recettes/" },
        { label: data.title },
      ]}
    />

    <!-- Hero Image -->
    <div class="relative mb-8 overflow-hidden rounded-2xl">
      <Picture
        src={heroImage}
        alt={data.heroImageAlt}
        widths={[600, 900, 1200]}
        sizes="(max-width: 896px) 100vw, 896px"
        formats={["avif", "webp"]}
        class="w-full"
        loading="eager"
      />
    </div>

    <!-- Title & Meta -->
    <header class="mb-8">
      <h1 class="mb-4 font-heading text-4xl font-bold text-gray-900">
        {data.title}
      </h1>
      <p class="mb-6 text-lg text-gray-600">{data.description}</p>

      <!-- Meta Bar -->
      <div class="mb-6 flex flex-wrap items-center gap-4 rounded-xl bg-gray-50 p-4">
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">{t(locale, "recipe.prepTime")}</span>
          <span class="font-medium">{formatDuration(data.prepTime)}</span>
        </div>
        <div class="h-4 w-px bg-gray-300"></div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">{t(locale, "recipe.cookTime")}</span>
          <span class="font-medium">{formatDuration(data.cookTime)}</span>
        </div>
        <div class="h-4 w-px bg-gray-300"></div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">{t(locale, "recipe.totalTime")}</span>
          <span class="font-medium">{formatDuration(data.totalTime)}</span>
        </div>
        <div class="h-4 w-px bg-gray-300"></div>
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">{t(locale, "recipe.servings")}</span>
          <span class="font-medium">{data.recipeYield}</span>
        </div>
        <div class="h-4 w-px bg-gray-300"></div>
        <span class={`rounded-full px-3 py-1 text-sm font-medium ${difficultyColors[data.difficulty]}`}>
          {t(locale, `recipe.${data.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
        </span>
      </div>

      <JumpToRecipe locale={locale} />
    </header>

    <!-- Blog Prose -->
    <div class="prose mb-12 max-w-none">
      <Content />
    </div>

    <!-- Recipe Card (Ingredients + Instructions) -->
    <RecipeContent
      locale={locale}
      ingredientGroups={data.ingredientGroups}
      instructionGroups={data.instructionGroups}
    />

    <!-- Nutrition -->
    {data.nutrition && (
      <section class="mt-8 rounded-xl border border-gray-200 p-6">
        <h2 class="mb-4 font-heading text-xl font-bold text-gray-900">
          {t(locale, "recipe.nutrition")}
        </h2>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          {data.nutrition.calories && (
            <div class="text-center">
              <p class="text-2xl font-bold text-brand-blue">{data.nutrition.calories}</p>
              <p class="text-sm text-gray-500">{t(locale, "recipe.calories")}</p>
            </div>
          )}
          {data.nutrition.fatContent && (
            <div class="text-center">
              <p class="text-2xl font-bold text-brand-blue">{data.nutrition.fatContent}</p>
              <p class="text-sm text-gray-500">{t(locale, "recipe.fat")}</p>
            </div>
          )}
          {data.nutrition.carbohydrateContent && (
            <div class="text-center">
              <p class="text-2xl font-bold text-brand-blue">{data.nutrition.carbohydrateContent}</p>
              <p class="text-sm text-gray-500">{t(locale, "recipe.carbs")}</p>
            </div>
          )}
          {data.nutrition.proteinContent && (
            <div class="text-center">
              <p class="text-2xl font-bold text-brand-blue">{data.nutrition.proteinContent}</p>
              <p class="text-sm text-gray-500">{t(locale, "recipe.protein")}</p>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Print Button -->
    <div class="no-print mt-6">
      <button
        onclick="window.print()"
        class="inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 font-ui text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        {t(locale, "recipe.printRecipe")}
      </button>
    </div>

    <!-- FAQs -->
    <FAQSection locale={locale} faqs={data.faqs} />

    <!-- Related Recipes -->
    <RelatedRecipes
      locale={locale}
      currentSlug={slug}
      categories={data.recipeCategory}
    />
  </article>
</RecipeLayout>
