---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { t } from "@i18n/utils";

const locale = "fr";
---

<BaseLayout
  title={`${t(locale, "bookmark.pageTitle")} | Date My Dish`}
  description="Vos recettes sauvegardées sur Date My Dish."
  noindex={true}
>
  <div class="mx-auto max-w-content px-4 py-section-sm">
    <Breadcrumbs
      locale={locale}
      items={[{ label: t(locale, "bookmark.pageTitle") }]}
    />

    <div class="mb-10">
      <h1 class="mb-3 font-heading text-heading-1 font-bold text-warm-900 sm:text-4xl dark:text-warm-100">
        {t(locale, "bookmark.pageTitle")}
      </h1>
      <div class="h-1 w-12 rounded-full bg-brand-rose"></div>
    </div>

    <div id="bookmarks-container">
      <p class="text-body-base text-warm-500 dark:text-warm-400">Chargement...</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    var container = document.getElementById('bookmarks-container');
    if (!container) return;

    var bookmarks;
    try {
      bookmarks = JSON.parse(localStorage.getItem('dmd_bookmarks') || '[]');
    } catch(e) { bookmarks = []; }

    if (bookmarks.length === 0) {
      container.innerHTML = '<div class="rounded-xl border border-warm-200 bg-white p-8 text-center dark:border-warm-800 dark:bg-warm-900">' +
        '<p class="mb-4 text-body-lg text-warm-500 dark:text-warm-400">Aucune recette sauvegardée.</p>' +
        '<a href="/fr/recettes/" class="inline-block rounded-lg bg-brand-wine px-6 py-3 font-ui text-sm font-medium text-white transition-colors hover:bg-brand-wine">Parcourir les recettes</a>' +
        '</div>';
      return;
    }

    container.innerHTML = '<p class="text-body-base text-warm-500 dark:text-warm-400">Chargement de vos recettes sauvegardées...</p>';

    fetch('/recipe-index.json')
      .then(function(r) { return r.json(); })
      .then(function(recipes) {
        var frRecipes = recipes.filter(function(r) { return r.locale === 'fr'; });
        var html = '<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">';
        var found = 0;

        bookmarks.forEach(function(enSlug) {
          var recipe = frRecipes.find(function(r) { return r.translationSlug === enSlug; });
          if (!recipe) return;
          found++;

          html += '<div class="group relative overflow-hidden rounded-xl border border-warm-200 bg-white transition-shadow hover:shadow-lg dark:border-warm-800 dark:bg-warm-900">' +
            '<a href="/fr/recettes/' + recipe.slug + '/" class="block">' +
            '<div class="p-5">' +
            '<h2 class="mb-2 font-heading text-lg font-bold text-warm-900 group-hover:text-brand-wine-text dark:text-warm-100">' + recipe.title + '</h2>' +
            '<p class="text-body-sm text-warm-500 line-clamp-2 dark:text-warm-400">' + recipe.description + '</p>' +
            '</div></a>' +
            '<button class="unbookmark-btn absolute right-3 top-3 rounded-full bg-white/80 p-1.5 text-red-500 transition-colors hover:bg-white dark:bg-warm-900/80 dark:text-red-400 dark:hover:bg-warm-900" data-slug="' + enSlug + '" aria-label="Retirer le signet">' +
            '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>' +
            '</button></div>';
        });

        html += '</div>';

        if (found === 0) {
          container.innerHTML = '<div class="rounded-xl border border-warm-200 bg-white p-8 text-center dark:border-warm-800 dark:bg-warm-900">' +
            '<p class="mb-4 text-body-lg text-warm-500 dark:text-warm-400">Aucune recette sauvegardée.</p>' +
            '<a href="/fr/recettes/" class="inline-block rounded-lg bg-brand-wine px-6 py-3 font-ui text-sm font-medium text-white transition-colors hover:bg-brand-wine">Parcourir les recettes</a>' +
            '</div>';
          return;
        }

        container.innerHTML = html;

        container.querySelectorAll('.unbookmark-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var slug = this.dataset.slug;
            var bm = JSON.parse(localStorage.getItem('dmd_bookmarks') || '[]');
            bm = bm.filter(function(s) { return s !== slug; });
            localStorage.setItem('dmd_bookmarks', JSON.stringify(bm));
            this.closest('.group').remove();
            if (bm.length === 0) {
              container.innerHTML = '<div class="rounded-xl border border-warm-200 bg-white p-8 text-center dark:border-warm-800 dark:bg-warm-900">' +
                '<p class="mb-4 text-body-lg text-warm-500 dark:text-warm-400">Aucune recette sauvegardée.</p>' +
                '<a href="/fr/recettes/" class="inline-block rounded-lg bg-brand-wine px-6 py-3 font-ui text-sm font-medium text-white transition-colors hover:bg-brand-wine">Parcourir les recettes</a>' +
                '</div>';
            }
          });
        });
      })
      .catch(function() {
        container.innerHTML = '<p class="text-body-base text-warm-500 dark:text-warm-400">Impossible de charger les recettes.</p>';
      });
  })();
</script>
