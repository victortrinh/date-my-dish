---
import { getCollection } from "astro:content";
import ActivityDateSpotTemplate from "@components/ActivityDateSpotTemplate.astro";
import { isPlanningSpot } from "@utils/date-spots";

// Activities and Chef-led Experiences. Restaurant and Bar reviews live under
// /fr/critiques/{neighbourhood}/{slug}/.
export async function getStaticPaths() {
  const spots = await getCollection("dateSpots");
  return spots.map(({ data }) => data).filter(isPlanningSpot).map((spot) => ({
    params: { slug: spot.locales["fr-CA"].slug }, props: { spot },
  }));
}

const { spot } = Astro.props;
---
<ActivityDateSpotTemplate spot={spot} locale="fr" />
