---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@i18n/utils";
import VerdictBadge from "./date-spots/VerdictBadge.astro";
import { copyLocale, dateSpotPath, priceLabel } from "@utils/date-spots";

interface Props {
  spot: CollectionEntry<"dateSpots">;
  locale: Locale;
  loading?: "eager" | "lazy";
}

const { spot, locale, loading = "lazy" } = Astro.props;
const copy = spot.data.locales[copyLocale(locale)];
const verdict = spot.data.reviewVerdict;
---
<article data-verdict={verdict} class:list={[
  "overflow-hidden border border-l-[5px] border-warm-200 bg-white dark:border-warm-700 dark:bg-warm-900",
  verdict === "favourite" && "border-l-brand-wine dark:border-l-brand-rose",
  verdict === "conditional" && "border-l-brand-rose",
  verdict === "pass" && "border-l-warm-400",
]}>
  <a href={dateSpotPath(spot.data, locale)} class="block no-underline">
    <img src={spot.data.image.src} alt={copy.imageAlt} width={spot.data.image.width} height={spot.data.image.height} loading={loading} class="aspect-[4/3] w-full object-cover" />
    <div class="p-6">
      <h2 class="mb-1 text-heading-3 text-warm-900 dark:text-warm-100">{spot.data.name}</h2>
      <p class="mb-3 font-ui text-body-sm text-warm-500 dark:text-warm-400">{[spot.data.neighbourhood, "cuisine" in copy ? copy.cuisine : undefined, priceLabel(spot.data.priceRange, locale)].filter(Boolean).join(" · ")}</p>
      <VerdictBadge verdict={verdict} locale={locale} qualifier={"verdictQualifier" in copy ? copy.verdictQualifier : undefined} />
      <p class="mt-3 text-warm-700 dark:text-warm-300">{"verdictHeadline" in copy ? copy.verdictHeadline : copy.opening}</p>
    </div>
  </a>
</article>
