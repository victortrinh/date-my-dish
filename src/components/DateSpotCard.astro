---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@i18n/utils";
import VerdictBadge from "./date-spots/VerdictBadge.astro";
import { copyLocale, dateSpotPath, neighbourhoodSlug, priceLabel } from "@utils/date-spots";
import { transitionStyle } from "@utils/view-transitions";

// A listing entry: the photo in the greystone window, then the facts, the
// verdict and the one-line take. One link per card, so a listing has one
// `a:has(img)` per entry. On phones the card is compact, a small arch beside
// the text; from `sm` up the full 4:5 arch sits above it. The photo and title
// share their View Transition names with the post's hero and h1.
interface Props {
  spot: CollectionEntry<"dateSpots">;
  locale: Locale;
  loading?: "eager" | "lazy";
  /** Heading level inside the listing: h2 under a page h1, h3 under a group h2. */
  headingLevel?: 2 | 3;
}

const { spot, locale, loading = "lazy", headingLevel = 2 } = Astro.props;
const copy = spot.data.locales[copyLocale(locale)];
const verdict = spot.data.reviewVerdict;
const Heading = headingLevel === 3 ? "h3" : "h2";
---
<article data-verdict={verdict} data-borough={spot.data.borough && neighbourhoodSlug(spot.data.borough)} data-reveal class="min-w-0">
  <a href={dateSpotPath(spot.data, locale)} class="group flex items-start gap-5 text-ink no-underline hover:text-ink sm:block">
    <div class="arch isolate w-28 shrink-0 bg-surface-sunken sm:w-full" style={transitionStyle(Astro.locals, "spot", spot.data.id, "photo")}>
      <img src={spot.data.image.src} alt={copy.imageAlt} width={spot.data.image.width} height={spot.data.image.height} loading={loading} class="zoom aspect-[4/5] w-full object-cover object-center" />
    </div>
    <div class="min-w-0 flex-1 sm:mt-5">
      <p class="font-ui text-body-sm text-ink-subtle">{[spot.data.neighbourhood, "cuisine" in copy ? copy.cuisine : undefined, spot.data.priceRange && priceLabel(spot.data.priceRange, locale)].filter(Boolean).join(" · ")}</p>
      <Heading class="mt-1 w-fit text-xl text-ink sm:mt-2 sm:text-heading-3" style={transitionStyle(Astro.locals, "spot", spot.data.id, "title")}><span class="link-draw">{spot.data.name}</span></Heading>
      <VerdictBadge verdict={verdict} locale={locale} qualifier={"verdictQualifier" in copy ? copy.verdictQualifier : undefined} class="mt-2 sm:mt-3" />
      <p class="mt-2 line-clamp-3 font-body text-body-sm text-ink-muted sm:mt-3 sm:line-clamp-none sm:text-base">{("verdictHeadline" in copy && copy.verdictHeadline) || copy.opening || copy.verdictReason}</p>
    </div>
  </a>
</article>
