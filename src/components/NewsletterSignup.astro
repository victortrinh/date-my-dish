---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  compact?: boolean;
  /**
   * Emit the binding script. It binds every `.newsletter-signup` on the page,
   * so only the Footer instance (always last in the DOM) carries it; extra
   * copies count against the review page JavaScript budget (validate-build).
   */
  includeScript?: boolean;
}

const { locale, compact = false, includeScript = false } = Astro.props;
---

<div
  class:list={[
    "no-print newsletter-signup",
    compact
      ? "card"
      : "",
  ]}
  data-locale={locale}
  data-compact={compact ? "true" : "false"}
>
  <div class="newsletter-content">
    <h3 class:list={[
      "mb-3 font-display text-heading-3",
      compact ? "text-ink" : "text-on-iron",
    ]}>
      {t(locale, compact ? "newsletter.compactTitle" : "newsletter.title")}
    </h3>
    <p class:list={[
      "mb-6 font-body text-body-sm",
      compact ? "text-ink-muted" : "text-on-iron-muted",
    ]}>
      {t(locale, "newsletter.description")}
    </p>

    <div class="newsletter-form-area">
      <noscript>
        <p class="text-body-sm">{t(locale, "newsletter.error")}</p>
      </noscript>
    </div>
  </div>
</div>

{includeScript && (
<script is:inline>
  document.querySelectorAll('.newsletter-signup').forEach(function(widget) {
    if (widget.dataset.bound) return;
    widget.dataset.bound = 'true';

    var locale = widget.dataset.locale;
    var isCompact = widget.dataset.compact === 'true';
    var formArea = widget.querySelector('.newsletter-form-area');
    if (!formArea) return;

    renderForm();

    function renderForm() {
      var inputClass = isCompact
        ? 'min-w-0 flex-1 rounded-full border border-line bg-surface px-5 py-3 font-ui text-body-sm text-ink placeholder:text-ink-subtle focus:border-ink'
        : 'w-full rounded-full border border-on-iron-muted/40 bg-transparent px-5 py-3 font-ui text-body-sm text-on-iron placeholder:text-on-iron-muted focus:border-on-iron';
      var btnClass = isCompact
        ? 'btn btn-primary shrink-0'
        : 'btn btn-accent mt-3 w-full hover:bg-on-iron hover:text-iron';
      var layout = isCompact ? 'flex gap-2' : 'flex flex-col';

      formArea.innerHTML =
        '<form class="newsletter-form ' + layout + '" aria-label="' +
        (locale === 'fr' ? 'Inscription à l\'infolettre' : 'Newsletter signup') + '">' +
        '<input type="email" name="email_address" required ' +
        'placeholder="' + (locale === 'fr' ? 'Votre adresse courriel' : 'Email address') + '" ' +
        'class="' + inputClass + '" />' +
        '<input type="hidden" name="fields[locale]" value="' + locale + '" />' +
        '<button type="submit" class="' + btnClass + '">' +
        (locale === 'fr' ? 'S\'abonner' : 'Join the Club') + '</button></form>' +
        '<div class="newsletter-feedback mt-2" aria-live="polite"></div>';

      var form = formArea.querySelector('.newsletter-form');
      var feedback = formArea.querySelector('.newsletter-feedback');

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = form.querySelector('input[type="email"]').value;
        if (!email) return;

        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = '...';

        // POST to ConvertKit form endpoint
        fetch('https://app.convertkit.com/forms/9162657/subscriptions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email_address: email,
            fields: { locale: locale }
          })
        })
          .then(function(r) {
            if (r.ok || r.status === 200) {
              formArea.innerHTML = '<p class="font-ui text-body-sm font-medium">' +
                (locale === 'fr' ? 'Vous êtes abonné ! Vérifiez votre courriel pour confirmer.' : 'You\'re subscribed! Check your email to confirm.') + '</p>';
            } else {
              throw new Error('Failed');
            }
          })
          .catch(function() {
            feedback.innerHTML = '<p class="font-ui text-body-sm font-medium" role="alert">' +
              (locale === 'fr' ? 'Une erreur est survenue. Veuillez réessayer.' : 'Something went wrong. Please try again.') + '</p>';
            btn.disabled = false;
            btn.textContent = locale === 'fr' ? 'S\'abonner' : 'Subscribe';
          });
      });
    }
  });
</script>
)}
