---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
---

<div
  class:list={[
    "no-print newsletter-signup",
    compact
      ? "rounded-xl border border-warm-200 bg-white p-6 dark:border-warm-800 dark:bg-warm-900"
      : "",
  ]}
  data-locale={locale}
  data-compact={compact ? "true" : "false"}
>
  <div class="newsletter-content">
    <h3 class:list={[
      "mb-2 font-heading font-normal",
      compact ? "text-lg text-warm-900 dark:text-warm-100" : "text-xl text-warm-100",
    ]}>
      {t(locale, compact ? "newsletter.compactTitle" as any : "newsletter.title")}
    </h3>
    <p class:list={[
      "mb-4 text-body-sm",
      compact ? "text-warm-600 dark:text-warm-400" : "text-warm-300",
    ]}>
      {t(locale, "newsletter.description")}
    </p>

    <div class="newsletter-form-area">
      <noscript>
        <p class="text-body-sm text-warm-500">{t(locale, "newsletter.error")}</p>
      </noscript>
    </div>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('.newsletter-signup').forEach(function(widget) {
    if (widget.dataset.bound) return;
    widget.dataset.bound = 'true';

    var locale = widget.dataset.locale;
    var isCompact = widget.dataset.compact === 'true';
    var formArea = widget.querySelector('.newsletter-form-area');
    if (!formArea) return;

    renderForm();

    function renderForm() {
      var inputClass = isCompact
        ? 'flex-1 rounded-lg border border-warm-300 bg-white px-4 py-2.5 font-body text-body-sm text-warm-900 placeholder-warm-400 transition-colors focus:border-brand-wine focus:outline-none focus:ring-2 focus:ring-brand-wine/20 dark:border-warm-600 dark:bg-warm-800 dark:text-warm-100 dark:placeholder-warm-500'
        : 'w-full rounded-lg border border-warm-500 bg-warm-700 px-4 py-2.5 font-body text-body-sm text-warm-100 placeholder-warm-400 transition-colors focus:border-brand-wine-dark focus:outline-none focus:ring-2 focus:ring-brand-wine-dark/20';
      var btnClass = isCompact
        ? 'shrink-0 rounded-lg bg-brand-wine px-5 py-2.5 font-ui text-body-sm font-medium text-white transition-colors hover:bg-brand-wine'
        : 'mt-3 w-full rounded-full bg-brand-rose px-5 py-2.5 font-ui text-body-sm font-bold text-warm-800 transition-colors hover:bg-brand-rose/80';
      var layout = isCompact ? 'flex gap-2' : 'flex flex-col';

      formArea.innerHTML =
        '<form class="newsletter-form ' + layout + '" aria-label="' +
        (locale === 'fr' ? 'Inscription à l\'infolettre' : 'Newsletter signup') + '">' +
        '<input type="email" name="email_address" required ' +
        'placeholder="' + (locale === 'fr' ? 'Votre adresse courriel' : 'Email address') + '" ' +
        'class="' + inputClass + '" />' +
        '<input type="hidden" name="fields[locale]" value="' + locale + '" />' +
        '<button type="submit" class="' + btnClass + '">' +
        (locale === 'fr' ? 'S\'abonner' : 'Join the Club') + '</button></form>' +
        '<div class="newsletter-feedback mt-2" aria-live="polite"></div>';

      var form = formArea.querySelector('.newsletter-form');
      var feedback = formArea.querySelector('.newsletter-feedback');

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = form.querySelector('input[type="email"]').value;
        if (!email) return;

        var btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = '...';

        // POST to ConvertKit form endpoint
        fetch('https://app.convertkit.com/forms/9162657/subscriptions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email_address: email,
            fields: { locale: locale }
          })
        })
          .then(function(r) {
            if (r.ok || r.status === 200) {
              formArea.innerHTML = '<p class="text-body-sm font-medium text-green-600 dark:text-green-400">' +
                (locale === 'fr' ? 'Vous êtes abonné ! Vérifiez votre courriel pour confirmer.' : 'You\'re subscribed! Check your email to confirm.') + '</p>';
            } else {
              throw new Error('Failed');
            }
          })
          .catch(function() {
            feedback.innerHTML = '<p class="text-body-sm text-red-600 dark:text-red-400">' +
              (locale === 'fr' ? 'Une erreur est survenue. Veuillez réessayer.' : 'Something went wrong. Please try again.') + '</p>';
            btn.disabled = false;
            btn.textContent = locale === 'fr' ? 'S\'abonner' : 'Subscribe';
          });
      });
    }
  });
</script>
