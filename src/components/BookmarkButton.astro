---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  enSlug: string;
}

const { locale, enSlug } = Astro.props;
---

<button
  class="bookmark-btn no-print inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 px-4 py-3 font-ui text-body-sm font-medium text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-red-500 dark:border-neutral-600 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-red-400"
  data-en-slug={enSlug}
  aria-pressed="false"
  aria-label={t(locale, "bookmark.save")}
>
  <svg xmlns="http://www.w3.org/2000/svg" class="bookmark-icon h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
  </svg>
  <span class="bookmark-text">{t(locale, "bookmark.save")}</span>
</button>

<div class="bookmark-feedback sr-only" aria-live="polite"></div>

<script is:inline>
  document.querySelectorAll('.bookmark-btn').forEach(function(btn) {
    if (btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    var enSlug = btn.dataset.enSlug;
    var icon = btn.querySelector('.bookmark-icon');
    var text = btn.querySelector('.bookmark-text');
    var feedback = btn.nextElementSibling;
    var lang = document.documentElement.lang;

    var saveLabel = lang === 'fr' ? 'Sauvegarder la recette' : 'Save recipe';
    var savedLabel = lang === 'fr' ? 'Recette sauvegardée' : 'Recipe saved';

    function getBookmarks() {
      try {
        return JSON.parse(localStorage.getItem('dmd_bookmarks') || '[]');
      } catch { return []; }
    }

    function setBookmarks(arr) {
      localStorage.setItem('dmd_bookmarks', JSON.stringify(arr));
    }

    function isSaved() {
      return getBookmarks().indexOf(enSlug) !== -1;
    }

    function updateUI(saved) {
      btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      btn.setAttribute('aria-label', saved ? savedLabel : saveLabel);
      text.textContent = saved ? savedLabel : saveLabel;
      if (saved) {
        icon.setAttribute('fill', 'currentColor');
        btn.classList.add('text-red-500', 'dark:text-red-400', 'border-red-200', 'dark:border-red-800');
        btn.classList.remove('text-neutral-500', 'dark:text-neutral-400', 'border-neutral-200', 'dark:border-neutral-600');
      } else {
        icon.setAttribute('fill', 'none');
        btn.classList.remove('text-red-500', 'dark:text-red-400', 'border-red-200', 'dark:border-red-800');
        btn.classList.add('text-neutral-500', 'dark:text-neutral-400', 'border-neutral-200', 'dark:border-neutral-600');
      }
    }

    // Init state
    updateUI(isSaved());

    btn.addEventListener('click', function() {
      var bookmarks = getBookmarks();
      var idx = bookmarks.indexOf(enSlug);
      if (idx !== -1) {
        bookmarks.splice(idx, 1);
        setBookmarks(bookmarks);
        updateUI(false);
        if (feedback) feedback.textContent = lang === 'fr' ? 'Recette retirée des signets' : 'Recipe removed from bookmarks';
      } else {
        bookmarks.unshift(enSlug);
        setBookmarks(bookmarks);
        updateUI(true);
        if (feedback) feedback.textContent = lang === 'fr' ? 'Recette ajoutée aux signets' : 'Recipe added to bookmarks';
      }
    });
  });
</script>
