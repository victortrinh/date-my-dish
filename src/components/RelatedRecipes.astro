---
import { getCollection } from "astro:content";
import RecipeCard from "./RecipeCard.astro";
import { t, type Locale } from "@i18n/utils";
import type { ImageMetadata } from "astro";

interface Props {
  locale: Locale;
  currentSlug: string;
  categories: string[];
  limit?: number;
}

const { locale, currentSlug, categories, limit = 3 } = Astro.props;

const allRecipes = await getCollection("recipes");
const related = allRecipes
  .filter((recipe) => {
    if (recipe.data.lang !== locale) return false;
    const recipeSlug = recipe.id.replace(/^(en|fr)\//, "");
    if (recipeSlug === currentSlug) return false;
    return recipe.data.recipeCategory.some((cat: string) => categories.includes(cat));
  })
  .slice(0, limit);
---

{related.length > 0 && (
  <section class="no-print mt-12 mb-8">
    <h2 class="mb-6 font-heading text-2xl font-bold text-neutral-900 dark:text-neutral-100">
      {t(locale, "recipe.relatedRecipes")}
    </h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((recipe) => {
        const slug = recipe.id.replace(/^(en|fr)\//, "");
        return (
          <RecipeCard
            title={recipe.data.title}
            description={recipe.data.description}
            slug={slug}
            locale={locale}
            heroImage={recipe.data.heroImage as ImageMetadata}
            heroImageAlt={recipe.data.heroImageAlt}
            prepTime={recipe.data.prepTime}
            totalTime={recipe.data.totalTime}
            difficulty={recipe.data.difficulty}
            headingLevel="h3"
          />
        );
      })}
    </div>
  </section>
)}
