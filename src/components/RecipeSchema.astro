---
import type { Locale } from "@i18n/utils";
import { getRecipeLocalizedPath } from "@i18n/utils";
import type { ImageMetadata } from "astro";
import { SITE_URL } from "@utils/constants";

interface HowToStep {
  text: string;
  image?: ImageMetadata;
}

interface IngredientGroup {
  group?: string;
  items: string[];
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Nutrition {
  calories?: string;
  fatContent?: string;
  carbohydrateContent?: string;
  proteinContent?: string;
}

interface FAQ {
  question: string;
  answer: string;
}

interface RatingInfo {
  averageRating: number;
  ratingCount: number;
}

interface VideoInfo {
  name: string;
  description: string;
  thumbnailUrl: string;
  contentUrl: string;
  uploadDate: Date;
  duration: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  lang: Locale;
  author: string;
  publishDate: Date;
  updatedDate?: Date;
  heroImageUrl: string;
  prepTime: string;
  cookTime: string;
  totalTime: string;
  recipeYield: string;
  recipeCategory: string[];
  recipeCuisine: string;
  keywords: string[];
  ingredientGroups: IngredientGroup[];
  instructionGroups: InstructionGroup[];
  nutrition?: Nutrition;
  faqs: FAQ[];
  ratingData?: RatingInfo;
  video?: VideoInfo;
}

const {
  title,
  description,
  slug,
  lang,
  author,
  publishDate,
  updatedDate,
  heroImageUrl,
  prepTime,
  cookTime,
  totalTime,
  recipeYield,
  recipeCategory,
  recipeCuisine,
  keywords,
  ingredientGroups,
  instructionGroups,
  nutrition,
  faqs,
  ratingData,
  video,
} = Astro.props;

const recipePath = getRecipeLocalizedPath(lang, slug);
const canonicalUrl = `${SITE_URL}${recipePath}`;

// Flatten ingredients for JSON-LD
const allIngredients = ingredientGroups.flatMap((g) => g.items);

// Build HowToStep/HowToSection for JSON-LD
const instructionSections = instructionGroups.map((group) => {
  const steps = group.steps.map((step, i) => ({
    "@type": "HowToStep" as const,
    text: step.text,
    position: i + 1,
    ...(() => {
      const imgs = [
        ...(step.image ? [step.image] : []),
        ...(step.images || []),
      ].map((img) => img.src.startsWith("http") ? img.src : `${SITE_URL}${img.src}`);
      return imgs.length > 0 ? { image: imgs.length === 1 ? imgs[0] : imgs } : {};
    })(),
  }));

  if (group.group) {
    return {
      "@type": "HowToSection" as const,
      name: group.group,
      itemListElement: steps,
    };
  }
  return steps;
}).flat();

// Recipe JSON-LD
const recipeJsonLd = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: title,
  description,
  author: {
    "@type": "Person",
    name: author,
    url: `${SITE_URL}/${lang}/${lang === "fr" ? "a-propos" : "about"}/`,
  },
  datePublished: publishDate.toISOString().split("T")[0],
  ...(updatedDate ? { dateModified: updatedDate.toISOString().split("T")[0] } : {}),
  image: [heroImageUrl.startsWith("http") ? heroImageUrl : `${SITE_URL}${heroImageUrl}`],
  prepTime,
  cookTime,
  totalTime,
  recipeYield,
  recipeCategory,
  recipeCuisine,
  keywords: keywords.join(", "),
  recipeIngredient: allIngredients,
  recipeInstructions: instructionSections,
  ...(nutrition
    ? {
        nutrition: {
          "@type": "NutritionInformation",
          ...(nutrition.calories ? { calories: nutrition.calories } : {}),
          ...(nutrition.fatContent ? { fatContent: nutrition.fatContent } : {}),
          ...(nutrition.carbohydrateContent ? { carbohydrateContent: nutrition.carbohydrateContent } : {}),
          ...(nutrition.proteinContent ? { proteinContent: nutrition.proteinContent } : {}),
        },
      }
    : {}),
  ...(ratingData && ratingData.ratingCount > 0
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: ratingData.averageRating,
          ratingCount: ratingData.ratingCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
  ...(video
    ? {
        video: {
          "@type": "VideoObject",
          name: video.name,
          description: video.description,
          thumbnailUrl: video.thumbnailUrl,
          contentUrl: video.contentUrl,
          uploadDate: video.uploadDate.toISOString().split("T")[0],
          duration: video.duration,
        },
      }
    : {}),
  url: canonicalUrl,
  inLanguage: lang,
};

// FAQ JSON-LD (only if FAQs exist)
const faqJsonLd = faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    }
  : null;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(recipeJsonLd)} />
{faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
