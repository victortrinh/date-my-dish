---
import type { CollectionEntry } from "astro:content";
import { SITE_URL } from "@utils/constants";
import { getReviewLocalizedPath, type Locale } from "@i18n/utils";

interface Props { spot: CollectionEntry<"dateSpots">; locale: Locale; }
const { spot, locale } = Astro.props;
const copy = spot.data.locales[locale === "fr" ? "fr-CA" : "en"];
const pageUrl = `${SITE_URL}${getReviewLocalizedPath(locale, copy.slug)}`;
const imageUrl = `${SITE_URL}${spot.data.image.src}`;
// This mirrors only visible facts. Qualitative verdicts never become Rating markup.
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "Restaurant", "@id": `${pageUrl}#restaurant`, name: spot.data.name,
    address: { "@type": "PostalAddress", streetAddress: copy.essentials.address, addressLocality: spot.data.city, addressCountry: "CA" },
    servesCuisine: copy.cuisine, hasMap: spot.data.mapUrl, image: imageUrl },
  { "@type": "Article", "@id": `${pageUrl}#article`, headline: copy.title, description: copy.metaDescription, image: imageUrl,
    datePublished: spot.data.freshness.published, dateModified: spot.data.freshness.lastChecked, inLanguage: locale === "fr" ? "fr-CA" : "en-CA",
    mainEntityOfPage: pageUrl, about: { "@id": `${pageUrl}#restaurant` }, author: { "@type": "Person", name: spot.data.reporterByline },
    publisher: { "@type": "Organization", name: "Date My Dish", url: SITE_URL } }
] };
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
