---
import { t, type Locale } from "@i18n/utils";

interface Nutrition {
  calories?: string;
  fatContent?: string;
  carbohydrateContent?: string;
  proteinContent?: string;
}

interface Props {
  locale: Locale;
  nutrition: Nutrition;
  compact?: boolean;
}

const { locale, nutrition, compact = false } = Astro.props;
const hasData = nutrition.calories || nutrition.fatContent || nutrition.carbohydrateContent || nutrition.proteinContent;
---

{hasData && (
  <section class:list={[
    "rounded-xl border border-gray-200 dark:border-neutral-700",
    compact ? "p-4" : "p-6",
  ]}>
    <h2 class:list={[
      "font-heading font-bold text-gray-900 dark:text-neutral-100",
      compact ? "mb-3 text-base" : "mb-4 text-xl",
    ]}>
      {t(locale, "recipe.nutrition")}
      <span class:list={[
        "ml-2 font-normal text-gray-500 dark:text-neutral-400",
        compact ? "text-xs" : "text-sm",
      ]}>({t(locale, "recipe.perServing")})</span>
    </h2>
    <div class:list={[
      "nutrition-grid grid gap-4",
      compact ? "grid-cols-2" : "grid-cols-2 sm:grid-cols-4",
    ]}>
      {nutrition.calories && (
        <div class="text-center">
          <p class:list={[
            "font-bold text-brand-primary-text",
            compact ? "text-lg" : "text-2xl",
          ]}>{nutrition.calories}</p>
          <p class:list={[
            "text-gray-500 dark:text-neutral-400",
            compact ? "text-xs" : "text-sm",
          ]}>{t(locale, "recipe.calories")}</p>
        </div>
      )}
      {nutrition.fatContent && (
        <div class="text-center">
          <p class:list={[
            "font-bold text-brand-primary-text",
            compact ? "text-lg" : "text-2xl",
          ]}>{nutrition.fatContent}</p>
          <p class:list={[
            "text-gray-500 dark:text-neutral-400",
            compact ? "text-xs" : "text-sm",
          ]}>{t(locale, "recipe.fat")}</p>
        </div>
      )}
      {nutrition.carbohydrateContent && (
        <div class="text-center">
          <p class:list={[
            "font-bold text-brand-primary-text",
            compact ? "text-lg" : "text-2xl",
          ]}>{nutrition.carbohydrateContent}</p>
          <p class:list={[
            "text-gray-500 dark:text-neutral-400",
            compact ? "text-xs" : "text-sm",
          ]}>{t(locale, "recipe.carbs")}</p>
        </div>
      )}
      {nutrition.proteinContent && (
        <div class="text-center">
          <p class:list={[
            "font-bold text-brand-primary-text",
            compact ? "text-lg" : "text-2xl",
          ]}>{nutrition.proteinContent}</p>
          <p class:list={[
            "text-gray-500 dark:text-neutral-400",
            compact ? "text-xs" : "text-sm",
          ]}>{t(locale, "recipe.protein")}</p>
        </div>
      )}
    </div>
  </section>
)}
