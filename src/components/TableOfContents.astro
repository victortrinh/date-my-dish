---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav id="toc" class="no-print mb-8 rounded-xl border border-gray-200 bg-white p-5 dark:border-neutral-700 dark:bg-neutral-900/80" aria-label={t(locale, "toc.title")}>
  <h2 class="mb-3 font-heading text-base font-bold text-gray-900 dark:text-neutral-100">
    {t(locale, "toc.title")}
  </h2>
  <ol id="toc-list" class="space-y-1.5 text-body-sm"></ol>
</nav>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var toc = document.getElementById('toc');
  var tocList = document.getElementById('toc-list');
  var prose = document.querySelector('.prose');
  if (!toc || !tocList || !prose) return;

  // Extract headings
  var headings = prose.querySelectorAll('h2, h3');
  if (headings.length < 3) {
    toc.style.display = 'none';
    return;
  }

  // Build TOC
  var items = [];
  headings.forEach(function(h, i) {
    // Generate ID if missing
    if (!h.id) {
      h.id = 'heading-' + i + '-' + h.textContent.trim().toLowerCase()
        .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
    var li = document.createElement('li');
    var a = document.createElement('a');
    a.href = '#' + h.id;
    a.textContent = h.textContent;
    a.className = 'block rounded px-2 py-1 text-gray-600 no-underline transition-colors hover:text-brand-primary dark:text-neutral-400 dark:hover:text-brand-primary';
    if (h.tagName === 'H3') {
      li.className = 'pl-4';
      a.className += ' text-gray-500 dark:text-neutral-500';
    }
    li.appendChild(a);
    tocList.appendChild(li);
    items.push({ el: h, link: a });
  });

  // Scroll spy
  if ('IntersectionObserver' in window) {
    var activeLink = null;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var item = items.find(function(it) { return it.el === entry.target; });
          if (item) {
            if (activeLink) {
              activeLink.classList.remove('text-brand-primary-text', 'font-medium', 'dark:text-brand-primary');
            }
            item.link.classList.add('text-brand-primary-text', 'font-medium', 'dark:text-brand-primary');
            activeLink = item.link;
          }
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    items.forEach(function(item) { observer.observe(item.el); });
  }
});
</script>
