---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  title: string;
  url: string;
}

const { locale, title, url } = Astro.props;
---

<button
  class="no-print share-btn inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-neutral-600 px-5 py-3 font-ui text-sm font-medium text-gray-600 dark:text-neutral-400 transition-colors hover:bg-gray-200 dark:hover:bg-neutral-800"
  data-title={title}
  data-url={url}
  data-copied-text={t(locale, "recipe.copied")}
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
  </svg>
  <span class="share-label" aria-live="polite">{t(locale, "recipe.share")}</span>
</button>

<script is:inline>
  document.querySelectorAll('.share-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var title = this.dataset.title;
      var url = this.dataset.url;
      var copiedText = this.dataset.copiedText;
      var label = this.querySelector('.share-label');

      if (navigator.share) {
        try {
          await navigator.share({ title: title, url: url });
        } catch (e) {
          // User cancelled share
        }
      } else if (navigator.clipboard) {
        await navigator.clipboard.writeText(url);
        var original = label.textContent;
        label.textContent = copiedText;
        setTimeout(function() { label.textContent = original; }, 2000);
      }
    });
  });
</script>
