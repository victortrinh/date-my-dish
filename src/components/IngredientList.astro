---
import { t, type Locale } from "@i18n/utils";

interface IngredientGroup {
  group?: string;
  items: string[];
}

interface Props {
  locale: Locale;
  ingredientGroups: IngredientGroup[];
  idPrefix?: string;
}

const { locale, ingredientGroups, idPrefix = "ing" } = Astro.props;
---

<section>
  <h2 class="mb-4 font-heading text-heading-3 font-bold text-gray-900 dark:text-gray-100">
    {t(locale, "recipe.ingredients")}
  </h2>
  {ingredientGroups.map((group, gi) => (
    <div class="mb-4 last:mb-0">
      {group.group && (
        <h3 class="mb-2 font-heading text-base font-semibold text-gray-700 dark:text-gray-300">{group.group}</h3>
      )}
      <ul class="space-y-2">
        {group.items.map((item, i) => (
          <li class="flex items-start gap-3">
            <input
              type="checkbox"
              id={`${idPrefix}-${gi}-${i}`}
              class="peer mt-1 h-4 w-4 shrink-0 cursor-pointer rounded border-gray-400 text-brand-accent accent-brand-accent"
            />
            <label
              for={`${idPrefix}-${gi}-${i}`}
              class="cursor-pointer text-body-sm text-gray-700 peer-checked:text-gray-400 peer-checked:line-through dark:text-gray-300 dark:peer-checked:text-gray-500"
            >
              {item}
            </label>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
