---
import { t, type Locale } from "@i18n/utils";

interface IngredientGroup {
  group?: string;
  items: string[];
}

interface Props {
  locale: Locale;
  ingredientGroups: IngredientGroup[];
  idPrefix?: string;
  recipeYield?: string;
}

const { locale, ingredientGroups, idPrefix = "ing", recipeYield } = Astro.props;
---

<section class="ingredient-list-section">
  <div class="mb-4">
    <h2 class="font-heading text-heading-3 font-bold text-neutral-900 dark:text-neutral-100">
      {t(locale, "recipe.ingredients")}
    </h2>
  </div>

  {recipeYield && (
    <p class="mb-3 text-body-sm text-neutral-500 dark:text-neutral-400">
      {recipeYield}
    </p>
  )}

  {ingredientGroups.map((group, gi) => (
    <div class="mb-4 last:mb-0">
      {group.group && (
        <h3 class="mb-2 font-heading text-base font-semibold text-neutral-700 dark:text-neutral-300">{group.group}</h3>
      )}
      <ul class="space-y-2">
        {group.items.map((item, i) => (
          <li class="flex items-start gap-3">
            <input
              type="checkbox"
              id={`${idPrefix}-${gi}-${i}`}
              class="peer mt-1 h-4 w-4 shrink-0 cursor-pointer rounded border-neutral-400 text-brand-accent accent-brand-accent"
            />
            <label
              for={`${idPrefix}-${gi}-${i}`}
              class="cursor-pointer text-body-sm text-neutral-700 peer-checked:text-neutral-400 peer-checked:line-through dark:text-neutral-300 dark:peer-checked:text-neutral-500"
            >
              {item}
            </label>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
