---
import { getCollection } from "astro:content";
import DateSpotLayout from "@layouts/DateSpotLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import DateSpotSchema from "./DateSpotSchema.astro";
import EssentialsCard from "./date-spots/EssentialsCard.astro";
import Paragraphs from "./date-spots/Paragraphs.astro";
import SignalIcon from "./date-spots/SignalIcon.astro";
import VerdictBadge from "./date-spots/VerdictBadge.astro";
import { t, tf, type Locale } from "@i18n/utils";
import {
  DATE_SPOT_CATEGORIES, categoryPath, copyLocale, dateSpotPath, neighbourhoodPath, planningPath, priceLabel,
  sameCategoryNearby, spotCategory, type PlanningSpot,
} from "@utils/date-spots";

// The planning page for Activities and Chef-led Experiences: when it works,
// what it is, how to do it well, and "Pair it with", which sends the reader
// back into the reviews. Review to spot to review.
interface Props { spot: PlanningSpot; locale: Locale; }
const { spot, locale } = Astro.props;
const copy = spot.locales[copyLocale(locale)];
const other: Locale = locale === "fr" ? "en" : "fr";
const category = spot.category;
const spots = await getCollection("dateSpots");
const pairings = (copy.pairItWith ?? []).flatMap((pairing) => {
  const target = spots.find(({ data }) => data.id === pairing.spotId)?.data;
  return target ? [{ target, walkMinutes: pairing.walkMinutes }] : [];
});
const moreInCategory = sameCategoryNearby(spots, spot).slice(0, 3).map(({ data }) => data);
const categoriesWithContent = DATE_SPOT_CATEGORIES.filter((key) => spots.some(({ data }) => spotCategory(data) === key));
const monthYear = (value: string) => new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long" }).format(new Date(`${value}T12:00:00`));
const fullDate = (value: string) => new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long", day: "numeric" }).format(new Date(`${value}T12:00:00`));
const categoryLabel = t(locale, `dateSpot.category.${category}`);
const h2 = "scroll-mt-20 font-heading text-heading-2 text-warm-900 dark:text-warm-100";
const body = "font-body text-body-lg text-warm-700 dark:text-warm-300";
const kicker = "font-ui text-caption font-bold uppercase tracking-wider text-brand-wine-text dark:text-brand-rose";
const small = "font-ui text-caption font-bold uppercase tracking-wider text-warm-500 dark:text-warm-400";
---
<DateSpotLayout title={copy.metaTitle} description={copy.metaDescription} locale={locale} canonical={planningPath(spot, locale)} alternatePath={planningPath(spot, other)} ogImage={spot.image.src} published={spot.freshness.published} lastChecked={spot.freshness.lastChecked}>
  <DateSpotSchema slot="head" title={copy.title} description={copy.metaDescription} slug={copy.slug} locale={locale} name={spot.name} city={spot.city} neighbourhood={spot.neighbourhood} image={spot.image.src} imageAlt={copy.imageAlt} mapUrl={spot.mapUrl} published={spot.freshness.published} lastChecked={spot.freshness.lastChecked} host={"host" in spot ? spot.host : undefined} />

  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`} data-spot-type={spot.spotType}>
    <Breadcrumbs locale={locale} items={[
      { label: t(locale, "nav.dateSpots"), href: locale === "fr" ? "/fr/lieux/" : "/en/date-spots/" },
      { label: categoryLabel, href: categoryPath(category, locale) },
      { label: spot.neighbourhood, href: neighbourhoodPath(spot.neighbourhood, locale) },
      { label: spot.name },
    ]} />

    <div class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0 space-y-14">
        <header>
          <p class={kicker}>{categoryLabel}{spot.spotType === "chef-led-experience" && ` · ${t(locale, "dateSpot.spotType.chef-led-experience")}`}</p>
          <h1 class="mt-3 font-heading text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">{copy.title}</h1>
          <p class="mt-5 max-w-prose font-body text-body-lg text-warm-700 dark:text-warm-300">{copy.opening}</p>
          {"host" in spot && <p class="mt-3 font-ui font-semibold text-warm-800 dark:text-warm-200">{tf(locale, "dateSpot.hostedBy", { name: spot.host.name })}</p>}
          <p class="mt-4 font-ui text-body-sm text-warm-500 dark:text-warm-400">
            {t(locale, "dateSpot.by")} {spot.reporterByline} · {t(locale, "dateSpot.visited")} {fullDate(spot.freshness.visited)} · {tf(locale, "dateSpot.published", { date: fullDate(spot.freshness.published) })} · {tf(locale, "dateSpot.checked", { date: monthYear(spot.freshness.lastChecked) })}
          </p>
          <figure class="mt-8">
            <img src={spot.image.src} width={spot.image.width} height={spot.image.height} alt={copy.imageAlt} class="max-h-[460px] w-full rounded-2xl object-cover" loading="eager" fetchpriority="high" />
            <figcaption class="mt-2 font-ui text-caption text-warm-500 dark:text-warm-400">{copy.imageCaption ?? copy.imageCredit}</figcaption>
          </figure>
        </header>

        <section aria-labelledby="works-title">
          <h2 id="works-title" class={h2}>{t(locale, "dateSpot.h.whenItWorks")}</h2>
          <ul class="mt-5 divide-y divide-warm-200 border-y border-warm-200 dark:divide-warm-700 dark:border-warm-700">
            {copy.whenItWorks.map((row) => (
              <li class="flex gap-4 py-4">
                <SignalIcon assessment={row.assessment} />
                <div class="min-w-0 flex-1 sm:flex sm:gap-4">
                <div class="font-ui sm:w-44 sm:shrink-0">
                  <p class="font-semibold text-warm-900 dark:text-warm-100">{row.situation}</p>
                  <p class="text-body-sm font-semibold text-brand-wine-text dark:text-brand-rose">{t(locale, `dateSpot.assessment.${row.assessment}`)}</p>
                </div>
                <p class="mt-1 font-body text-warm-700 dark:text-warm-300 sm:mt-0">{row.reason}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="is-title">
          <h2 id="is-title" class={h2}>{t(locale, "dateSpot.h.whatItIs")}</h2>
          <div class={`mt-4 space-y-4 ${body}`}><Paragraphs text={copy.whatItIs} /></div>
        </section>

        <section aria-labelledby="well-title">
          <h2 id="well-title" class={h2}>{t(locale, "dateSpot.h.howToDoItWell")}</h2>
          <dl class="mt-5 divide-y divide-warm-200 border-y border-warm-200 dark:divide-warm-700 dark:border-warm-700">
            {copy.howToDoItWell.map((tip) => <div class="grid gap-2 py-4 sm:grid-cols-[10rem_minmax(0,1fr)]"><dt class="font-ui font-semibold text-warm-900 dark:text-warm-100">{tip.label}</dt><dd class="font-body text-warm-700 dark:text-warm-300">{tip.text}</dd></div>)}
          </dl>
        </section>

        {pairings.length > 0 && <section aria-labelledby="pair-title">
          <p class={kicker}>{t(locale, "dateSpot.pairKicker")}</p>
          <h2 id="pair-title" class={`mt-2 ${h2}`}>{t(locale, "dateSpot.h.pairItWith")}</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {pairings.map(({ target, walkMinutes }) => {
              const targetCopy = target.locales[copyLocale(locale)];
              return (
                <a href={dateSpotPath(target, locale)} class="block border border-warm-200 no-underline dark:border-warm-700">
                  <img src={target.image.src} width={target.image.width} height={target.image.height} alt={targetCopy.imageAlt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                  <div class="p-4">
                    <h3 class="font-heading text-lg text-warm-900 dark:text-warm-100">{target.name}</h3>
                    <p class="mt-1 font-ui text-body-sm text-warm-500 dark:text-warm-400">{["cuisine" in targetCopy ? targetCopy.cuisine : t(locale, `dateSpot.spotType.${target.spotType}`), tf(locale, "dateSpot.minutes", { minutes: walkMinutes }), priceLabel(target.priceRange, locale)].join(" · ")}</p>
                    <p class="mt-3"><VerdictBadge verdict={target.reviewVerdict} locale={locale} /></p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>}

        {copy.materialUpdates.length > 0 && <section class="space-y-4">
          {copy.materialUpdates.map((update) => (
            <div class="border-l-4 border-brand-wine pl-5 dark:border-brand-rose">
              <p class={kicker}>{t(locale, "dateSpot.update")} · <time datetime={update.date}>{monthYear(update.date)}</time></p>
              <p class={`mt-2 ${body}`}>{update.note}</p>
            </div>
          ))}
        </section>}
      </div>

      <aside class="min-w-0 space-y-8 lg:sticky lg:top-24 lg:self-start">
        <EssentialsCard spot={spot} locale={locale} />
        <nav aria-labelledby="ideas-title">
          <p id="ideas-title" class={small}>{t(locale, "dateSpot.ideasByType")}</p>
          <ul class="mt-3 space-y-1.5 font-ui text-body-sm">
            {categoriesWithContent.map((key) => <li><a href={categoryPath(key, locale)} aria-current={key === category ? "page" : undefined} class:list={["no-underline", key === category ? "font-semibold text-brand-wine-text dark:text-brand-rose" : "text-warm-700 dark:text-warm-300"]}>{t(locale, `dateSpot.category.${key}`)}</a></li>)}
          </ul>
        </nav>
        {moreInCategory.length > 0 && <div>
          <p class={small}>{tf(locale, "dateSpot.moreCategory", { category: categoryLabel })}</p>
          <ul class="mt-3 space-y-2 font-ui text-body-sm">
            {moreInCategory.map((item) => <li class="flex justify-between gap-3"><a href={dateSpotPath(item, locale)} class="text-warm-800 dark:text-warm-200">{item.name}</a><span class="text-warm-500 dark:text-warm-400">{item.neighbourhood}</span></li>)}
          </ul>
        </div>}
        <NewsletterSignup locale={locale} compact />
      </aside>
    </div>
  </article>
</DateSpotLayout>
