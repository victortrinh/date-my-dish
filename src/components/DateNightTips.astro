---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  tips: {
    wine?: string;
    music?: string;
    platingTip?: string;
  };
}

const { locale, tips } = Astro.props;
const hasTips = tips.wine || tips.music || tips.platingTip;
---

{hasTips && (
  <section class="no-print mt-8 rounded-2xl border border-brand-rose/30 bg-warm-50 dark:bg-warm-800/50 p-6 sm:p-8">
    <h2 class="mb-5 flex items-center gap-2 font-heading text-xl font-bold text-warm-900 dark:text-warm-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-rose" viewBox="0 0 24 24" fill="currentColor">
        <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
      </svg>
      {t(locale, "dateNight.tips")}
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tips.wine && (
        <div class="flex gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-wine" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-wine-text">{t(locale, "dateNight.wine")}</p>
            <p class="mt-1 text-sm text-warm-700 dark:text-warm-300">{tips.wine}</p>
          </div>
        </div>
      )}
      {tips.music && (
        <div class="flex gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-wine" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
          </svg>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-wine-text">{t(locale, "dateNight.music")}</p>
            <p class="mt-1 text-sm text-warm-700 dark:text-warm-300">{tips.music}</p>
          </div>
        </div>
      )}
      {tips.platingTip && (
        <div class="flex gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-brand-wine" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
          </svg>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-wine-text">{t(locale, "dateNight.platingTip")}</p>
            <p class="mt-1 text-sm text-warm-700 dark:text-warm-300">{tips.platingTip}</p>
          </div>
        </div>
      )}
    </div>
  </section>
)}
