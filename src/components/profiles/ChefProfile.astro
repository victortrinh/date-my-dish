---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import Paragraphs from "@components/date-spots/Paragraphs.astro";
import SpotHero from "@components/date-spots/SpotHero.astro";
import { t, tf, type Locale } from "@i18n/utils";
import { copyLocale, dateSpotPath, profilePath, recipeCardPath } from "@utils/date-spots";
import { SITE_URL } from "@utils/constants";
import { transitionStyle } from "@utils/view-transitions";

// Round one is their restaurant or bar. Round two is the same eight
// questions asked of everyone, so answers compare across profiles and each
// card lifts out on its own. The last question is the hinge: what they would
// make for a date night at home, which becomes the recipe card.
interface Props { profile: CollectionEntry<"extendedProfiles">["data"]; locale: Locale; }
const { profile, locale } = Astro.props;
const copy = profile.locales[copyLocale(locale)];
const other: Locale = locale === "fr" ? "en" : "fr";
const { subject } = profile;
const isBartender = subject.role === "bartender";
const spots = await getCollection("dateSpots");
const recipes = await getCollection("contributorRecipes");
const profiles = await getCollection("extendedProfiles");
const companion = spots.find(({ data }) => data.id === profile.companionDateSpot)?.data;
const recipe = copy.contributorRecipe ? recipes.find(({ data }) => data.id === copy.contributorRecipe)?.data : undefined;
const recipeCopy = recipe?.locales[copyLocale(locale)];
const moreChefs = profiles.filter(({ data }) => data.id !== profile.id).slice(0, 2).map(({ data }) => data);
const conductedOn = profile.originalInterview?.conductedOn;
const monthYear = conductedOn && new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long" }).format(new Date(`${conductedOn}T12:00:00`));
// Optional Sections render only with content: round one, round two, the
// closing question, the portrait and the scene.
const theVenue = copy.theVenue ?? [];
const dinnerAndDate = copy.dinnerAndDate ?? [];
const quoteAfter = Math.min(1, theVenue.length - 1);
const title = copy.title ?? subject.name;
const path = profilePath(copy.slug, locale);
const h2 = "scroll-mt-20 text-heading-2 text-ink";
const body = "max-w-measure font-body text-body-lg text-ink-muted";
const actionLink = "link-draw font-ui text-body-sm font-semibold";
const facts: [string, string | undefined][] = [
  [t(locale, "profile.worksAt"), subject.venue],
  [t(locale, "profile.neighbourhood"), subject.neighbourhood],
  [t(locale, "profile.cooks"), copy.shortVersion?.cuisine],
  [t(locale, "profile.from"), copy.shortVersion?.from],
  [t(locale, "profile.trainedAt"), copy.shortVersion?.trainedAt],
  [t(locale, "profile.since"), copy.shortVersion?.inKitchensSince?.toString()],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE_URL}${path}#page`,
  headline: title,
  description: copy.metaDescription,
  inLanguage: locale === "fr" ? "fr-CA" : "en-CA",
  datePublished: profile.published,
  ...(profile.image ? { image: [`${SITE_URL}${profile.image.src}`] } : {}),
  author: { "@type": "Person", name: profile.interviewer },
  mainEntity: { "@type": "Person", name: subject.name, jobTitle: subject.role, worksFor: { "@type": isBartender ? "BarOrPub" : "Restaurant", name: subject.venue } },
};
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} canonical={path} alternatePath={profilePath(profile.locales[copyLocale(other)].slug, other)} ogImage={profile.image?.src} ogType="article" publishDate={new Date(`${profile.published}T12:00:00`)}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="page-container pt-8 pb-section-sm" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <Breadcrumbs locale={locale} items={[{ label: t(locale, "nav.chefs"), href: `/${locale}/chefs/` }, { label: subject.name }]} />
    <SpotHero image={profile.image} alt={copy.imageAlt} caption={copy.imageCredit} transition={{ kind: "chef", id: profile.id }}>
      <p class="eyebrow">{t(locale, isBartender ? "profile.behindTheBarWith" : "profile.inKitchenWith")}</p>
      <h1 class="mt-4 w-fit text-4xl text-ink sm:text-heading-1 lg:text-display" style={transitionStyle(Astro.locals, "chef", profile.id, "title")}>{subject.name}</h1>
      {copy.standfirst && <p class={`mt-6 ${body}`}>{copy.standfirst}</p>}
      <p class="mt-6 font-ui text-body-sm text-ink-subtle">{[tf(locale, "profile.interviewBy", { name: profile.interviewer }), monthYear, t(locale, "profile.edited")].filter(Boolean).join(" · ")}</p>
    </SpotHero>
    <div class="mt-section-sm grid grid-cols-[minmax(0,1fr)] gap-16 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0 space-y-section-sm">
        {copy.shortScene && <div class={`space-y-5 italic ${body}`}><Paragraphs text={copy.shortScene} /></div>}

        {theVenue.length > 0 && <section id="the-venue" aria-labelledby="venue-title" class="scroll-mt-20 border-t border-line-strong pt-8">
          <p class="eyebrow">{t(locale, "profile.roundOne")}</p>
          <h2 id="venue-title" data-reveal class={`mt-3 ${h2}`}>{t(locale, isBartender ? "profile.theBar" : "profile.theRestaurant")}</h2>
          <div class="mt-8 space-y-10">
            {theVenue.map((item, index) => (
              <>
                <div>
                  <h3 class="max-w-measure font-ui text-lg font-semibold text-ink">{item.question}</h3>
                  <div class={`mt-3 space-y-5 ${body}`}><Paragraphs text={item.answer} /></div>
                </div>
                {copy.pullQuote && index === quoteAfter && <blockquote class="max-w-measure font-display text-heading-3 text-ink before:mb-5 before:block before:h-0.5 before:w-10 before:bg-accent before:content-['']">“{copy.pullQuote}”</blockquote>}
              </>
            ))}
          </div>
        </section>}

        {dinnerAndDate.length > 0 && <section id="dinner-and-a-date" aria-labelledby="date-title" class="scroll-mt-20 border-t border-line-strong pt-8">
          <p class="eyebrow">{t(locale, "profile.roundTwo")}</p>
          <h2 id="date-title" data-reveal class={`mt-3 ${h2}`}>{t(locale, "profile.dinnerAndDate")}</h2>
          <p class={`mt-5 ${body}`}>{t(locale, "profile.dinnerAndDateIntro")}</p>
          <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2">
            {dinnerAndDate.map((item, index) => (
              <div data-question={item.key} class="border-t border-line pt-5">
                <p class="font-ui text-caption tabular-nums text-ink-subtle">{index + 1} / {dinnerAndDate.length}</p>
                <h3 class="mt-2 text-xl text-ink">{item.question}</h3>
                <div class="mt-3 space-y-4 font-body text-ink-muted"><Paragraphs text={item.answer} /></div>
              </div>
            ))}
          </div>
        </section>}

        {copy.atHome && <section id="recipe-card" aria-labelledby="last-title" class:list={["card scroll-mt-20 grid gap-8", recipe?.image && "sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-center"]}>
          {recipe?.image && <img src={recipe.image.src} width={recipe.image.width} height={recipe.image.height} alt={recipeCopy?.imageAlt} loading="lazy" style={transitionStyle(Astro.locals, "recipe", recipe.id, "photo")} class="aspect-[4/5] w-full max-w-56 rounded-arch bg-surface-sunken object-cover object-center" />}
          <div>
            <p class="eyebrow">{t(locale, "profile.lastQuestion")}</p>
            <h2 id="last-title" data-reveal class={`mt-3 ${h2}`}>{t(locale, "profile.atHomeQuestion")}</h2>
            <div class={`mt-5 space-y-5 ${body}`}><Paragraphs text={copy.atHome} /></div>
            {recipe && recipeCopy && <>
              <p class="mt-4 font-ui text-body-sm text-ink-subtle">{t(locale, "profile.atHomeNote")}</p>
              <a href={recipeCardPath(recipeCopy.slug, locale)} class="btn btn-accent mt-6">{tf(locale, "dateSpot.getRecipeCard", { name: subject.name })}</a>
            </>}
          </div>
        </section>}

        <footer class="border-t border-line-strong pt-8">
          <p class="flex items-center gap-4 font-body text-heading-3 italic text-ink before:block before:h-px before:w-10 before:bg-line-strong before:content-['']">{profile.interviewer}</p>
          <p class="mt-4 max-w-measure font-ui text-body-sm text-ink-subtle">{t(locale, "profile.interviewNote")}</p>
        </footer>
      </div>

      <aside class="min-w-0 space-y-10 lg:sticky lg:top-24 lg:self-start">
        <section aria-labelledby="short-title" class="card">
          <h2 id="short-title" class="text-heading-3 text-ink">{t(locale, "profile.shortVersion")}</h2>
          <dl class="mt-4 divide-y divide-line border-y border-line font-ui text-body-sm">
            {facts.filter(([, value]) => value).map(([label, value]) => <div class="flex justify-between gap-4 py-3"><dt class="text-ink-subtle">{label}</dt><dd class="text-right text-ink">{value}</dd></div>)}
          </dl>
          {companion && <a href={dateSpotPath(companion, locale)} class="btn btn-primary mt-6 w-full">{tf(locale, "profile.readReview", { venue: companion.name })}</a>}
        </section>
        <nav aria-labelledby="interview-jump" class="no-print">
          <p id="interview-jump" class="eyebrow">{t(locale, "profile.inThisInterview")}</p>
          <ol class="mt-4 space-y-2 font-ui text-body-sm">
            {theVenue.length > 0 && <li><a href="#the-venue" class="link-draw text-ink-muted hover:text-ink">{t(locale, isBartender ? "profile.theBar" : "profile.theRestaurant")}</a></li>}
            {dinnerAndDate.length > 0 && <li><a href="#dinner-and-a-date" class="link-draw text-ink-muted hover:text-ink">{t(locale, "profile.dinnerAndDate")}</a></li>}
            {copy.atHome && <li><a href="#recipe-card" class="link-draw text-ink-muted hover:text-ink">{t(locale, "profile.recipeCard")}</a></li>}
          </ol>
        </nav>
        {moreChefs.length > 0 && <div>
          <p class="eyebrow">{t(locale, "profile.moreChefs")}</p>
          <ul class="mt-4 space-y-3 font-ui text-body-sm">
            {moreChefs.map((item) => <li class="flex items-baseline justify-between gap-3"><a href={profilePath(item.locales[copyLocale(locale)].slug, locale)} class="link-draw">{item.subject.name}</a>{item.subject.neighbourhood && <span class="text-ink-subtle">{item.subject.neighbourhood}</span>}</li>)}
            <li><a href={`/${locale}/chefs/`} class={actionLink}>{t(locale, "profile.everyone")}</a></li>
          </ul>
        </div>}
        <NewsletterSignup locale={locale} compact />
      </aside>
    </div>
  </article>
</BaseLayout>
