---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import Paragraphs from "@components/date-spots/Paragraphs.astro";
import { t, tf, type Locale } from "@i18n/utils";
import { copyLocale, dateSpotPath, profilePath, recipeCardPath } from "@utils/date-spots";
import { SITE_URL } from "@utils/constants";

// Round one is their restaurant or bar. Round two is the same eight
// questions asked of everyone, so answers compare across profiles and each
// card lifts out on its own. The last question is the hinge: what they would
// make for a date night at home, which becomes the recipe card.
interface Props { profile: CollectionEntry<"extendedProfiles">["data"]; locale: Locale; }
const { profile, locale } = Astro.props;
const copy = profile.locales[copyLocale(locale)];
const other: Locale = locale === "fr" ? "en" : "fr";
const { subject } = profile;
const isBartender = subject.role === "bartender";
const spots = await getCollection("dateSpots");
const recipes = await getCollection("contributorRecipes");
const profiles = await getCollection("extendedProfiles");
const companion = spots.find(({ data }) => data.id === profile.companionDateSpot)?.data;
const recipe = copy.contributorRecipe ? recipes.find(({ data }) => data.id === copy.contributorRecipe)?.data : undefined;
const recipeCopy = recipe?.locales[copyLocale(locale)];
const moreChefs = profiles.filter(({ data }) => data.id !== profile.id).slice(0, 2).map(({ data }) => data);
const monthYear = new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long" }).format(new Date(`${profile.originalInterview.conductedOn}T12:00:00`));
const quoteAfter = Math.min(1, copy.theVenue.length - 1);
const path = profilePath(copy.slug, locale);
const h2 = "scroll-mt-20 font-heading text-heading-2 text-warm-900 dark:text-warm-100";
const body = "font-body text-body-lg text-warm-700 dark:text-warm-300";
const kicker = "font-ui text-caption font-bold uppercase tracking-wider text-brand-wine-text dark:text-brand-rose";
const small = "font-ui text-caption font-bold uppercase tracking-wider text-warm-500 dark:text-warm-400";
const facts: [string, string | undefined][] = [
  [t(locale, "profile.worksAt"), subject.venue],
  [t(locale, "profile.neighbourhood"), subject.neighbourhood],
  [t(locale, "profile.cooks"), copy.shortVersion.cuisine],
  [t(locale, "profile.from"), copy.shortVersion.from],
  [t(locale, "profile.trainedAt"), copy.shortVersion.trainedAt],
  [t(locale, "profile.since"), copy.shortVersion.inKitchensSince?.toString()],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE_URL}${path}#page`,
  headline: copy.title,
  description: copy.metaDescription,
  inLanguage: locale === "fr" ? "fr-CA" : "en-CA",
  datePublished: profile.published,
  image: [`${SITE_URL}${profile.image.src}`],
  author: { "@type": "Person", name: profile.interviewer },
  mainEntity: { "@type": "Person", name: subject.name, jobTitle: subject.role, worksFor: { "@type": isBartender ? "BarOrPub" : "Restaurant", name: subject.venue } },
};
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} canonical={path} alternatePath={profilePath(profile.locales[copyLocale(other)].slug, other)} ogImage={profile.image.src} ogType="article" publishDate={new Date(`${profile.published}T12:00:00`)}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <Breadcrumbs locale={locale} items={[{ label: t(locale, "nav.chefs"), href: `/${locale}/chefs/` }, { label: subject.name }]} />
    <div class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0 space-y-14">
        <header>
          <p class={kicker}>{t(locale, isBartender ? "profile.behindTheBarWith" : "profile.inKitchenWith")}</p>
          <h1 class="mt-3 font-heading text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">{subject.name}</h1>
          <p class="mt-5 max-w-prose font-body text-body-lg text-warm-700 dark:text-warm-300">{copy.standfirst}</p>
          <p class="mt-4 font-ui text-body-sm text-warm-500 dark:text-warm-400">{tf(locale, "profile.interviewBy", { name: profile.interviewer })} · {monthYear} · {t(locale, "profile.edited")}</p>
          <figure class="mt-8">
            <img src={profile.image.src} width={profile.image.width} height={profile.image.height} alt={copy.imageAlt} class="max-h-[520px] w-full rounded-2xl object-cover" loading="eager" fetchpriority="high" />
            <figcaption class="mt-2 font-ui text-caption text-warm-500 dark:text-warm-400">{copy.imageCredit}</figcaption>
          </figure>
          <div class={`mt-8 space-y-4 italic ${body}`}><Paragraphs text={copy.shortScene} /></div>
        </header>

        <section id="the-venue" aria-labelledby="venue-title">
          <p class={kicker}>{t(locale, "profile.roundOne")}</p>
          <h2 id="venue-title" class={`mt-2 ${h2}`}>{t(locale, isBartender ? "profile.theBar" : "profile.theRestaurant")}</h2>
          <div class="mt-6 space-y-8">
            {copy.theVenue.map((item, index) => (
              <>
                <div>
                  <h3 class="font-ui text-lg font-semibold text-warm-900 dark:text-warm-100">{item.question}</h3>
                  <div class={`mt-2 space-y-4 ${body}`}><Paragraphs text={item.answer} /></div>
                </div>
                {copy.pullQuote && index === quoteAfter && <blockquote class="border-l-4 border-brand-rose pl-5 font-heading text-heading-3 italic text-warm-900 dark:text-warm-100">“{copy.pullQuote}”</blockquote>}
              </>
            ))}
          </div>
        </section>

        <section id="dinner-and-a-date" aria-labelledby="date-title">
          <p class={kicker}>{t(locale, "profile.roundTwo")}</p>
          <h2 id="date-title" class={`mt-2 ${h2}`}>{t(locale, "profile.dinnerAndDate")}</h2>
          <p class={`mt-3 ${body}`}>{t(locale, "profile.dinnerAndDateIntro")}</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {copy.dinnerAndDate.map((item, index) => (
              <div data-question={item.key} class="border border-warm-200 p-5 dark:border-warm-700">
                <p class="font-ui text-caption font-bold text-warm-500 dark:text-warm-400">{index + 1} / {copy.dinnerAndDate.length}</p>
                <h3 class="mt-2 font-heading text-lg text-warm-900 dark:text-warm-100">{item.question}</h3>
                <div class="mt-2 space-y-3 font-body text-warm-700 dark:text-warm-300"><Paragraphs text={item.answer} /></div>
              </div>
            ))}
          </div>
        </section>

        {copy.atHome && recipe && recipeCopy && <section id="recipe-card" aria-labelledby="last-title" class="grid gap-6 bg-warm-50 p-6 dark:bg-warm-900 sm:grid-cols-[14rem_minmax(0,1fr)]">
          <img src={recipe.image.src} width={recipe.image.width} height={recipe.image.height} alt={recipeCopy.imageAlt} loading="lazy" class="h-auto w-full rounded-xl object-cover" />
          <div>
            <p class={kicker}>{t(locale, "profile.lastQuestion")}</p>
            <h2 id="last-title" class={`mt-2 ${h2}`}>{t(locale, "profile.atHomeQuestion")}</h2>
            <div class={`mt-3 space-y-4 ${body}`}><Paragraphs text={copy.atHome} /></div>
            <p class="mt-3 font-ui text-body-sm text-warm-500 dark:text-warm-400">{t(locale, "profile.atHomeNote")}</p>
            <a href={recipeCardPath(recipeCopy.slug, locale)} class="mt-4 inline-block font-ui font-semibold text-brand-wine-text underline dark:text-brand-rose">{tf(locale, "dateSpot.getRecipeCard", { name: subject.name })}</a>
          </div>
        </section>}

        <footer>
          <p class="font-caveat text-3xl normal-case text-warm-900 dark:text-warm-100">{profile.interviewer}</p>
          <p class="mt-2 font-ui text-body-sm text-warm-600 dark:text-warm-400">{t(locale, "profile.interviewNote")}</p>
        </footer>
      </div>

      <aside class="min-w-0 space-y-8 lg:sticky lg:top-24 lg:self-start">
        <section aria-labelledby="short-title" class="border border-warm-200 bg-white p-6 dark:border-warm-700 dark:bg-warm-900">
          <h2 id="short-title" class="font-heading text-2xl text-warm-900 dark:text-warm-100">{t(locale, "profile.shortVersion")}</h2>
          <dl class="mt-3 divide-y divide-warm-200 font-ui text-body-sm dark:divide-warm-700">
            {facts.filter(([, value]) => value).map(([label, value]) => <div class="flex justify-between gap-4 py-2.5"><dt class="text-warm-500 dark:text-warm-400">{label}</dt><dd class="text-right text-warm-800 dark:text-warm-200">{value}</dd></div>)}
          </dl>
          {companion && <a href={dateSpotPath(companion, locale)} class="mt-4 block bg-brand-wine px-4 py-2.5 text-center font-ui text-body-sm font-semibold text-white no-underline dark:bg-brand-rose dark:text-warm-950">{tf(locale, "profile.readReview", { venue: companion.name })}</a>}
        </section>
        <nav aria-labelledby="interview-jump">
          <p id="interview-jump" class={small}>{t(locale, "profile.inThisInterview")}</p>
          <ol class="mt-3 space-y-1.5 font-ui text-body-sm">
            <li><a href="#the-venue" class="text-warm-700 no-underline dark:text-warm-300">{t(locale, isBartender ? "profile.theBar" : "profile.theRestaurant")}</a></li>
            <li><a href="#dinner-and-a-date" class="text-warm-700 no-underline dark:text-warm-300">{t(locale, "profile.dinnerAndDate")}</a></li>
            {recipe && <li><a href="#recipe-card" class="text-warm-700 no-underline dark:text-warm-300">{t(locale, "profile.recipeCard")}</a></li>}
          </ol>
        </nav>
        {moreChefs.length > 0 && <div>
          <p class={small}>{t(locale, "profile.moreChefs")}</p>
          <ul class="mt-3 space-y-2 font-ui text-body-sm">
            {moreChefs.map((item) => <li class="flex justify-between gap-3"><a href={profilePath(item.locales[copyLocale(locale)].slug, locale)} class="text-warm-800 dark:text-warm-200">{item.subject.name}</a><span class="text-warm-500 dark:text-warm-400">{item.subject.neighbourhood}</span></li>)}
            <li><a href={`/${locale}/chefs/`} class="font-semibold text-brand-wine-text underline dark:text-brand-rose">{t(locale, "profile.everyone")}</a></li>
          </ul>
        </div>}
        <NewsletterSignup locale={locale} compact />
      </aside>
    </div>
  </article>
</BaseLayout>
