---
import { t, getLocalizedPath, type Locale } from "@i18n/utils";
import LanguageToggle from "./LanguageToggle.astro";
import DarkModeToggle from "./DarkModeToggle.astro";

interface Props {
  locale: Locale;
  translationSlug?: string;
}

const { locale, translationSlug } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: t(locale, "nav.home"), path: "/" },
  { label: t(locale, "nav.recipes"), path: locale === "fr" ? "/recettes/" : "/recipes/" },
  { label: t(locale, "nav.about"), path: locale === "fr" ? "/a-propos/" : "/about/" },
  { label: t(locale, "nav.contact"), path: "/contact/" },
];

function isActive(linkPath: string): boolean {
  const fullPath = getLocalizedPath(locale, linkPath);
  if (linkPath === "/") return currentPath === fullPath;
  return currentPath.startsWith(fullPath);
}
---

<nav class="no-print sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur-sm dark:border-gray-800 dark:bg-gray-950/95">
  <div class="mx-auto flex max-w-content items-center justify-between px-4 py-3">
    <!-- Logo -->
    <a href={getLocalizedPath(locale, "/")} class="flex items-center gap-2.5 no-underline hover:opacity-80">
      <img src="/favicon.svg" class="h-8 w-8" alt="" width="32" height="32" />
      <span class="font-handwritten text-2xl text-brand-primary sm:text-3xl">Date My Dish</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={getLocalizedPath(locale, link.path)}
          class:list={[
            "relative rounded-lg px-3 py-2 font-ui text-sm font-medium uppercase no-underline transition-colors",
            isActive(link.path)
              ? "text-brand-primary-text"
              : "text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-gray-100",
          ]}
          aria-current={isActive(link.path) ? "page" : undefined}
        >
          {link.label}
          {isActive(link.path) && (
            <span class="absolute bottom-0 left-3 right-3 h-0.5 rounded-full bg-brand-primary" />
          )}
        </a>
      ))}

      <div class="ml-2 flex items-center gap-1">
        <!-- Search button (opens overlay) -->
        <button
          id="nav-search-btn"
          class="rounded-lg p-2 text-gray-400 no-underline transition-colors hover:bg-gray-100 hover:text-gray-600 dark:text-gray-500 dark:hover:bg-gray-800 dark:hover:text-gray-300"
          aria-label={t(locale, "nav.search")}
          title="⌘K"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <DarkModeToggle locale={locale} />
        <LanguageToggle locale={locale} translationSlug={translationSlug} />
      </div>
    </div>

    <!-- Mobile: search + hamburger -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        id="nav-search-btn-mobile"
        class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
        aria-label={t(locale, "nav.search")}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button
        id="mobile-menu-btn"
        class="rounded-lg p-2 text-gray-600 dark:text-gray-300"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white md:hidden dark:border-gray-800 dark:bg-gray-950">
    <div class="mx-auto max-w-content space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={getLocalizedPath(locale, link.path)}
          class:list={[
            "block rounded-lg px-4 py-3 font-ui text-base font-medium uppercase no-underline transition-colors",
            isActive(link.path)
              ? "bg-brand-primary/5 text-brand-primary-text"
              : "text-gray-700 hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-gray-800/50",
          ]}
          aria-current={isActive(link.path) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-3 border-t border-gray-100 px-4 pt-3 dark:border-gray-800">
        <DarkModeToggle locale={locale} />
        <LanguageToggle locale={locale} translationSlug={translationSlug} />
      </div>
    </div>
  </div>
</nav>

<script is:inline>
(function() {
  var menuBtn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var hamburger = document.getElementById('hamburger-icon');
  var closeIcon = document.getElementById('close-icon');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', function() {
      var isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });
  }

  // Search buttons open overlay
  var searchBtns = document.querySelectorAll('#nav-search-btn, #nav-search-btn-mobile');
  searchBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      // Close mobile menu first if open
      if (menu && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
      if (window.__openSearch) window.__openSearch(btn);
    });
  });
})();
</script>
