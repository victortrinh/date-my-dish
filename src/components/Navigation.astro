---
import { t, getLocalizedPath, type Locale } from "@i18n/utils";
import { getCollection } from "astro:content";
import { dateSpotDestinations } from "@utils/date-spots";
import LanguageToggle from "./LanguageToggle.astro";
import DarkModeToggle from "./DarkModeToggle.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
  translationSlug?: string;
  contentType?: "recipe" | "article" | "review" | "date-spot";
  alternatePath?: string;
}

const { locale, translationSlug, contentType, alternatePath } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: t(locale, "nav.home"), path: "/" },
  ...dateSpotDestinations(await getCollection("dateSpots"), locale, await getCollection("extendedProfiles")),
  { label: t(locale, "nav.about"), path: locale === "fr" ? "/a-propos/" : "/about/" },
  { label: t(locale, "nav.contact"), path: "/contact/" },
];

function isActive(linkPath: string): boolean {
  const fullPath = getLocalizedPath(locale, linkPath);
  if (linkPath === "/") return currentPath === fullPath;
  return currentPath.startsWith(fullPath);
}
---

<nav class="no-print sticky top-0 z-50 border-b border-line bg-surface">
  <div class="page-container flex h-16 items-center justify-between gap-6 sm:h-20">
    <div class="flex items-center gap-12">
      <Logo locale={locale} size="h-7 sm:h-8" class="text-ink" />

      <div class="hidden items-center gap-8 lg:flex">
        {navLinks.map((link) => (
          <a
            href={getLocalizedPath(locale, link.path)}
            class:list={[
              "link-draw py-1 font-ui text-body-sm",
              isActive(link.path) ? "text-ink" : "text-ink-muted",
            ]}
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Right group: Action icons (desktop) -->
    <div class="hidden items-center gap-2 lg:flex">
      <button
        id="nav-search-btn"
        class="btn-icon"
        aria-label={t(locale, "nav.search")}
        title="⌘K"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <LanguageToggle locale={locale} translationSlug={translationSlug} contentType={contentType} alternatePath={alternatePath} />
      <DarkModeToggle locale={locale} includeScript={false} />
    </div>

    <!-- Mobile: search + menu -->
    <div class="flex items-center gap-1 lg:hidden">
      <button
        id="nav-search-btn-mobile"
        class="btn-icon"
        aria-label={t(locale, "nav.search")}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button
        id="mobile-menu-btn"
        class="btn-icon"
        aria-label={t(locale, "nav.toggleMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden h-[calc(100dvh-4rem)] overflow-y-auto border-t border-line bg-surface lg:hidden">
    <div class="page-container flex min-h-full flex-col gap-10 py-10">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={getLocalizedPath(locale, link.path)}
            class:list={[
              "py-2 font-display text-heading-2 no-underline transition-colors",
              isActive(link.path) ? "text-ink" : "text-ink-muted hover:text-ink",
            ]}
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="mt-auto flex items-center gap-3 border-t border-line pt-6">
        <DarkModeToggle locale={locale} />
        <LanguageToggle locale={locale} translationSlug={translationSlug} contentType={contentType} alternatePath={alternatePath} />
      </div>
    </div>
  </div>
</nav>

<script is:inline>
(function() {
  var menuBtn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var hamburger = document.getElementById('hamburger-icon');
  var closeIcon = document.getElementById('close-icon');

  function closeMenu() {
    menu.classList.add('hidden');
    hamburger.classList.remove('hidden');
    closeIcon.classList.add('hidden');
    menuBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
    menuBtn.focus();
  }

  function openMenu() {
    menu.classList.remove('hidden');
    hamburger.classList.add('hidden');
    closeIcon.classList.remove('hidden');
    menuBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    // Move focus to first link in menu
    var firstLink = menu.querySelector('a');
    if (firstLink) firstLink.focus();
  }

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', function() {
      var isOpen = !menu.classList.contains('hidden');
      if (isOpen) { closeMenu(); } else { openMenu(); }
    });

    // Click outside closes mobile menu
    document.addEventListener('click', function(e) {
      var isOpen = !menu.classList.contains('hidden');
      if (isOpen && !menu.contains(e.target) && !menuBtn.contains(e.target)) {
        closeMenu();
      }
    });

    // Escape key closes mobile menu
    menu.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeMenu();
      }
      // Focus trap within mobile menu
      if (e.key === 'Tab') {
        var focusable = menu.querySelectorAll('a[href], button:not([disabled])');
        if (focusable.length === 0) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  // Search buttons open overlay
  var searchBtns = document.querySelectorAll('#nav-search-btn, #nav-search-btn-mobile');
  searchBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      // Close mobile menu first if open
      if (menu && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
      }
      if (window.__openSearch) window.__openSearch(btn);
    });
  });
})();
</script>
