---
import { t, getLocalizedPath, getBookmarksLocalizedPath, type Locale } from "@i18n/utils";
import LanguageToggle from "./LanguageToggle.astro";
import DarkModeToggle from "./DarkModeToggle.astro";
import { getImage } from "astro:assets";
import inlineLogoSrc from "@assets/images/logo-datemydish-inline.png";

const inlineLogo = await getImage({ src: inlineLogoSrc, format: "webp" });

interface Props {
  locale: Locale;
  translationSlug?: string;
  contentType?: "recipe" | "article";
}

const { locale, translationSlug, contentType } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: t(locale, "nav.home"), path: "/" },
  { label: t(locale, "nav.recipes"), path: locale === "fr" ? "/recettes/" : "/recipes/" },
  { label: t(locale, "nav.articles"), path: "/articles/" },
  { label: t(locale, "nav.about"), path: locale === "fr" ? "/a-propos/" : "/about/" },
  { label: t(locale, "nav.contact"), path: "/contact/" },
];

function isActive(linkPath: string): boolean {
  const fullPath = getLocalizedPath(locale, linkPath);
  if (linkPath === "/") return currentPath === fullPath;
  return currentPath.startsWith(fullPath);
}
---

<nav class="no-print sticky top-0 z-50 border-b border-neutral-100 bg-neutral-50/95 backdrop-blur-sm dark:border-neutral-800 dark:bg-neutral-950/95">
  <div class="mx-auto flex max-w-content items-center justify-between px-4 py-4">
    <!-- Logo -->
    <a href={getLocalizedPath(locale, "/")} class="flex items-center gap-2.5 no-underline hover:opacity-80">
      <img src="/favicon.svg" class="h-8 w-8 sm:hidden" alt="" width="32" height="32" data-pin-nopin="true" />
      <img src={inlineLogo.src} class="hidden h-8 sm:block sm:h-10" alt="Date My Dish" width={inlineLogo.width} height={inlineLogo.height} data-pin-nopin="true" />
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <a
          href={getLocalizedPath(locale, link.path)}
          class:list={[
            "relative rounded-lg px-3 py-2 font-ui text-sm font-medium uppercase no-underline transition-colors",
            isActive(link.path)
              ? "text-brand-primary-text"
              : "text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100",
          ]}
          aria-current={isActive(link.path) ? "page" : undefined}
        >
          {link.label}
          {isActive(link.path) && (
            <span class="absolute bottom-0 left-3 right-3 h-0.5 rounded-full bg-brand-primary" />
          )}
        </a>
      ))}

      <div class="ml-2 flex items-center gap-1">
        <!-- Search button (opens overlay) -->
        <button
          id="nav-search-btn"
          class="btn btn-ghost"
          aria-label={t(locale, "nav.search")}
          title="⌘K"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <a
          href={getBookmarksLocalizedPath(locale)}
          class="bookmark-nav-link relative btn btn-ghost no-underline"
          aria-label={t(locale, "bookmark.pageTitle")}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span class="bookmark-dot absolute -right-0.5 -top-0.5 hidden h-2 w-2 rounded-full bg-red-500"></span>
        </a>
        <DarkModeToggle locale={locale} />
        <LanguageToggle locale={locale} translationSlug={translationSlug} contentType={contentType} />
      </div>
    </div>

    <!-- Mobile: search + hamburger -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        id="nav-search-btn-mobile"
        class="btn btn-ghost"
        aria-label={t(locale, "nav.search")}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <button
        id="mobile-menu-btn"
        class="rounded-lg p-2 text-neutral-600 dark:text-neutral-300"
        aria-label={t(locale, "nav.toggleMenu")}
        aria-expanded="false"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-neutral-100 bg-neutral-50 md:hidden dark:border-neutral-800 dark:bg-neutral-950">
    <div class="mx-auto max-w-content space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={getLocalizedPath(locale, link.path)}
          class:list={[
            "block rounded-lg px-4 py-3 font-ui text-base font-medium uppercase no-underline transition-colors",
            isActive(link.path)
              ? "bg-brand-primary/5 text-brand-primary-text"
              : "text-neutral-700 hover:bg-neutral-50 dark:text-neutral-200 dark:hover:bg-neutral-800/50",
          ]}
          aria-current={isActive(link.path) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-3 border-t border-neutral-100 px-4 pt-3 dark:border-neutral-800">
        <DarkModeToggle locale={locale} />
        <LanguageToggle locale={locale} translationSlug={translationSlug} contentType={contentType} />
      </div>
    </div>
  </div>
</nav>

<script is:inline>
(function() {
  var menuBtn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var hamburger = document.getElementById('hamburger-icon');
  var closeIcon = document.getElementById('close-icon');

  function closeMenu() {
    menu.classList.add('hidden');
    hamburger.classList.remove('hidden');
    closeIcon.classList.add('hidden');
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.focus();
  }

  function openMenu() {
    menu.classList.remove('hidden');
    hamburger.classList.add('hidden');
    closeIcon.classList.remove('hidden');
    menuBtn.setAttribute('aria-expanded', 'true');
    // Move focus to first link in menu
    var firstLink = menu.querySelector('a');
    if (firstLink) firstLink.focus();
  }

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', function() {
      var isOpen = !menu.classList.contains('hidden');
      if (isOpen) { closeMenu(); } else { openMenu(); }
    });

    // Escape key closes mobile menu
    menu.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeMenu();
      }
      // Focus trap within mobile menu
      if (e.key === 'Tab') {
        var focusable = menu.querySelectorAll('a[href], button:not([disabled])');
        if (focusable.length === 0) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  // Bookmark dot indicator
  try {
    var bookmarks = JSON.parse(localStorage.getItem('dmd_bookmarks') || '[]');
    if (bookmarks.length > 0) {
      document.querySelectorAll('.bookmark-dot').forEach(function(dot) {
        dot.classList.remove('hidden');
      });
    }
  } catch(e) {}

  // Search buttons open overlay
  var searchBtns = document.querySelectorAll('#nav-search-btn, #nav-search-btn-mobile');
  searchBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      // Close mobile menu first if open
      if (menu && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
      if (window.__openSearch) window.__openSearch(btn);
    });
  });
})();
</script>
