---
import { t, getLocalizedPath, type Locale } from "@i18n/utils";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  locale: Locale;
  translationSlug?: string;
}

const { locale, translationSlug } = Astro.props;

const navLinks = [
  { label: t(locale, "nav.home"), path: "/" },
  { label: t(locale, "nav.recipes"), path: locale === "fr" ? "/recettes/" : "/recipes/" },
  { label: t(locale, "nav.about"), path: locale === "fr" ? "/a-propos/" : "/about/" },
  { label: t(locale, "nav.contact"), path: "/contact/" },
];
---

<nav class="no-print sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <!-- Logo -->
    <a href={getLocalizedPath(locale, "/")} class="flex items-center gap-2 no-underline hover:opacity-80">
      <span class="font-handwritten text-2xl text-brand-blue">Date My Dish</span>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-6 md:flex">
      {navLinks.map((link) => (
        <a
          href={getLocalizedPath(locale, link.path)}
          class="font-ui text-sm font-medium text-gray-600 no-underline hover:text-brand-blue"
        >
          {link.label}
        </a>
      ))}
      <a
        href={getLocalizedPath(locale, locale === "fr" ? "/recherche/" : "/search/")}
        class="text-gray-400 no-underline hover:text-brand-blue"
        aria-label={t(locale, "nav.search")}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>
      <LanguageToggle locale={locale} translationSlug={translationSlug} />
    </div>

    <!-- Mobile Menu Toggle (CSS-only) -->
    <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" aria-label="Toggle menu" />
    <label for="mobile-menu-toggle" class="cursor-pointer md:hidden" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>

    <!-- Mobile Menu -->
    <div class="fixed inset-0 top-[57px] z-40 hidden bg-white peer-checked:block md:hidden">
      <div class="flex flex-col gap-1 p-4">
        {navLinks.map((link) => (
          <a
            href={getLocalizedPath(locale, link.path)}
            class="rounded-lg px-4 py-3 font-ui text-base font-medium text-gray-700 no-underline hover:bg-gray-50 hover:text-brand-blue"
          >
            {link.label}
          </a>
        ))}
        <a
          href={getLocalizedPath(locale, locale === "fr" ? "/recherche/" : "/search/")}
          class="rounded-lg px-4 py-3 font-ui text-base font-medium text-gray-700 no-underline hover:bg-gray-50 hover:text-brand-blue"
        >
          {t(locale, "nav.search")}
        </a>
        <div class="mt-2 border-t border-gray-100 pt-3 pl-4">
          <LanguageToggle locale={locale} translationSlug={translationSlug} />
        </div>
      </div>
    </div>
  </div>
</nav>
