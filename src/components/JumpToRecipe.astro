---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a
  href="#recipe"
  class="no-print inline-flex items-center gap-2 rounded-full bg-brand-accent px-6 py-3 font-ui text-sm font-semibold text-white no-underline shadow-sm transition-all hover:bg-brand-accent-dark hover:shadow-md"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
  </svg>
  {t(locale, "recipe.jumpToRecipe")}
</a>
