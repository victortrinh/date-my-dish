---
interface Props {
  summary: string;
  title: string;
}

const { summary, title } = Astro.props;
---

{summary && (
  <div class="mb-8 rounded-lg border border-brand-rose/20 bg-brand-rose/5 p-5 dark:border-brand-rose/10 dark:bg-brand-rose/5">
    <p class="text-body-sm font-medium leading-relaxed text-warm-700 dark:text-warm-300">
      {summary}
    </p>
  </div>
)}
