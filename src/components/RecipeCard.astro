---
import { Picture } from "astro:assets";
import { t, getRecipeLocalizedPath, type Locale } from "@i18n/utils";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: Locale;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  prepTime: string;
  totalTime?: string;
  difficulty: "easy" | "medium" | "hard";
}

const { title, description, slug, locale, heroImage, heroImageAlt, prepTime, totalTime, difficulty } = Astro.props;

const url = getRecipeLocalizedPath(locale, slug);

// Parse ISO 8601 duration to readable format
function formatDuration(iso: string): string {
  const match = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!match) return iso;
  const hours = match[1] ? parseInt(match[1]) : 0;
  const minutes = match[2] ? parseInt(match[2]) : 0;
  if (hours > 0) return `${hours}h${minutes > 0 ? ` ${minutes}${t(locale, "recipe.minutes")}` : ""}`;
  return `${minutes} ${t(locale, "recipe.minutes")}`;
}

const difficultyColors = {
  easy: "bg-green-100 text-green-800",
  medium: "bg-yellow-100 text-yellow-800",
  hard: "bg-red-100 text-red-800",
};
---

<article class="group overflow-hidden rounded-xl bg-white dark:bg-gray-900 shadow-sm transition-shadow hover:shadow-md">
  <a href={url} class="block no-underline">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Picture
        src={heroImage}
        alt={heroImageAlt}
        widths={[400, 600, 800]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        formats={["avif", "webp"]}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="p-4">
      <h3 class="mb-2 font-heading text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-brand-primary">
        {title}
      </h3>
      <p class="mb-3 line-clamp-2 text-sm text-gray-600 dark:text-gray-400">{description}</p>
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-500 dark:text-gray-400">
          {formatDuration(totalTime || prepTime)}
        </span>
        <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${difficultyColors[difficulty]}`}>
          {t(locale, `recipe.${difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
        </span>
      </div>
    </div>
  </a>
</article>
