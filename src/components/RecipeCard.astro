---
import { Picture } from "astro:assets";
import { t, getRecipeLocalizedPath, type Locale } from "@i18n/utils";
import { difficultyBadge } from "@utils/recipe";
import { formatDuration } from "@utils/format";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: Locale;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  prepTime: string;
  totalTime?: string;
  difficulty: "easy" | "medium" | "hard";
  headingLevel?: "h2" | "h3";
  loading?: "lazy" | "eager";
}

const { title, description, slug, locale, heroImage, heroImageAlt, totalTime, prepTime, difficulty, headingLevel = "h2", loading = "lazy" } = Astro.props;
const Heading = headingLevel;
const url = getRecipeLocalizedPath(locale, slug);
---

<a href={url} class="group overflow-hidden rounded-xl bg-white no-underline dark:bg-warm-900">
  <div class="aspect-[16/14] overflow-hidden">
    <Picture
      src={heroImage}
      alt={heroImageAlt}
      widths={[400, 600]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 30vw"
      formats={["avif", "webp"]} fallbackFormat="webp"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading={loading}
      decoding="async"
      data-pin-nopin="true"
    />
  </div>
  <div class="p-5">
    <div class="mb-3 flex items-center justify-between">
      <span class="flex items-center gap-1 text-sm text-brand-wine dark:text-brand-wine-dark">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {formatDuration(totalTime || prepTime, locale)}
      </span>
      <span class={difficultyBadge[difficulty]}>
        {t(locale, `recipe.${difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
      </span>
    </div>
    <Heading class="font-heading text-xl font-normal text-warm-800 dark:text-warm-100">
      {title}
    </Heading>
    <p class="mt-2 text-sm text-warm-500 dark:text-warm-400">
      {description}
    </p>
  </div>
</a>
