---
import { Picture } from "astro:assets";
import { t, getRecipeLocalizedPath, type Locale } from "@i18n/utils";
import { difficultyColors } from "@utils/recipe";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  locale: Locale;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  prepTime: string;
  totalTime?: string;
  difficulty: "easy" | "medium" | "hard";
  headingLevel?: "h2" | "h3";
  loading?: "lazy" | "eager";
}

const { title, description, slug, locale, heroImage, heroImageAlt, prepTime, totalTime, difficulty, headingLevel = "h2", loading = "lazy" } = Astro.props;
const Heading = headingLevel;

const url = getRecipeLocalizedPath(locale, slug);

function formatDuration(iso: string): string {
  const match = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?/);
  if (!match) return iso;
  const hours = match[1] ? parseInt(match[1]) : 0;
  const minutes = match[2] ? parseInt(match[2]) : 0;
  if (hours > 0) return `${hours}h${minutes > 0 ? ` ${minutes}${t(locale, "recipe.minutes")}` : ""}`;
  return `${minutes} ${t(locale, "recipe.minutes")}`;
}

---

<article class="group overflow-hidden rounded-xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:bg-neutral-900/80 dark:shadow-neutral-950/20">
  <a href={url} class="block no-underline">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Picture
        src={heroImage}
        alt={heroImageAlt}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        formats={["avif", "webp"]}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading={loading}
        decoding="async"
      />
    </div>
    <div class="p-5">
      <Heading class="mb-2 line-clamp-2 font-heading text-lg font-bold text-neutral-900 transition-colors group-hover:text-brand-primary dark:text-neutral-100">
        {title}
      </Heading>
      <p class="mb-4 line-clamp-2 text-body-sm text-neutral-500 dark:text-neutral-400">{description}</p>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5 text-neutral-400 dark:text-neutral-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-caption font-medium">
            {formatDuration(totalTime || prepTime)}
          </span>
        </div>
        <span class={`rounded-full px-2.5 py-0.5 text-caption font-medium ${difficultyColors[difficulty]}`}>
          {t(locale, `recipe.${difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
        </span>
      </div>
    </div>
  </a>
</article>
