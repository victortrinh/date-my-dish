---
import { t, getLocalizedPath, type Locale } from "@i18n/utils";
import { SITE_URL } from "@utils/constants";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  locale: Locale;
  items: BreadcrumbItem[];
}

const { locale, items } = Astro.props;

// Build full breadcrumb list with Home prepended
const breadcrumbs: BreadcrumbItem[] = [
  { label: t(locale, "breadcrumbs.home"), href: getLocalizedPath(locale, "/") },
  ...items,
];

// BreadcrumbList JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: `${SITE_URL}${item.href}` } : {}),
  })),
};
---

<nav aria-label={t(locale, "nav.breadcrumb")} class="no-print mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-ui text-caption text-ink-subtle">
    {breadcrumbs.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-line">/</span>}
        {item.href && i < breadcrumbs.length - 1 ? (
          <a href={item.href} class="link-draw text-ink-subtle hover:text-ink">
            {item.label}
          </a>
        ) : (
          <span class="text-ink" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
