---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import DateSpotSchema from "@components/DateSpotSchema.astro";
import { getReviewLocalizedPath, type Locale } from "@i18n/utils";

interface Props { spot: any; locale: Locale; }
const { spot, locale } = Astro.props;
const copy = spot.locales[locale === "fr" ? "fr-CA" : "en"];
const pair = spot.locales[locale === "fr" ? "en" : "fr-CA"];
const labels = locale === "fr" ? {
  reviews: "Critiques", restaurant: "Restaurant", verdict: "Notre verdict", goodFor: "Bon pour",
  room: "La salle", drink: "Quoi boire", order: "Quoi commander", cost: "Le vrai coût",
  note: "Note du journaliste", booking: "Avant de réserver", essentials: "L’essentiel",
  address: "Adresse", reservation: "Réservation", access: "Accès", duration: "Durée", timing: "Moment",
  disclosure: "Divulgation", freshness: "Fraîcheur du reportage", visited: "Visité", published: "Publié",
  checked: "Dernière vérification", updates: "Mises à jour", map: "Voir sur la carte",
  chef: "Rencontre avec le chef", nearby: "À proximité", recipe: "Recette du collaborateur", source: "Source",
  occasions: { "first-date": "Premier rendez-vous", anniversary: "Anniversaire", "casual-midweek": "Soir de semaine", "impressing-a-cook": "Impressionner un cuisinier", "double-date": "Sortie à quatre", "solo-at-the-bar": "Solo au bar" },
  assessments: { ideal: "Idéal", caveat: "Avec réserve", "not-for": "Pas pour cette occasion" },
  verdicts: { favourite: "Un coup de cœur", conditional: "Selon la soirée", pass: "Pas notre premier choix" },
} : {
  reviews: "Reviews", restaurant: "Restaurant", verdict: "Our verdict", goodFor: "Good for",
  room: "The room", drink: "What to drink", order: "What to order", cost: "The real cost",
  note: "Reporter’s Note", booking: "Before you book", essentials: "Essentials",
  address: "Address", reservation: "Booking", access: "Access", duration: "Duration", timing: "Timing",
  disclosure: "Disclosure", freshness: "Reporting freshness", visited: "Visited", published: "Published",
  checked: "Last checked", updates: "Updates", map: "Open map",
  chef: "Meet the chef", nearby: "Nearby plans", recipe: "Contributor recipe", source: "Source",
  occasions: { "first-date": "First date", anniversary: "Anniversary", "casual-midweek": "Casual midweek", "impressing-a-cook": "Impressing a cook", "double-date": "Double date", "solo-at-the-bar": "Solo at the bar" },
  assessments: { ideal: "Ideal", caveat: "With a caveat", "not-for": "Not for this" },
  verdicts: { favourite: "A Favourite", conditional: "Depends on the Night", pass: "Not Our First Pick" },
};
const dateLocale = locale === "fr" ? "fr-CA" : "en-CA";
const formatDate = (value: string) => new Date(`${value}T00:00:00Z`).toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const sectionClass = "border-t border-warm-200 py-10 dark:border-warm-700";
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} canonical={getReviewLocalizedPath(locale, copy.slug)} ogImage={spot.image.src} translationSlug={pair.slug} contentType="date-spot" ogType="article" publishDate={new Date(`${spot.freshness.published}T00:00:00Z`)} updatedDate={new Date(`${spot.freshness.lastChecked}T00:00:00Z`)}>
  <DateSpotSchema slot="head" spot={spot} locale={locale} />
  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <Breadcrumbs locale={locale} items={[{ label: labels.reviews, href: locale === "fr" ? "/fr/critiques/" : "/en/reviews/" }, { label: spot.name }]} />
    <header class="grid gap-8 py-8 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <p class="mb-3 font-ui text-caption font-bold uppercase tracking-[0.18em] text-brand-wine-text dark:text-brand-rose">{labels.restaurant} · {spot.neighbourhood}, {spot.city}</p>
        <h1 class="mb-5 text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">{copy.title}</h1>
        <p class="mb-8 text-body-lg text-warm-600 dark:text-warm-300">{copy.opening}</p>
        <div class="rounded-2xl border-l-4 border-brand-wine bg-warm-100 p-6 dark:border-brand-rose dark:bg-warm-900">
          <p class="font-ui text-caption font-bold uppercase tracking-wider text-brand-wine-text dark:text-brand-rose">{labels.verdict}</p>
          <p class="my-2 font-heading text-heading-2 text-warm-900 dark:text-warm-100">{labels.verdicts[spot.reviewVerdict]}</p>
          <p>{copy.verdictReason}</p>
        </div>
      </div>
      <figure><img src={spot.image.src} alt={copy.imageAlt} width={spot.image.width} height={spot.image.height} class="max-h-[42rem] w-full rounded-2xl object-cover" /><figcaption class="mt-2 font-ui text-caption text-warm-500">{copy.imageCaption ? `${copy.imageCaption} · ${copy.imageCredit}` : copy.imageCredit}</figcaption></figure>
    </header>

    <section class={sectionClass} aria-labelledby="good-for"><h2 id="good-for" class="mb-6 text-heading-2">{labels.goodFor}</h2><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{copy.goodFor.map((signal: any) => <div class="rounded-xl border border-warm-200 p-5 dark:border-warm-700"><p class="font-ui text-body-sm font-bold">{labels.occasions[signal.occasion]}</p><p class="my-1 font-heading text-xl text-brand-wine-text dark:text-brand-rose">{labels.assessments[signal.assessment]}</p><p>{signal.reason}</p></div>)}</div></section>
    <div class="grid gap-x-16 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]">
      <div>
        {[[labels.room, copy.room], [labels.drink, copy.whatToDrink], [labels.order, copy.whatToOrder], [labels.cost, copy.realCost]].map(([heading, body]) => <section class={sectionClass}><h2 class="mb-4 text-heading-2">{heading}</h2><p class="text-body-lg leading-relaxed">{body}</p></section>)}
        <section class={sectionClass}><h2 class="mb-4 text-heading-2">{labels.note}</h2><blockquote class="border-l-4 border-brand-rose pl-6 text-body-lg italic"><p>{copy.reportersNote.text}</p><footer class="mt-4 font-ui text-body-sm not-italic">— {copy.reportersNote.byline}</footer></blockquote></section>
        <section class={sectionClass}><h2 class="mb-4 text-heading-2">{labels.booking}</h2><p class="text-body-lg leading-relaxed">{copy.beforeYouGo}</p></section>
        {copy.meetTheChef && <section class={sectionClass}><h2 class="mb-4 text-heading-2">{labels.chef}: {copy.meetTheChef.name}</h2><p class="mb-3 font-ui text-body-sm text-warm-500">{copy.meetTheChef.role}</p><p class="text-body-lg leading-relaxed">{copy.meetTheChef.text}</p></section>}
        {copy.nearbyPlans && <section class={sectionClass}><h2 class="mb-4 text-heading-2">{labels.nearby}: {copy.nearbyPlans.title}</h2><p class="text-body-lg leading-relaxed">{copy.nearbyPlans.text}</p></section>}
        {copy.contributorRecipe && <section class={sectionClass}><h2 class="mb-4 text-heading-2">{labels.recipe}: {copy.contributorRecipe.title}</h2><p class="mb-3 font-ui text-body-sm font-semibold">{copy.contributorRecipe.contributorName} · {labels.source}: {copy.contributorRecipe.source}</p><p class="text-body-lg leading-relaxed">{copy.contributorRecipe.text}</p></section>}
      </div>
      <aside class="lg:pt-10"><div class="sticky top-24 rounded-2xl bg-warm-100 p-6 dark:bg-warm-900"><h2 class="mb-5 text-heading-3">{labels.essentials}</h2><dl class="space-y-4">{[[labels.address, copy.essentials.address], [labels.reservation, copy.essentials.booking], [labels.access, copy.essentials.access], [labels.duration, copy.essentials.duration], [labels.cost, copy.essentials.cost], [labels.timing, copy.essentials.timing]].map(([term, detail]) => <div><dt class="font-ui text-caption font-bold uppercase tracking-wider text-warm-500">{term}</dt><dd class="mt-1">{detail}</dd></div>)}</dl><a href={spot.mapUrl} rel="noopener noreferrer" class="btn btn-outline-brand mt-6">{labels.map}</a></div></aside>
    </div>
    <section class={sectionClass}><h2 class="mb-5 text-heading-2">{labels.freshness}</h2><dl class="grid gap-5 sm:grid-cols-3">{[[labels.visited, spot.freshness.visited], [labels.published, spot.freshness.published], [labels.checked, spot.freshness.lastChecked]].map(([term, value]) => <div><dt class="font-ui text-caption font-bold uppercase tracking-wider text-warm-500">{term}</dt><dd>{formatDate(value)}</dd></div>)}</dl>{copy.materialUpdates.length > 0 && <div class="mt-8"><h3 class="mb-3 text-heading-3">{labels.updates}</h3><ul class="space-y-3">{copy.materialUpdates.map((update: any) => <li><time datetime={update.date} class="font-ui font-bold">{formatDate(update.date)}</time> — {update.note}</li>)}</ul></div>}</section>
    <footer class="mb-10 rounded-2xl border border-warm-200 p-6 dark:border-warm-700"><p class="font-ui text-caption font-bold uppercase tracking-wider text-warm-500">{labels.disclosure}</p><p class="mt-2">{copy.paymentDisclosure}</p><p class="mt-5 font-ui text-body-sm font-semibold">{spot.reporterByline}</p></footer>
  </article>
</BaseLayout>
