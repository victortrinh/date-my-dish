---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import RestaurantDateSpotSchema from "@components/RestaurantDateSpotSchema.astro";
import { getReviewLocalizedPath, type Locale } from "@i18n/utils";

interface Props { spot: CollectionEntry<"dateSpots">; locale: Locale; }
const { spot, locale } = Astro.props;
const copy = spot.data.locales[locale === "fr" ? "fr-CA" : "en"];
const fr = locale === "fr";
const label = (en: string, french: string) => fr ? french : en;
const verdicts = fr ? { favourite: "Un coup de cœur", conditional: "Ça dépend de la soirée", pass: "Pas notre premier choix" } : { favourite: "A Favourite", conditional: "Depends on the Night", pass: "Not Our First Pick" };
const occasions = fr ? { "first-date": "Premier rendez-vous", anniversary: "Anniversaire", "casual-midweek": "Soir de semaine", "impressing-a-cook": "Impressionner un cuisinier", "double-date": "Double rendez-vous", "solo-at-the-bar": "Solo au bar" } : { "first-date": "First date", anniversary: "Anniversary", "casual-midweek": "Casual midweek", "impressing-a-cook": "Impressing a cook", "double-date": "Double date", "solo-at-the-bar": "Solo at the bar" };
const assessments = fr ? { ideal: "Idéal", caveat: "Avec une réserve", "not-for": "Pas le bon choix" } : { ideal: "Ideal", caveat: "With a caveat", "not-for": "Not the one for" };
const formatDate = (value: string) => new Intl.DateTimeFormat(fr ? "fr-CA" : "en-CA", { year: "numeric", month: "long", day: "numeric" }).format(new Date(`${value}T12:00:00`));
const path = getReviewLocalizedPath(locale, copy.slug);
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} canonical={path} ogImage={spot.data.image.src} translationSlug={spot.data.locales[fr ? "en" : "fr-CA"].slug} ogType="article" publishDate={new Date(`${spot.data.freshness.published}T12:00:00`)} updatedDate={new Date(`${spot.data.freshness.lastChecked}T12:00:00`)} contentType="review">
  <RestaurantDateSpotSchema slot="head" spot={spot} locale={locale} />
  <article class="mx-auto max-w-content px-4 py-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
    <Breadcrumbs locale={locale} items={[{ label: label("Reviews", "Critiques"), href: fr ? "/fr/critiques/" : "/en/reviews/" }, { label: spot.data.name }]} />
    <header class="mx-auto mb-12 grid max-w-content gap-8 lg:grid-cols-2 lg:items-end"><div><p class="mb-3 font-ui text-xs font-bold uppercase tracking-[0.18em] text-brand-wine">{label("Restaurant", "Restaurant")} · {spot.data.neighbourhood}, {spot.data.city}</p><h1 class="font-heading text-4xl italic text-warm-900 dark:text-warm-100 sm:text-display">{copy.title}</h1><p class="mt-5 max-w-prose font-body text-body-lg text-warm-600 dark:text-warm-400">{copy.opening}</p></div><figure><img src={spot.data.image.src} width={spot.data.image.width} height={spot.data.image.height} alt={copy.imageAlt} class="h-[420px] w-full rounded-2xl object-cover" loading="eager" />{copy.imageCaption && <figcaption class="mt-2 text-xs text-warm-500 dark:text-warm-400">{copy.imageCaption}</figcaption>}</figure></header>
    <div class="mx-auto grid max-w-content gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(16rem,1fr)]"><div class="space-y-12">
      <section aria-labelledby="verdict"><p class="font-ui text-xs font-bold uppercase tracking-[0.18em] text-brand-wine">{label("Our verdict", "Notre verdict")}</p><h2 id="verdict" class="mt-2 font-heading text-3xl text-warm-900 dark:text-warm-100">{verdicts[spot.data.reviewVerdict]}</h2><p class="mt-3 text-lg leading-relaxed text-warm-700 dark:text-warm-300">{copy.verdictReason}</p></section>
      <section aria-labelledby="good-for"><h2 id="good-for" class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("Good for", "Bon pour")}</h2><div class="mt-4 grid gap-3 sm:grid-cols-2">{copy.goodFor.map((signal) => <div class="rounded-xl border border-warm-200 p-4 dark:border-warm-700"><p class="font-ui text-xs font-bold uppercase tracking-wide text-brand-wine">{assessments[signal.assessment]} · {occasions[signal.occasion]}</p><p class="mt-2 text-sm leading-relaxed text-warm-700 dark:text-warm-300">{signal.reason}</p></div>)}</div></section>
      <section class="grid gap-8 md:grid-cols-2"><div><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("The room", "La salle")}</h2><p class="mt-3 leading-relaxed text-warm-700 dark:text-warm-300">{copy.room}</p></div><div><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("What to drink", "À boire")}</h2><p class="mt-3 leading-relaxed text-warm-700 dark:text-warm-300">{copy.whatToDrink}</p></div></section>
      <section><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("What to order", "À commander")}</h2><p class="mt-3 leading-relaxed text-warm-700 dark:text-warm-300">{copy.whatToOrder}</p></section>
      <section><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("The real cost", "Le vrai coût")}</h2><p class="mt-3 leading-relaxed text-warm-700 dark:text-warm-300">{copy.realCost}</p></section>
      <section class="border-l-4 border-brand-wine pl-5"><h2 class="font-heading text-2xl text-warm-900 dark:text-warm-100">{label("Reporter’s note", "Note du reporter")}</h2><p class="mt-3 italic leading-relaxed text-warm-700 dark:text-warm-300">{copy.reportersNote.text}</p><p class="mt-3 font-ui text-sm font-semibold text-warm-800 dark:text-warm-200">— {copy.reportersNote.byline}</p></section>
      {copy.meetChef && <section><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("Meet the chef", "Rencontrer le chef")}</h2><p class="mt-3 font-ui text-sm font-semibold text-warm-800 dark:text-warm-200">{copy.meetChef.name} · {copy.meetChef.role}</p><p class="mt-2 leading-relaxed text-warm-700 dark:text-warm-300">{copy.meetChef.reporting}</p></section>}
      {copy.nearbyPlans && <section><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("Nearby plans", "À proximité")}</h2><div class="mt-4 space-y-3">{copy.nearbyPlans.map((plan) => <div><h3 class="font-ui font-semibold text-warm-800 dark:text-warm-200">{plan.name}</h3><p class="text-warm-700 dark:text-warm-300">{plan.detail}</p>{plan.mapUrl && <a class="text-sm text-brand-wine underline" href={plan.mapUrl}>{label("View map", "Voir la carte")}</a>}</div>)}</div></section>}
      {copy.contributorRecipe && <section><h2 class="font-heading text-3xl text-warm-900 dark:text-warm-100">{label("Contributor recipe", "Recette du collaborateur")}</h2><h3 class="mt-3 font-ui font-semibold text-warm-800 dark:text-warm-200">{copy.contributorRecipe.title}</h3><p class="mt-1 text-warm-700 dark:text-warm-300">{copy.contributorRecipe.contributor} · {copy.contributorRecipe.source}</p>{copy.contributorRecipe.testingNotes && <p class="mt-2 text-warm-700 dark:text-warm-300">{copy.contributorRecipe.testingNotes}</p>}</section>}
    </div><aside class="h-fit rounded-2xl border border-warm-200 bg-warm-50 p-6 dark:border-warm-700 dark:bg-warm-900"><h2 class="font-heading text-2xl text-warm-900 dark:text-warm-100">{label("Before you go", "Avant d’y aller")}</h2><dl class="mt-5 space-y-4 text-sm"><div><dt class="font-medium text-warm-500">{label("Booking", "Réservation")}</dt><dd class="text-warm-800 dark:text-warm-200">{copy.essentials.booking}</dd></div><div><dt class="font-medium text-warm-500">{label("Access", "Accès")}</dt><dd class="text-warm-800 dark:text-warm-200">{copy.essentials.access}</dd></div><div><dt class="font-medium text-warm-500">{label("Duration", "Durée")}</dt><dd class="text-warm-800 dark:text-warm-200">{copy.essentials.duration}</dd></div><div><dt class="font-medium text-warm-500">{label("Timing", "Moment")}</dt><dd class="text-warm-800 dark:text-warm-200">{copy.essentials.timing}</dd></div><div><dt class="font-medium text-warm-500">{label("The real cost", "Le vrai coût")}</dt><dd class="text-warm-800 dark:text-warm-200">{copy.essentials.cost}</dd></div><div><dt class="font-medium text-warm-500">{label("Disclosure", "Divulgation")}</dt><dd class="text-warm-800 dark:text-warm-200">{copy.paymentDisclosure}</dd></div><div><dt class="font-medium text-warm-500">{label("Reported by", "Reportage par")}</dt><dd class="text-warm-800 dark:text-warm-200">{spot.data.reporterByline}</dd></div></dl><p class="mt-5 border-t border-warm-200 pt-4 text-sm text-warm-700 dark:border-warm-700 dark:text-warm-300">{copy.beforeYouGo}</p><a class="mt-3 inline-block text-sm text-brand-wine underline" href={spot.data.mapUrl}>{label("View map", "Voir la carte")}</a></aside></div>
    <section class="mx-auto mt-12 max-w-content border-t border-warm-200 pt-8 dark:border-warm-700"><h2 class="font-heading text-2xl text-warm-900 dark:text-warm-100">{label("Reporting freshness", "Fraîcheur du reportage")}</h2><dl class="mt-4 grid gap-4 sm:grid-cols-3 text-sm"><div><dt class="font-medium text-warm-500">{label("Visited", "Visité")}</dt><dd>{formatDate(spot.data.freshness.visited)}</dd></div><div><dt class="font-medium text-warm-500">{label("Published", "Publié")}</dt><dd>{formatDate(spot.data.freshness.published)}</dd></div><div><dt class="font-medium text-warm-500">{label("Last checked", "Vérifié")}</dt><dd>{formatDate(spot.data.freshness.lastChecked)}</dd></div></dl>{copy.materialUpdates.length > 0 && <div class="mt-6"><h3 class="font-ui font-semibold text-warm-800 dark:text-warm-200">{label("Updates", "Mises à jour")}</h3><ul class="mt-2 space-y-2">{copy.materialUpdates.map((update) => <li><time class="font-medium" datetime={update.date}>{formatDate(update.date)}</time>: {update.note}</li>)}</ul></div>}</section>
  </article>
</BaseLayout>
