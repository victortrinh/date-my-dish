---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const privacyPath = locale === "fr" ? "/fr/politique-de-confidentialite/" : "/en/privacy-policy/";
---

<div
  id="cookie-consent"
  class="no-print fixed bottom-0 left-0 right-0 z-50 hidden border-t border-gray-200 bg-white p-4 shadow-lg dark:border-neutral-700 dark:bg-neutral-800 sm:p-6"
  role="region"
  aria-label={locale === "fr" ? "Consentement aux cookies" : "Cookie consent"}
  data-accept-text={t(locale, "cookies.accept")}
  data-decline-text={t(locale, "cookies.decline")}
>
  <div class="mx-auto flex max-w-content flex-col items-center gap-3 sm:flex-row sm:justify-between sm:gap-4">
    <p class="text-center font-body text-sm text-gray-600 dark:text-neutral-300 sm:text-left">
      {t(locale, "cookies.message")}
      <a
        href={privacyPath}
        class="ml-1 underline text-brand-primary-text hover:text-brand-primary-dark dark:text-brand-accent dark:hover:text-brand-accent-text"
      >
        {t(locale, "cookies.learnMore")}
      </a>
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="cookie-decline"
        class="rounded-lg border border-gray-300 px-4 py-2 font-ui text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-700"
      >
        {t(locale, "cookies.decline")}
      </button>
      <button
        id="cookie-accept"
        class="rounded-lg bg-brand-primary px-4 py-2 font-ui text-sm font-medium text-white transition-colors hover:bg-brand-primary-dark"
      >
        {t(locale, "cookies.accept")}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var consent = localStorage.getItem('dmd_cookies');
    if (consent === 'accepted') {
      window.__cookiesAccepted = true;
      return;
    }
    if (consent === 'declined') {
      window.__cookiesAccepted = false;
      return;
    }

    window.__cookiesAccepted = false;
    var banner = document.getElementById('cookie-consent');
    if (!banner) return;

    banner.classList.remove('hidden');

    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');

    function hideBanner() {
      banner.classList.add('hidden');
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', function() {
        localStorage.setItem('dmd_cookies', 'accepted');
        window.__cookiesAccepted = true;
        hideBanner();
        window.dispatchEvent(new CustomEvent('cookies-accepted'));
      });
    }

    if (declineBtn) {
      declineBtn.addEventListener('click', function() {
        localStorage.setItem('dmd_cookies', 'declined');
        window.__cookiesAccepted = false;
        hideBanner();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !banner.classList.contains('hidden')) {
        declineBtn.click();
      }
    });
  })();
</script>
