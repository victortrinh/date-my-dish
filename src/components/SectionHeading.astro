---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<div class:list={["mb-10 text-center", className]}>
  <h2 id={id} class="font-heading text-heading-1 font-bold text-warm-900 dark:text-warm-100">
    <slot />
  </h2>
  <div class="mx-auto mt-3 h-1 w-12 rounded-full bg-brand-rose"></div>
</div>
