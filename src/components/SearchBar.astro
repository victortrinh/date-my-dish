---
import { t, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div id="search" data-pagefind-ui data-locale={locale}>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="pagefind-container"></div>
</div>

<script is:inline>
  (function() {
    var loaded = false;
    var container = document.getElementById('pagefind-container');
    var locale = document.getElementById('search')?.dataset?.locale || 'en';

    function loadPagefind() {
      if (loaded) return;
      loaded = true;
      var script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = function() {
        new window.PagefindUI({
          element: '#pagefind-container',
          showSubResults: true,
          filters: { lang: locale },
          translations: locale === 'fr' ? {
            placeholder: 'Rechercher une recette...',
            zero_results: 'Aucun résultat pour [SEARCH_TERM]',
          } : {
            placeholder: 'Search for a recipe...',
            zero_results: 'No results for [SEARCH_TERM]',
          },
        });
        var input = container?.querySelector('input');
        if (input) input.focus();
      };
      script.onerror = function() {
        if (container) {
          container.innerHTML = '<p style="padding:1rem 0;color:#6b7280;">' +
            (locale === 'fr'
              ? 'La recherche nécessite une version compilée. Exécutez <code>npm run build</code> puis <code>npm run preview</code>.'
              : 'Search requires a built site. Run <code>npm run build</code> then <code>npm run preview</code>.') +
            '</p>';
        }
      };
      document.head.appendChild(script);
    }

    // Load immediately — no need to defer on a dedicated search page
    loadPagefind();
  })();
</script>
