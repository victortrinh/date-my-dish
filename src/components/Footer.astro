---
import { t, getLocalizedPath, getCategorySlug, type Locale } from "@i18n/utils";
import { getCollection } from "astro:content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

// Get categories from recipes for dynamic category links
const allRecipes = await getCollection("recipes");
const recipes = allRecipes.filter((r) => r.data.lang === locale);
const CATEGORY_ORDER = ["appetizer", "dinner", "dessert"];
const categories = [...new Set(recipes.flatMap((r) => r.data.recipeCategory))];
categories.sort((a, b) => {
  const ai = CATEGORY_ORDER.indexOf(a);
  const bi = CATEGORY_ORDER.indexOf(b);
  if (ai !== -1 && bi !== -1) return ai - bi;
  if (ai !== -1) return -1;
  if (bi !== -1) return 1;
  return a.localeCompare(b);
});

const recipesPath = locale === "fr" ? "/recettes/" : "/recipes/";
const aboutPath = locale === "fr" ? "/a-propos/" : "/about/";
const categoryBasePath = locale === "fr" ? "/fr/recettes/categorie/" : "/en/recipes/category/";
---

<footer class="no-print mt-auto border-t border-gray-100 bg-gray-200 dark:border-neutral-800 dark:bg-neutral-900">
  <div class="mx-auto max-w-content px-4 py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={getLocalizedPath(locale, "/")} class="flex items-center gap-2 font-handwritten text-2xl text-brand-primary-text no-underline">
          <img src="/favicon.svg" class="h-6 w-6" alt="" width="24" height="24" />
          Date My Dish
        </a>
        <p class="mt-3 text-body-sm text-gray-600 dark:text-neutral-400">
          {t(locale, "footer.madeWith")}
        </p>
        <!-- Social Links -->
        <div class="mt-4 flex gap-3">
          <a href="https://www.instagram.com/datemydishdotcom" target="_blank" rel="noopener noreferrer" class="rounded-lg p-2 text-gray-500 no-underline transition-colors hover:bg-gray-100 hover:text-brand-primary dark:text-neutral-400 dark:hover:bg-neutral-800" aria-label={t(locale, "footer.instagramLabel")}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="mb-4 font-heading text-sm font-bold tracking-wider text-gray-900 dark:text-neutral-100">
          {t(locale, "footer.navigation")}
        </h3>
        <nav class="flex flex-col gap-2.5" aria-label={t(locale, "footer.nav")}>
          <a href={getLocalizedPath(locale, "/")} class="font-ui text-body-sm text-gray-600 no-underline transition-colors hover:text-brand-primary dark:text-neutral-400">
            {t(locale, "nav.home")}
          </a>
          <a href={getLocalizedPath(locale, recipesPath)} class="font-ui text-body-sm text-gray-600 no-underline transition-colors hover:text-brand-primary dark:text-neutral-400">
            {t(locale, "nav.recipes")}
          </a>
          <a href={getLocalizedPath(locale, aboutPath)} class="font-ui text-body-sm text-gray-600 no-underline transition-colors hover:text-brand-primary dark:text-neutral-400">
            {t(locale, "nav.about")}
          </a>
          <a href={getLocalizedPath(locale, "/contact/")} class="font-ui text-body-sm text-gray-600 no-underline transition-colors hover:text-brand-primary dark:text-neutral-400">
            {t(locale, "nav.contact")}
          </a>
        </nav>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="mb-4 font-heading text-sm font-bold tracking-wider text-gray-900 dark:text-neutral-100">
          {t(locale, "footer.categories")}
        </h3>
        <nav class="flex flex-col gap-2.5" aria-label={t(locale, "footer.categoriesNav")}>
          {categories.slice(0, 6).map((cat) => (
            <a
              href={`${categoryBasePath}${locale === "fr" ? getCategorySlug(cat, locale) : cat}/`}
              class="font-ui text-body-sm text-gray-600 no-underline transition-colors hover:text-brand-primary dark:text-neutral-400"
            >
              {t(locale, `categories.${cat}` as any) || cat}
            </a>
          ))}
        </nav>
      </div>

      <!-- Tagline -->
      <div class="flex flex-col justify-between">
        <p aria-hidden="true" class="font-handwritten text-xl text-brand-primary/60 dark:text-brand-primary/40">
          {t(locale, "site.tagline")}
        </p>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 border-t border-gray-200 pt-6 dark:border-neutral-800">
      <p class="text-center text-caption text-gray-600 dark:text-neutral-400">
        &copy; {year} Date My Dish. {t(locale, "footer.copyright")}
      </p>
    </div>
  </div>
</footer>
