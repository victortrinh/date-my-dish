---
import { Picture } from "astro:assets";
import { t, getLocalizedPath, type Locale } from "@i18n/utils";
import authorPhoto from "@assets/images/victor-vu.webp";

interface Props {
  locale: Locale;
  showLink?: boolean;
}

const { locale, showLink = true } = Astro.props;
const aboutPath = locale === "fr" ? "/a-propos/" : "/about/";
---

<section class="rounded-xl bg-neutral-200 p-6 dark:bg-neutral-800/50 sm:p-8">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start sm:gap-6">
    <div class="h-20 w-20 shrink-0 overflow-hidden rounded-full">
      <Picture
        src={authorPhoto}
        alt={t(locale, "author.photoAlt")}
        widths={[80, 160]}
        sizes="80px"
        formats={["avif", "webp"]}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
    <div>
      <h3 class="font-heading text-lg font-bold text-neutral-900 dark:text-neutral-100">Victor Vu</h3>
      <p class="mt-1 text-body-sm text-neutral-600 dark:text-neutral-400">
        {t(locale, "author.bioShort")}
      </p>
      {showLink && (
        <a
          href={getLocalizedPath(locale, aboutPath)}
          class="mt-3 inline-block font-ui text-body-sm font-medium text-brand-primary-text no-underline transition-colors hover:text-brand-accent"
        >
          {t(locale, "author.aboutLink")} &rarr;
        </a>
      )}
    </div>
  </div>
</section>
