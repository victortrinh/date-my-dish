---
import { t, getLocalizedPath, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  showLink?: boolean;
}

const { locale, showLink = true } = Astro.props;
const aboutPath = locale === "fr" ? "/a-propos/" : "/about/";
---

<section class="rounded-xl bg-gray-50 p-6 dark:bg-gray-800/50 sm:p-8">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start sm:gap-6">
    <!-- Author photo — uses a simple avatar placeholder until real photo is added -->
    <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-brand-primary/10 text-2xl font-bold text-brand-primary">
      V
    </div>
    <div>
      <h3 class="font-heading text-lg font-bold text-gray-900 dark:text-gray-100">Victor</h3>
      <p class="mt-1 text-body-sm text-gray-600 dark:text-gray-400">
        {t(locale, "author.bioShort")}
      </p>
      {showLink && (
        <a
          href={getLocalizedPath(locale, aboutPath)}
          class="mt-3 inline-block font-ui text-body-sm font-medium text-brand-primary-text no-underline transition-colors hover:text-brand-accent"
        >
          {t(locale, "author.aboutLink")} &rarr;
        </a>
      )}
    </div>
  </div>
</section>
