---
import { t, getLocalizedPath, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  showLink?: boolean;
}

const { locale, showLink = true } = Astro.props;
const aboutPath = locale === "fr" ? "/a-propos/" : "/about/";
---

<section class="rounded-xl bg-warm-200 p-6 dark:bg-warm-800/50 sm:p-8">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start sm:gap-6">
    <div>
      <h3 class="font-heading text-lg font-normal text-warm-900 dark:text-warm-100">Victor Vu</h3>
      {showLink && (
        <a
          href={getLocalizedPath(locale, aboutPath)}
          class="mt-3 inline-block font-ui text-body-sm font-medium text-brand-wine-text no-underline transition-colors hover:text-brand-rose"
        >
          {t(locale, "author.aboutLink")} &rarr;
        </a>
      )}
    </div>
  </div>
</section>
