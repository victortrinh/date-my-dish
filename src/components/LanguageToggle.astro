---
import { t, getAlternateUrl, getRecipeLocalizedPath, getArticleLocalizedPath, getReviewLocalizedPath, getDateSpotLocalizedPath, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  /** For content pages: the slug of the translation pair */
  translationSlug?: string;
  contentType?: "recipe" | "article" | "review" | "date-spot";
  alternatePath?: string;
}

const { locale, translationSlug, contentType, alternatePath } = Astro.props;

const targetLocale: Locale = locale === "en" ? "fr" : "en";

let toggleUrl: string;
if (alternatePath) {
  toggleUrl = alternatePath;
} else if (translationSlug && contentType) {
  if (contentType === "recipe") {
    toggleUrl = getRecipeLocalizedPath(targetLocale, translationSlug);
  } else if (contentType === "review") {
    toggleUrl = getReviewLocalizedPath(targetLocale, translationSlug);
  } else if (contentType === "date-spot") {
    toggleUrl = getDateSpotLocalizedPath(targetLocale, translationSlug);
  } else {
    toggleUrl = getArticleLocalizedPath(targetLocale, translationSlug);
  }
} else {
  toggleUrl = getAlternateUrl(Astro.url, targetLocale);
}
---

<a
  href={toggleUrl}
  class="inline-flex h-10 items-center rounded-full px-3 font-ui text-caption font-semibold tracking-[0.14em] text-ink-muted no-underline transition-colors duration-(--duration-quick) hover:bg-surface-sunken hover:text-ink"
  aria-label={t(locale, "lang.switchTo")}
  hreflang={targetLocale}
>
  {targetLocale === "fr" ? "FR" : "EN"}
</a>
