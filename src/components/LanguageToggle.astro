---
import { t, getAlternateUrl, getRecipeLocalizedPath, getArticleLocalizedPath, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
  /** For content pages: the slug of the translation pair */
  translationSlug?: string;
  contentType?: "recipe" | "article";
}

const { locale, translationSlug, contentType } = Astro.props;

const targetLocale: Locale = locale === "en" ? "fr" : "en";

let toggleUrl: string;
if (translationSlug && contentType) {
  if (contentType === "recipe") {
    toggleUrl = getRecipeLocalizedPath(targetLocale, translationSlug);
  } else {
    toggleUrl = getArticleLocalizedPath(targetLocale, translationSlug);
  }
} else {
  toggleUrl = getAlternateUrl(Astro.url, targetLocale);
}
---

<a
  href={toggleUrl}
  class="inline-flex items-center rounded-full border border-warm-200 dark:border-warm-600 px-2.5 py-1 font-ui text-xs font-medium text-warm-600 dark:text-warm-400 no-underline transition-colors hover:border-brand-wine hover:text-brand-wine"
  aria-label={t(locale, "lang.switchTo")}
>
  {locale === "en" ? "EN/FR" : "FR/EN"}
</a>
