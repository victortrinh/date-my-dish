---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import DateSpotCard from "./DateSpotCard.astro";
import { t, type Locale } from "@i18n/utils";
import { DATE_SPOT_CATEGORIES, spotCategory, type Verdict } from "@utils/date-spots";

interface Props {
  spots: CollectionEntry<"dateSpots">[];
  locale: Locale;
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
  /** Neighbourhood guides group spots under a heading per category (reviews first). */
  groupByCategory?: boolean;
  alternatePath?: string;
}
const { spots, locale, title, description = t(locale, "seo.homeDescription"), breadcrumbs = [{ label: title }], groupByCategory = false, alternatePath } = Astro.props;
const ordered = [...spots].sort((a, b) => b.data.freshness.published.localeCompare(a.data.freshness.published));
const verdicts: Verdict[] = ["favourite", "conditional", "pass"];
const present = verdicts.filter((verdict) => ordered.some(({ data }) => data.reviewVerdict === verdict));
const groups = groupByCategory
  ? [
      { id: "reviews", label: t(locale, "nav.venueReviews"), items: ordered.filter(({ data }) => !spotCategory(data)) },
      ...DATE_SPOT_CATEGORIES.map((category) => ({ id: category, label: t(locale, `dateSpot.category.${category}`), items: ordered.filter(({ data }) => spotCategory(data) === category) })),
    ].filter((group) => group.items.length > 0)
  : [{ id: "all", label: "", items: ordered }];
---
<BaseLayout title={`${title} | Date My Dish`} description={description} noindex={spots.length === 0} alternatePath={alternatePath}>
  <section data-pagefind-ignore={spots.length === 0 || undefined} class="mx-auto max-w-content px-4 py-section">
    <Breadcrumbs locale={locale} items={breadcrumbs} />
    <h1 class="my-8 font-heading text-4xl text-warm-900 dark:text-warm-100">{title}</h1>
    {present.length > 1 && <div class="no-print mb-8 bg-warm-100 p-5 dark:bg-warm-900" data-verdict-filter>
      <p id="verdict-filter-label" class="mb-3 font-ui text-caption font-bold uppercase tracking-wider text-warm-500 dark:text-warm-400">{t(locale, "dateSpot.filterByTake")}</p>
      <div role="group" aria-labelledby="verdict-filter-label" class="flex flex-wrap gap-2.5 font-ui text-body-sm font-semibold">
        <button type="button" data-filter="all" aria-pressed="true" class="border-[1.5px] border-warm-400 px-4 py-2 text-warm-800 aria-pressed:bg-warm-800 aria-pressed:text-white dark:text-warm-200 dark:aria-pressed:bg-warm-200 dark:aria-pressed:text-warm-950">{t(locale, "dateSpot.filterAll")}</button>
        {present.map((verdict) => <button type="button" data-filter={verdict} aria-pressed="false" class="border-[1.5px] border-brand-wine px-4 py-2 text-brand-wine-text aria-pressed:bg-brand-wine aria-pressed:text-white dark:border-brand-rose dark:text-brand-rose dark:aria-pressed:bg-brand-rose dark:aria-pressed:text-warm-950">{t(locale, `dateSpot.verdict.${verdict}`)}</button>)}
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>
    </div>}
    {groups.map((group) => (
      <section id={group.id} data-filter-group class="mb-12 scroll-mt-20">
        {group.label && <h2 class="mb-5 font-heading text-heading-2 text-warm-900 dark:text-warm-100">{group.label}</h2>}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{group.items.map((spot) => <DateSpotCard spot={spot} locale={locale} />)}</div>
      </section>
    ))}
  </section>
</BaseLayout>
<script is:inline>
  (function () {
    var root = document.querySelector("[data-verdict-filter]");
    if (!root) return;
    var buttons = root.querySelectorAll("button[data-filter]");
    var status = root.querySelector("[data-filter-status]");
    function apply(value) {
      var shown = 0;
      document.querySelectorAll("article[data-verdict]").forEach(function (card) {
        var match = value === "all" || card.getAttribute("data-verdict") === value;
        card.hidden = !match;
        if (match) shown += 1;
      });
      document.querySelectorAll("[data-filter-group]").forEach(function (group) {
        group.hidden = !group.querySelector("article[data-verdict]:not([hidden])");
      });
      buttons.forEach(function (button) { button.setAttribute("aria-pressed", String(button.getAttribute("data-filter") === value)); });
      if (status) status.textContent = String(shown);
    }
    buttons.forEach(function (button) {
      button.addEventListener("click", function () { apply(button.getAttribute("data-filter")); });
    });
  })();
</script>
