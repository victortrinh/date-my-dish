---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import DateSpotCard from "./DateSpotCard.astro";
import { t, type Locale } from "@i18n/utils";
import { BOROUGHS, DATE_SPOT_CATEGORIES, neighbourhoodSlug, spotCategory, type Verdict } from "@utils/date-spots";

interface Props {
  spots: CollectionEntry<"dateSpots">[];
  locale: Locale;
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
  /** Group spots under a heading per category (reviews first, on neighbourhood guides). */
  groupByCategory?: boolean;
  alternatePath?: string;
  /** Shown, as a link, when the listing has nothing published yet. */
  empty?: { label: string; href: string };
}
const { spots, locale, title, description = t(locale, "seo.homeDescription"), breadcrumbs = [{ label: title }], groupByCategory = false, alternatePath, empty } = Astro.props;
const ordered = [...spots].sort((a, b) => b.data.freshness.published.localeCompare(a.data.freshness.published));
const verdicts: Verdict[] = ["favourite", "conditional", "pass"];
const present = verdicts.filter((verdict) => ordered.some(({ data }) => data.reviewVerdict === verdict));
const boroughs = BOROUGHS.filter((borough) => ordered.some(({ data }) => data.borough === borough));
const buttonClass = "border-[1.5px] border-brand-wine px-4 py-2 text-brand-wine-text aria-pressed:bg-brand-wine aria-pressed:text-white dark:border-brand-rose dark:text-brand-rose dark:aria-pressed:bg-brand-rose dark:aria-pressed:text-warm-950";
const allClass = "border-[1.5px] border-warm-400 px-4 py-2 text-warm-800 aria-pressed:bg-warm-800 aria-pressed:text-white dark:text-warm-200 dark:aria-pressed:bg-warm-200 dark:aria-pressed:text-warm-950";
const filters = [
  ...(present.length > 1 ? [{ key: "verdict", label: t(locale, "dateSpot.filterByTake"), options: present.map((verdict) => ({ value: verdict, label: t(locale, `dateSpot.verdict.${verdict}`) })) }] : []),
  ...(boroughs.length > 1 ? [{ key: "borough", label: t(locale, "dateSpot.filterByBorough"), options: boroughs.map((borough) => ({ value: neighbourhoodSlug(borough), label: borough })) }] : []),
];
const groups = groupByCategory
  ? [
      { id: "reviews", label: t(locale, "nav.venueReviews"), items: ordered.filter(({ data }) => !spotCategory(data)) },
      ...DATE_SPOT_CATEGORIES.map((category) => ({ id: category, label: t(locale, `dateSpot.category.${category}`), items: ordered.filter(({ data }) => spotCategory(data) === category) })),
    ].filter((group) => group.items.length > 0)
  : [{ id: "all", label: "", items: ordered }];
---
<BaseLayout title={`${title} | Date My Dish`} description={description} noindex={spots.length === 0} alternatePath={alternatePath}>
  <section data-pagefind-ignore={spots.length === 0 || undefined} class="mx-auto max-w-content px-4 py-section">
    <Breadcrumbs locale={locale} items={breadcrumbs} />
    <h1 class="my-8 font-heading text-4xl text-warm-900 dark:text-warm-100">{title}</h1>
    {filters.length > 0 && <div class="no-print mb-8 space-y-5 bg-warm-100 p-5 dark:bg-warm-900" data-spot-filters>
      {filters.map((filter) => (
        <div data-filter-key={filter.key}>
          <p id={`${filter.key}-filter-label`} class="mb-3 font-ui text-caption font-bold uppercase tracking-wider text-warm-500 dark:text-warm-400">{filter.label}</p>
          <div role="group" aria-labelledby={`${filter.key}-filter-label`} class="flex flex-wrap gap-2.5 font-ui text-body-sm font-semibold">
            <button type="button" data-filter="all" aria-pressed="true" class={allClass}>{t(locale, "dateSpot.filterAll")}</button>
            {filter.options.map((option) => <button type="button" data-filter={option.value} aria-pressed="false" class={buttonClass}>{option.label}</button>)}
          </div>
        </div>
      ))}
      <p class="sr-only" aria-live="polite" data-filter-status></p>
    </div>}
    {spots.length === 0 && empty && <p class="mb-12"><a href={empty.href} class="font-semibold text-brand-wine-text underline dark:text-brand-rose">{empty.label}</a></p>}
    {groups.map((group) => (
      <section id={group.id} data-filter-group class="mb-12 scroll-mt-20">
        {group.label && <h2 class="mb-5 font-heading text-heading-2 text-warm-900 dark:text-warm-100">{group.label}</h2>}
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{group.items.map((spot) => <DateSpotCard spot={spot} locale={locale} />)}</div>
      </section>
    ))}
  </section>
</BaseLayout>
<script is:inline>
  (function () {
    var root = document.querySelector("[data-spot-filters]");
    if (!root) return;
    var status = root.querySelector("[data-filter-status]");
    var active = {};
    function apply() {
      var shown = 0;
      document.querySelectorAll("article[data-verdict]").forEach(function (card) {
        var match = Object.keys(active).every(function (key) {
          return active[key] === "all" || card.getAttribute("data-" + key) === active[key];
        });
        card.hidden = !match;
        if (match) shown += 1;
      });
      document.querySelectorAll("[data-filter-group]").forEach(function (group) {
        group.hidden = !group.querySelector("article[data-verdict]:not([hidden])");
      });
      if (status) status.textContent = String(shown);
    }
    root.querySelectorAll("[data-filter-key]").forEach(function (filter) {
      var key = filter.getAttribute("data-filter-key");
      var buttons = filter.querySelectorAll("button[data-filter]");
      active[key] = "all";
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          active[key] = button.getAttribute("data-filter");
          buttons.forEach(function (other) { other.setAttribute("aria-pressed", String(other === button)); });
          apply();
        });
      });
    });
  })();
</script>
