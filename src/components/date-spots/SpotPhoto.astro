---
import PinButton from "./PinButton.astro";
import { tf, type Locale } from "@i18n/utils";
import { pinFor } from "@utils/pinterest";

// A keyed photo from a Date Spot's `photos`, with its per-locale alt text.
// Every photograph in a post below the hero keeps its own proportions,
// uncropped, in a square-cornered frame (DESIGN.md, `.arch`): dish shots,
// the room and portraits alike. It takes the full width on a phone; the
// caller caps it from `sm`. The arch and its 4:5 crop stay with the hero. The photo links to its viewer copy (`large`) or its
// own file, which the photo viewer (`PhotoViewer.astro`) opens full screen
// and uncropped; Pinterest's Save button, which pins the same file, sits
// over its corner.
interface Photo { src: string; width: number; height: number; large?: string; credit?: string; }
interface Props { photos?: Record<string, Photo>; reference: { photo: string; alt: string }; locale: Locale; class?: string; }
const { photos, reference, locale, class: className } = Astro.props;
const photo = photos?.[reference.photo];
const pin = photo ? pinFor(Astro, photo.large ?? photo.src, `${reference.alt} | Date My Dish`) : "";
---
{photo && <figure class:list={["group relative", className]}>
  <a href={photo.large ?? photo.src} data-photo-viewer data-pin={pin} aria-label={tf(locale, "dateSpot.viewPhoto", { alt: reference.alt })} class="block cursor-zoom-in rounded-sm">
    <img src={photo.src} width={photo.width} height={photo.height} alt={reference.alt} loading="lazy" class="h-auto w-full rounded-sm bg-surface-sunken" />
  </a>
  <PinButton href={pin} locale={locale} />
  {photo.credit && <figcaption class="mt-2 font-ui text-caption text-ink-subtle">{tf(locale, "dateSpot.photoCredit", { credit: photo.credit })}</figcaption>}
</figure>}
