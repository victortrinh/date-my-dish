---
import PinButton from "./PinButton.astro";
import { tf, type Locale } from "@i18n/utils";
import { pinFor } from "@utils/pinterest";

// A keyed photo from a Date Spot's `photos`, with its per-locale alt text.
// Every photograph in a post below the hero sits in a square-cornered frame
// at 4:5, cropped from the centre (DESIGN.md, `.arch`): dish shots, the
// room and portraits alike, whatever the original's orientation. The arch
// stays with the hero. The photo links to its file, which the photo viewer
// (`PhotoViewer.astro`) opens full screen and uncropped; Pinterest's Save
// button sits over its corner.
interface Photo { src: string; width: number; height: number; credit?: string; }
interface Props { photos?: Record<string, Photo>; reference: { photo: string; alt: string }; locale: Locale; class?: string; }
const { photos, reference, locale, class: className } = Astro.props;
const photo = photos?.[reference.photo];
const pin = photo ? pinFor(Astro, photo.src, `${reference.alt} | Date My Dish`) : "";
---
{photo && <figure class:list={["group relative", className]}>
  <a href={photo.src} data-photo-viewer data-pin={pin} aria-label={tf(locale, "dateSpot.viewPhoto", { alt: reference.alt })} class="block cursor-zoom-in rounded-sm">
    <img src={photo.src} width={photo.width} height={photo.height} alt={reference.alt} loading="lazy" class="aspect-[4/5] w-full rounded-sm bg-surface-sunken object-cover object-center" />
  </a>
  <PinButton href={pin} locale={locale} />
  {photo.credit && <figcaption class="mt-2 font-ui text-caption text-ink-subtle">{tf(locale, "dateSpot.photoCredit", { credit: photo.credit })}</figcaption>}
</figure>}
