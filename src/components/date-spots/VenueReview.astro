---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import VenueReviewSchema from "./VenueReviewSchema.astro";
import EssentialsCard from "./EssentialsCard.astro";
import Paragraphs from "./Paragraphs.astro";
import SignalIcon from "./SignalIcon.astro";
import SpotHero from "./SpotHero.astro";
import SpotPhoto from "./SpotPhoto.astro";
import VerdictBadge from "./VerdictBadge.astro";
import WindowGlyph from "./WindowGlyph.astro";
import { t, tf, type Locale } from "@i18n/utils";
import { makeANightCards } from "@content-contracts/date-spot.mjs";
import {
  copyLocale, dateSpotPath, neighbourhoodPath, priceLabel, profilePath, recipeCardPath, reviewPath,
  sameCategoryNearby, isVenueReview, type VenueReview,
} from "@utils/date-spots";

// One template for both review Spot Types. Sections run in the order of the
// review design: the answer first, then the room, the people, the drinks,
// the food, the money, my note, the rest of the evening, and planning.
// Everything after the verdict and the essentials is an Optional Section:
// with no content it renders nothing, not even its heading.
interface Props { spot: VenueReview; locale: Locale; }
const { spot, locale } = Astro.props;
const copy = spot.locales[copyLocale(locale)];
const other: Locale = locale === "fr" ? "en" : "fr";
const isBar = spot.spotType === "bar";
const lead = "meetChef" in copy ? copy.meetChef : "meetTheBartender" in copy ? copy.meetTheBartender : undefined;
const whatToOrder = "whatToOrder" in copy ? copy.whatToOrder : undefined;
const whatToEat = "whatToEat" in copy ? copy.whatToEat : undefined;
const dishes = whatToOrder?.dishes ?? whatToEat?.dishes ?? [];
const hasOrder = Boolean(whatToOrder || whatToEat);
const name = spot.name;
const neighbourhood = spot.neighbourhood;
const updates = copy.materialUpdates ?? [];
const note = copy.reportersNote;
const hasNote = Boolean(note || updates.length);
const hasRoom = Boolean(copy.room || copy.roomPhoto);

const spots = await getCollection("dateSpots");
const recipes = await getCollection("contributorRecipes");
const profiles = await getCollection("extendedProfiles");
const recipe = copy.atHome && recipes.find(({ data }) => data.id === copy.atHome?.recipeId)?.data;
const recipeCopy = recipe ? recipe.locales[copyLocale(locale)] : undefined;
const profile = lead?.profileId ? profiles.find(({ data }) => data.id === lead.profileId)?.data : undefined;
// Only published Date Spots, in the fixed category order, at most five.
const nightPicks = makeANightCards(copy.makeANight, spots.map(({ data }) => data)).map(({ pick, target, category }) => {
  const nearby = sameCategoryNearby(spots, target).filter(({ data }) => data.neighbourhood === neighbourhood && data.id !== spot.id);
  const targetCopy = target.locales[copyLocale(locale)];
  const season = "season" in targetCopy ? targetCopy.season : undefined;
  return { pick, target, category, nearby: nearby.length, season };
});
const nearbyReviews = spots
  .map(({ data }) => data)
  .filter((data) => data.id !== spot.id && data.city === spot.city && data.neighbourhood === neighbourhood && isVenueReview(data))
  .slice(0, 2);

const monthYear = (value: string) => new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long" }).format(new Date(`${value}T12:00:00`));
const fullDate = (value: string) => new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long", day: "numeric" }).format(new Date(`${value}T12:00:00`));
const path = reviewPath(spot, locale);
const h2 = "scroll-mt-20 text-heading-2 text-ink";
const body = "max-w-measure font-body text-body-lg text-ink-muted";
const textLink = "text-accent-ink underline decoration-1 underline-offset-4";
const actionLink = "link-draw font-ui text-body-sm font-semibold";
const caption = copy.imageCaption ?? copy.imageCredit;
const noteMeta = note ? [
  note.byline,
  note.visits && [note.visits === 1 ? t(locale, "dateSpot.noteVisit") : tf(locale, "dateSpot.noteVisits", { count: note.visits }), spot.freshness.visited && monthYear(spot.freshness.visited)].filter(Boolean).join(", "),
  spot.payment && t(locale, `dateSpot.payment.${spot.payment}`),
].filter(Boolean) : [];
const jump = [
  ["verdict", t(locale, "dateSpot.jump.verdict")],
  ...(copy.goodFor ? [["good-for", t(locale, "dateSpot.jump.goodFor")]] : []),
  ...(hasRoom ? [["room", t(locale, "dateSpot.jump.room")]] : []),
  ...(lead ? [["meet", t(locale, isBar ? "dateSpot.jump.meetBartender" : "dateSpot.jump.meet")]] : []),
  ...(copy.drinks ? [["drinks", t(locale, "dateSpot.jump.drinks")]] : []),
  ...(hasOrder ? [["order", t(locale, isBar ? "dateSpot.jump.eat" : "dateSpot.jump.order")]] : []),
  ...(copy.realCost ? [["cost", t(locale, "dateSpot.jump.cost")]] : []),
  ...(hasNote ? [["note", t(locale, "dateSpot.jump.note")]] : []),
  ...(nightPicks.length ? [["night", t(locale, "dateSpot.jump.night")]] : []),
  ...(recipe ? [["at-home", t(locale, isBar ? "dateSpot.jump.atHomeBartender" : "dateSpot.jump.atHome")]] : []),
  ...(copy.beforeYouBook ? [["before-you-book", isBar ? t(locale, "dateSpot.h.beforeYouGo") : t(locale, "dateSpot.jump.faq")]] : []),
];
---
<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonical={path}
  alternatePath={reviewPath(spot, other)}
  ogImage={spot.image.src}
  ogType="article"
  publishDate={new Date(`${spot.freshness.published}T12:00:00`)}
  updatedDate={new Date(`${spot.freshness.lastChecked}T12:00:00`)}
>
  <VenueReviewSchema slot="head" spot={spot} locale={locale} lead={lead} />
  <article class="page-container pt-8 pb-section-sm" data-pagefind-body data-pagefind-filter={`lang:${locale}`} data-spot-type={spot.spotType}>
    <Breadcrumbs locale={locale} items={[
      { label: t(locale, "nav.venueReviews"), href: locale === "fr" ? "/fr/critiques/" : "/en/reviews/" },
      { label: neighbourhood, href: neighbourhoodPath(neighbourhood, locale) },
      { label: name },
    ]} />

    <SpotHero image={spot.image} alt={copy.imageAlt} caption={caption}>
      <p class="eyebrow truncate">{t(locale, "dateSpot.review")} · {t(locale, `dateSpot.spotType.${spot.spotType}`)} · {copy.cuisine}</p>
      <h1 class="mt-4 text-4xl text-ink sm:text-heading-1 lg:text-display">{name}<span class="text-ink-subtle">, {neighbourhood}</span></h1>
      <p class={`mt-6 ${body}`}>
        {lead && copy.opening.includes(lead.name)
          ? <>{copy.opening.slice(0, copy.opening.indexOf(lead.name))}<a href="#meet" class={textLink}>{lead.name}</a>{copy.opening.slice(copy.opening.indexOf(lead.name) + lead.name.length)}</>
          : copy.opening}
      </p>
      <p class="mt-6 font-ui text-body-sm text-ink-subtle">
        {t(locale, "dateSpot.by")} {spot.reporterByline} · {tf(locale, "dateSpot.published", { date: fullDate(spot.freshness.published) })} · {tf(locale, "dateSpot.checked", { date: monthYear(spot.freshness.lastChecked) })}
      </p>
    </SpotHero>

    <div class="mt-section-sm grid grid-cols-[minmax(0,1fr)] gap-16 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0 space-y-section-sm">
        <section id="verdict" aria-labelledby="verdict-title" class="scroll-mt-20 border-t border-line-strong pt-8">
          <h2 id="verdict-title" class="font-ui text-body-sm font-medium text-ink-subtle">{tf(locale, "dateSpot.h.verdict", { name })}</h2>
          <VerdictBadge verdict={spot.reviewVerdict} locale={locale} size="lg" class="mt-4" />
          {copy.verdictHeadline && <p class="mt-5 max-w-measure font-display text-heading-2 text-ink">{copy.verdictHeadline}</p>}
          <div class={`mt-5 space-y-5 ${body}`}><Paragraphs text={copy.verdictReason} /></div>
        </section>

        <EssentialsCard spot={spot} locale={locale} id="essentials-title-mobile" class="lg:hidden" />

        {copy.goodFor && <section id="good-for" aria-labelledby="good-for-title" class="scroll-mt-20">
          <h2 id="good-for-title" class={h2}>{t(locale, "dateSpot.h.goodFor")}</h2>
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {copy.goodFor.map((signal) => (
              <li class="flex gap-4 py-5">
                <SignalIcon assessment={signal.assessment} />
                <div class="min-w-0 flex-1 sm:flex sm:gap-6">
                  <div class="font-ui sm:w-44 sm:shrink-0">
                    <p class="font-semibold text-ink">{t(locale, `dateSpot.occasion.${signal.occasion}`)}</p>
                    <p class:list={["text-body-sm", signal.assessment === "ideal" ? "text-accent-ink" : signal.assessment === "caveat" ? "text-ink-muted" : "text-ink-subtle"]}>{t(locale, `dateSpot.assessment.${signal.assessment}`)}</p>
                  </div>
                  <p class="mt-1 font-body text-ink-muted sm:mt-0">{signal.reason}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>}

        {hasRoom && <section id="room" aria-labelledby="room-title" class="scroll-mt-20">
          <h2 id="room-title" class={h2}>{t(locale, "dateSpot.h.room")}</h2>
          {copy.roomPhoto && <SpotPhoto photos={spot.photos} reference={copy.roomPhoto} locale={locale} class="mt-6 max-w-measure" />}
          {copy.room && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={copy.room} /></div>}
        </section>}

        {lead && <section id="meet" aria-labelledby="meet-title" class="scroll-mt-20">
          <h2 id="meet-title" class={h2}>{t(locale, isBar ? "dateSpot.h.meetBartender" : "dateSpot.h.meetChef")}</h2>
          <div class="mt-6 grid gap-8 sm:grid-cols-[12rem_minmax(0,1fr)]">
            {lead.portrait && <SpotPhoto photos={spot.photos} reference={lead.portrait} locale={locale} arch class="max-w-56" />}
            <div class:list={["space-y-5", !lead.portrait && "sm:col-span-2"]}>
              <p class="font-ui font-semibold text-ink">{lead.name}{lead.role && <> · <span class="font-normal text-ink-subtle">{lead.role}</span></>}</p>
              {lead.background && <div class={`space-y-5 ${body}`}><Paragraphs text={lead.background} /></div>}
            </div>
          </div>
          {lead.quote && <blockquote class="my-10 max-w-measure font-display text-heading-3 text-ink before:mb-5 before:block before:h-0.5 before:w-10 before:bg-accent before:content-['']">“{lead.quote}”</blockquote>}
          {lead.approach && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={lead.approach} /></div>}
          {(recipe || profile) && <div class="mt-6 flex flex-col items-start gap-3">
            {recipe && recipeCopy && <a href={recipeCardPath(recipeCopy.slug, locale)} class={actionLink}>{tf(locale, "dateSpot.chefRecipeCard", { name: lead.name })}</a>}
            {profile && <a href={profilePath(profile.locales[copyLocale(locale)].slug, locale)} class={actionLink}>{tf(locale, "dateSpot.readProfile", { name: lead.name })}</a>}
          </div>}
        </section>}

        {copy.drinks && <section id="drinks" aria-labelledby="drinks-title" class="scroll-mt-20">
          <h2 id="drinks-title" class={h2}>{tf(locale, "dateSpot.h.drinks", { name })}</h2>
          {copy.drinks.intro && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={copy.drinks.intro} /></div>}
          {copy.drinks.picks && <div class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
            {copy.drinks.picks.map((pick) => (
              <div class="border-t border-line pt-4">
                <p class="eyebrow">{t(locale, `dateSpot.drinkMoment.${pick.moment}`)}</p>
                <h3 class="mt-3 text-xl text-ink">{pick.name}</h3>
                {pick.note && <p class="mt-2 font-body text-body-sm text-ink-muted">{pick.note}</p>}
              </div>
            ))}
          </div>}
          {copy.drinks.list && <div class={`mt-8 space-y-5 ${body}`}><Paragraphs text={copy.drinks.list} /></div>}
        </section>}

        {hasOrder && <section id="order" aria-labelledby="order-title" class="scroll-mt-20">
          <h2 id="order-title" class={h2}>{tf(locale, isBar ? "dateSpot.h.eat" : "dateSpot.h.order", { name })}</h2>
          {whatToEat?.intro && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={whatToEat.intro} /></div>}
          {(whatToOrder?.waitersChoice || whatToOrder?.setMenu) && <div class="card mt-6 space-y-6">
            {whatToOrder.waitersChoice && <div>
              <h3 class="text-heading-3 text-ink">{t(locale, "dateSpot.waitersChoice")}</h3>
              <p class={`mt-3 ${body}`}>{whatToOrder.waitersChoice.recommendation}</p>
              {whatToOrder.waitersChoice.outcome && <p class={`mt-3 ${body}`}>{whatToOrder.waitersChoice.outcome}</p>}
            </div>}
            {whatToOrder.setMenu && <div class:list={[whatToOrder.waitersChoice && "border-t border-line pt-6"]}>
              <p class="eyebrow">{t(locale, "dateSpot.setMenu")}</p>
              <p class="mt-3 font-ui font-semibold text-ink">{[
                whatToOrder.setMenu.name,
                whatToOrder.setMenu.courses && tf(locale, "dateSpot.courses", { count: whatToOrder.setMenu.courses }),
                whatToOrder.setMenu.pricePerPerson && `${whatToOrder.setMenu.pricePerPerson} ${t(locale, "dateSpot.perPerson")}`,
              ].filter(Boolean).join(" · ")}</p>
              {whatToOrder.setMenu.note && <p class={`mt-3 ${body}`}>{whatToOrder.setMenu.note}</p>}
              {whatToOrder.setMenu.advice && <p class="mt-4 inline-flex items-center gap-2 font-ui text-eyebrow font-semibold uppercase text-accent-ink"><WindowGlyph state="lit" class="h-4 w-auto" />{t(locale, `dateSpot.setMenuAdvice.${whatToOrder.setMenu.advice}`)}</p>}
            </div>}
          </div>}
          {whatToOrder?.strategy && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={whatToOrder.strategy} /></div>}
          {dishes.length > 0 && <ul class="mt-8 divide-y divide-line border-y border-line">
            {dishes.map((dish) => (
              <li class="grid gap-5 py-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-6">
                {dish.photo ? <SpotPhoto photos={spot.photos} reference={dish.photo} locale={locale} /> : null}
                <div class:list={[!dish.photo && "sm:col-span-2"]}>
                  <h3 class="text-heading-3 text-ink">{dish.name}</h3>
                  <span data-dish-tag={dish.tag} class:list={[
                    "mt-2 inline-flex items-center gap-2 font-ui text-eyebrow font-semibold uppercase",
                    dish.tag === "order-this" && "text-accent-ink",
                    dish.tag === "worth-it" && "text-ink-muted",
                    dish.tag === "skip" && "text-ink-subtle",
                  ]}><WindowGlyph state={dish.tag === "order-this" ? "lit" : dish.tag === "worth-it" ? "half" : "unlit"} class="h-4 w-auto" />{t(locale, `dateSpot.dishTag.${dish.tag}`)}</span>
                  {dish.note && <p class="mt-3 max-w-measure font-body text-ink-muted">{dish.note}</p>}
                </div>
              </li>
            ))}
          </ul>}
        </section>}

        {copy.realCost && <section id="cost" aria-labelledby="cost-title" class="scroll-mt-20">
          <h2 id="cost-title" class={h2}>{tf(locale, isBar ? "dateSpot.h.costBar" : "dateSpot.h.costRestaurant", { name })}</h2>
          {copy.realCost.intro && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={copy.realCost.intro} /></div>}
          {(copy.realCost.lines || copy.realCost.total) && <dl class="mt-6 max-w-measure divide-y divide-line border-y border-line font-ui tabular-nums">
            {(copy.realCost.lines ?? []).map((line) => <div class="flex justify-between gap-4 py-3"><dt class="text-ink-muted">{line.item}</dt><dd class="text-ink">{line.amount}</dd></div>)}
            {copy.realCost.total && <div class="flex justify-between gap-4 border-t border-line-strong py-4 font-semibold"><dt class="text-ink">{copy.realCost.total.label}</dt><dd class="text-ink">{copy.realCost.total.amount}</dd></div>}
          </dl>}
          {copy.realCost.howToSpendLess && <div class={`mt-6 space-y-5 ${body}`}><Paragraphs text={copy.realCost.howToSpendLess} /></div>}
        </section>}

        {hasNote && <section id="note" aria-labelledby="note-title" class="scroll-mt-20 border-t border-line-strong pt-8">
          <h2 id="note-title" class={h2}>{tf(locale, "dateSpot.h.note", { name })}</h2>
          {noteMeta.length > 0 && <p class="mt-3 font-ui text-body-sm text-ink-subtle">{noteMeta.join(" · ")}</p>}
          {(note?.detail || note?.caveat) && <>
            <p class="mt-8 font-body text-body-lg italic text-accent-ink">{t(locale, "dateSpot.noteKicker")}</p>
            <div class={`mt-3 space-y-5 italic ${body}`}><Paragraphs text={note?.detail} /><Paragraphs text={note?.caveat} /></div>
          </>}
          {updates.map((update) => (
            <div class="mt-8 max-w-measure border-t border-line pt-5">
              <p class="eyebrow">{t(locale, "dateSpot.update")} · <time datetime={update.date}>{monthYear(update.date)}</time></p>
              <p class={`mt-3 ${body}`}>{update.note}</p>
            </div>
          ))}
          <p class="mt-10 flex items-center gap-4 font-body text-heading-3 italic text-ink before:block before:h-px before:w-10 before:bg-line-strong before:content-['']">{spot.reporterByline}</p>
          <p class="mt-6 max-w-measure font-ui text-body-sm text-ink-subtle">{t(locale, "dateSpot.correction")} <a href={`/${locale}/contact/`} class={textLink}>{t(locale, "dateSpot.correctionLink")}</a></p>
        </section>}

        {nightPicks.length > 0 && <section id="night" aria-labelledby="night-title" class="scroll-mt-20">
          <p class="eyebrow">{t(locale, isBar ? "dateSpot.nightKickerBar" : "dateSpot.nightKicker")}</p>
          <h2 id="night-title" class={`mt-3 ${h2}`}>{tf(locale, isBar ? "dateSpot.h.nightBar" : "dateSpot.h.nightRestaurant", { neighbourhood })}</h2>
          <p class={`mt-5 ${body}`}>{t(locale, "dateSpot.nightIntro")}</p>
          <div class="mt-8 grid gap-10 sm:grid-cols-2 sm:gap-8">
            {nightPicks.map(({ pick, target, category, nearby, season }) => (
              <div class="flex flex-col border-t border-line pt-5" data-night-pick={target.id} data-category={category}>
                <p class="eyebrow">{t(locale, `dateSpot.category.${category}`)}</p>
                <h3 class="mt-3 text-heading-3"><a href={dateSpotPath(target, locale)} class="link-draw">{target.name}</a></h3>
                <p class="mt-2 font-ui text-body-sm text-ink-subtle">{[
                  pick.timing && t(locale, `dateSpot.timing.${pick.timing}`),
                  pick.walkMinutes && tf(locale, "dateSpot.walk", { minutes: pick.walkMinutes }),
                  target.priceRange && priceLabel(target.priceRange, locale),
                  season,
                ].filter(Boolean).join(" · ")}</p>
                {pick.blurb && <p class="mt-3 flex-1 font-body text-ink-muted">{pick.blurb}</p>}
                {nearby > 0 && <a href={`${neighbourhoodPath(neighbourhood, locale)}#${category}`} class={`mt-4 self-start ${actionLink}`}>{tf(locale, "dateSpot.moreNearby", { count: nearby })}</a>}
              </div>
            ))}
          </div>
          <div class="card mt-10 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-display text-heading-3 text-ink">{t(locale, "dateSpot.wholeEvening")}</p>
              <p class="mt-1 font-ui text-body-sm text-ink-subtle">{tf(locale, "dateSpot.wholeEveningText", { neighbourhood })}</p>
            </div>
            <a href={neighbourhoodPath(neighbourhood, locale)} class="btn btn-secondary shrink-0">{tf(locale, "dateSpot.openGuide", { neighbourhood })}</a>
          </div>
        </section>}

        {recipe && recipeCopy && copy.atHome && <section id="at-home" aria-labelledby="at-home-title" class:list={["card scroll-mt-20 grid gap-8", recipe.image && "sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-center"]}>
          {recipe.image && <img src={recipe.image.src} width={recipe.image.width} height={recipe.image.height} alt={recipeCopy.imageAlt} loading="lazy" class="aspect-[4/5] w-full max-w-56 rounded-arch bg-surface-sunken object-cover" />}
          <div>
            <p class="eyebrow">{tf(locale, "dateSpot.fromKitchen", { name: recipe.contributor.name })}</p>
            <h2 id="at-home-title" class={`mt-3 ${h2}`}>{t(locale, isBar ? "dateSpot.h.atHomeBartender" : "dateSpot.h.atHomeChef")}</h2>
            {copy.atHome.intro && <div class={`mt-5 space-y-5 ${body}`}><Paragraphs text={copy.atHome.intro} /></div>}
            <a href={recipeCardPath(recipeCopy.slug, locale)} class="btn btn-accent mt-6">{tf(locale, "dateSpot.getRecipeCard", { name: recipe.contributor.name })}</a>
          </div>
        </section>}

        {copy.beforeYouBook && <section id="before-you-book" aria-labelledby="faq-title" class="scroll-mt-20">
          <h2 id="faq-title" class={h2}>{t(locale, isBar ? "dateSpot.h.beforeYouGo" : "dateSpot.h.beforeYouBook")}</h2>
          <div class="mt-6 divide-y divide-line border-y border-line">
            {copy.beforeYouBook.map((item) => (
              <div class="py-6">
                <h3 class="text-xl text-ink">{item.question}</h3>
                <div class="mt-3 max-w-measure space-y-4 font-body text-ink-muted"><Paragraphs text={item.answer} /></div>
              </div>
            ))}
          </div>
        </section>}
      </div>

      <aside class="min-w-0 space-y-10 lg:sticky lg:top-24 lg:self-start">
        <EssentialsCard spot={spot} locale={locale} class="hidden lg:block" />
        <nav aria-labelledby="jump-title" class="no-print hidden lg:block">
          <p id="jump-title" class="eyebrow">{t(locale, "dateSpot.jump.title")}</p>
          <ol class="mt-4 space-y-2 font-ui text-body-sm">{jump.map(([id, label]) => <li><a href={`#${id}`} class="link-draw text-ink-muted hover:text-ink">{label}</a></li>)}</ol>
        </nav>
        <div>
          <p class="eyebrow">{tf(locale, "dateSpot.moreIn", { neighbourhood })}</p>
          <ul class="mt-4 space-y-3 font-ui text-body-sm">
            {nearbyReviews.map((review) => <li class="flex items-center justify-between gap-3"><a href={dateSpotPath(review, locale)} class="link-draw">{review.name}</a><VerdictBadge verdict={review.reviewVerdict} locale={locale} /></li>)}
            <li><a href={neighbourhoodPath(neighbourhood, locale)} class={actionLink}>{tf(locale, "dateSpot.eveningIn", { neighbourhood })}</a></li>
          </ul>
        </div>
        <NewsletterSignup locale={locale} compact />
      </aside>
    </div>
  </article>
</BaseLayout>
