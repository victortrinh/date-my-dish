---
import { t, type Locale } from "@i18n/utils";

// The full-screen photo viewer of a post, rendered once per page. A click on
// any photo link marked `data-photo-viewer` (`SpotPhoto.astro`) opens that
// photo here, uncropped, with its alt text as the caption, Pinterest's Save
// button, and previous and next through every photo on the page (buttons,
// arrow keys, a swipe). Escape, the close button or a click outside the
// photo closes it. Without JavaScript the links open the photo file itself.
interface Props { locale: Locale; }
const { locale } = Astro.props;
const iconButton = "btn-icon absolute bg-iron text-on-iron hover:bg-on-iron hover:text-iron";
---
<dialog id="photo-viewer" aria-label={t(locale, "dateSpot.photoViewer")} class="no-print m-0 h-dvh max-h-none w-screen max-w-none bg-iron p-0 text-on-iron backdrop:bg-scrim">
  <button type="button" data-close class:list={[iconButton, "right-4 top-4 z-10"]} aria-label={t(locale, "dateSpot.closePhoto")}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <figure class="flex h-full flex-col items-center gap-4 px-4 pb-6 pt-16 sm:px-20">
    <img alt="" width="720" height="1080" loading="lazy" class="min-h-0 w-full flex-1 object-contain" />
    <figcaption class="max-w-prose text-center font-ui text-caption text-on-iron-muted"></figcaption>
    <a data-pin href="https://www.pinterest.com/" target="_blank" rel="noopener noreferrer" class="btn btn-accent" aria-label={`${t(locale, "share.pinterest")} ${t(locale, "share.opensNewWindow")}`}>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
      {t(locale, "share.pinterest")}
    </a>
  </figure>
  <button type="button" data-step="-1" class:list={[iconButton, "left-2 top-1/2 -translate-y-1/2 sm:left-4"]} aria-label={t(locale, "dateSpot.previousPhoto")}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button type="button" data-step="1" class:list={[iconButton, "right-2 top-1/2 -translate-y-1/2 sm:right-4"]} aria-label={t(locale, "dateSpot.nextPhoto")}>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</dialog>
<script is:inline>
(function(){var d=document.getElementById('photo-viewer'),l=[].slice.call(document.querySelectorAll('[data-photo-viewer]'));if(!d||!d.showModal||!l.length)return;var i=0,x=0,m=d.querySelector('img'),c=d.querySelector('figcaption'),p=d.querySelector('[data-pin]');
function show(n){i=(n+l.length)%l.length;var a=l[i],g=a.querySelector('img');m.width=g.getAttribute('width');m.height=g.getAttribute('height');m.src=a.href;m.alt=c.textContent=g.alt;p.href=a.dataset.pin}
d.querySelectorAll('[data-step]').forEach(function(b){b.hidden=l.length<2});
l.forEach(function(a,n){a.addEventListener('click',function(e){if(e.metaKey||e.ctrlKey||e.shiftKey||e.button)return;e.preventDefault();show(n);d.showModal()})});
d.addEventListener('click',function(e){var b=e.target.closest('[data-step]');if(b)show(i+ +b.dataset.step);else if(e.target.closest('[data-close]')||!e.target.closest('img,a,button'))d.close()});
d.addEventListener('keydown',function(e){if(e.key=='ArrowRight')show(i+1);else if(e.key=='ArrowLeft')show(i-1)});
d.addEventListener('touchstart',function(e){x=e.touches[0].clientX},{passive:true});
d.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-x;if(Math.abs(dx)>50)show(i+(dx<0?1:-1))});
d.addEventListener('close',function(){l[i].focus()})})();
</script>
