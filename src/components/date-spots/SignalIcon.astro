---
import WindowGlyph from "./WindowGlyph.astro";

// The verdict's window, per occasion: lit means go, half-lit means read the
// reason first, unlit means we would send you elsewhere. The label always
// sits next to it; this is decoration.
interface Props { assessment: "ideal" | "caveat" | "not-for"; class?: string; }
const { assessment, class: className } = Astro.props;
const state = assessment === "ideal" ? "lit" : assessment === "caveat" ? "half" : "unlit";
---
<WindowGlyph state={state} class:list={["mt-1 h-5 w-auto", className]} />
