---
import VerdictBadge from "./VerdictBadge.astro";
import { t, tf, type Locale } from "@i18n/utils";
import { copyLocale, isVenueReview, priceLabel, spotCategory } from "@utils/date-spots";
import type { CollectionEntry } from "astro:content";

// The one fact card per page. "Our take" repeats the page verdict word for
// word, so a reader who goes straight to the sidebar still gets the answer.
// The Google rating is the venue's number, dated, and labelled as theirs.
interface Props { spot: CollectionEntry<"dateSpots">["data"]; locale: Locale; id?: string; class?: string; }
// Rendered twice on review pages (after the verdict on phones, in the sidebar
// on desktop), so the heading id is configurable.
const { spot, locale, id = "essentials-title", class: className } = Astro.props;
const copy = spot.locales[copyLocale(locale)];
const { essentials } = copy;
const category = spotCategory(spot);
const formatDate = (value: string) => new Intl.DateTimeFormat(locale === "fr" ? "fr-CA" : "en-CA", { year: "numeric", month: "long", day: "numeric" }).format(new Date(`${value}T12:00:00`));
const formatAverage = (value: number) => new Intl.NumberFormat(locale === "fr" ? "fr-CA" : "en-CA", { minimumFractionDigits: 1 }).format(value);
const qualifier = "verdictQualifier" in copy ? copy.verdictQualifier : undefined;
const season = "season" in copy ? copy.season : undefined;

const rows: [string, string | undefined][] = isVenueReview(spot)
  ? [
      [t(locale, "dateSpot.cuisine"), "cuisine" in copy ? copy.cuisine : undefined],
      [t(locale, "dateSpot.neighbourhood"), spot.neighbourhood],
      [t(locale, "dateSpot.perPersonLabel"), essentials.cost],
      [t(locale, "dateSpot.canYouTalk"), essentials.canYouTalk],
      [t(locale, "dateSpot.booking"), essentials.booking],
      [t(locale, "dateSpot.allow"), essentials.duration],
      [t(locale, "dateSpot.hours"), essentials.hours],
      [t(locale, "dateSpot.address"), essentials.address],
      [t(locale, "dateSpot.access"), essentials.access],
    ]
  : [
      [t(locale, "dateSpot.category_label"), category && t(locale, `dateSpot.category.${category}`)],
      [t(locale, "dateSpot.cost"), spot.priceRange ? `${essentials.cost} (${priceLabel(spot.priceRange, locale)})` : essentials.cost],
      [t(locale, "dateSpot.allow"), essentials.duration],
      [t(locale, "dateSpot.season"), season],
      [t(locale, "dateSpot.booking"), essentials.booking],
      [t(locale, "dateSpot.hours"), essentials.hours],
      [t(locale, "dateSpot.transit"), essentials.transit],
      [t(locale, "dateSpot.stepFree"), essentials.stepFree],
      [t(locale, "dateSpot.address"), essentials.address],
      [t(locale, "dateSpot.access"), essentials.access],
    ];
const snapshots = spot.googleReviews ?? [];
---
<section aria-labelledby={id} data-pagefind-ignore={id !== "essentials-title" || undefined} class:list={[className, "card"]}>
  <h2 id={id} class="text-heading-3 text-ink">{t(locale, "dateSpot.essentials")}</h2>
  <div class="mt-5 border-b border-line pb-5">
    <p class="eyebrow">{t(locale, "dateSpot.ourTake")}</p>
    <VerdictBadge verdict={spot.reviewVerdict} locale={locale} qualifier={qualifier} class="mt-3" />
  </div>
  <dl class="divide-y divide-line font-ui text-body-sm">
    {rows.filter(([, value]) => value).map(([label, value]) => (
      <div class="flex justify-between gap-4 py-3"><dt class="shrink-0 text-ink-subtle">{label}</dt><dd class="text-right text-ink">{value}</dd></div>
    ))}
    {spot.instagram && <div class="flex justify-between gap-4 py-3"><dt class="text-ink-subtle">{t(locale, "dateSpot.instagram")}</dt><dd><a href={`https://www.instagram.com/${spot.instagram}/`} rel="external noopener" class="text-accent-ink underline decoration-1 underline-offset-4">@{spot.instagram}</a></dd></div>}
    {snapshots.length > 0 && <div class="py-3">
      <dt class="text-ink-subtle">{t(locale, "dateSpot.googleReviews")}</dt>
      {snapshots.map((snapshot, index) => (
        <dd class="mt-1 tabular-nums text-ink">
          {tf(locale, "dateSpot.googleCount", { average: formatAverage(snapshot.average), count: snapshot.count })}
          <span class="block text-caption text-ink-subtle">{index === snapshots.length - 1 ? tf(locale, "dateSpot.googleAsOf", { date: formatDate(snapshot.asOf) }) : formatDate(snapshot.asOf)}</span>
        </dd>
      ))}
      <dd class="mt-1 font-body text-caption italic text-ink-subtle">{t(locale, "dateSpot.googleTheirs")}</dd>
    </div>}
    {copy.paymentDisclosure && <div class="py-3"><dt class="text-ink-subtle">{t(locale, "dateSpot.disclosure")}</dt><dd class="mt-1 text-ink">{copy.paymentDisclosure}</dd></div>}
  </dl>
  {(spot.bookingUrl || spot.mapUrl) && <div class="no-print mt-6 flex flex-wrap gap-3">
    {spot.bookingUrl && <a href={spot.bookingUrl} rel="external noopener" class="btn btn-accent flex-1">{t(locale, "dateSpot.book")}</a>}
    {spot.mapUrl && <a href={spot.mapUrl} rel="external noopener" class="btn btn-secondary flex-1">{t(locale, "dateSpot.map")}</a>}
  </div>}
</section>
