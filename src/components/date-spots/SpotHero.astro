---
// The post header: the title block beside the hero photo, set in the
// greystone window. The photo is the page's LCP image, so it loads eagerly.
// On phones the photo comes first: text above it would re-wrap when the web
// fonts swap in and push the whole photo down (CLS).
interface Props {
  image: { src: string; width: number; height: number };
  alt: string;
  caption?: string;
}
const { image, alt, caption } = Astro.props;
---
<header class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-16">
  <div class="min-w-0">
    <slot />
  </div>
  <figure class="order-first mx-auto w-full max-w-md lg:order-none lg:max-w-none">
    <img src={image.src} width={image.width} height={image.height} alt={alt} class="aspect-[4/5] w-full rounded-arch bg-surface-sunken object-cover" loading="eager" fetchpriority="high" />
    {caption && <figcaption class="mt-3 font-ui text-caption text-ink-subtle">{caption}</figcaption>}
  </figure>
</header>
