---
import SpotPhoto from "./SpotPhoto.astro";
import type { Locale } from "@i18n/utils";

// The photos the author placed in a section beyond its own slots, in the
// author's order: a strip of photos at the end of the section, one per
// row at full width on a phone and three across from `sm` (DESIGN.md, `.arch`). Renders
// nothing without photos.
interface Photo { src: string; width: number; height: number; large?: string; credit?: string; }
interface Props { photos?: Record<string, Photo>; references?: { photo: string; alt: string }[]; locale: Locale; class?: string; }
const { photos, references = [], locale, class: className } = Astro.props;
const shown = references.filter((reference) => photos?.[reference.photo]);
---
{shown.length > 0 && <div class:list={["grid items-start gap-4 sm:grid-cols-3 sm:gap-6", className]}>
  {shown.map((reference) => <SpotPhoto photos={photos} reference={reference} locale={locale} />)}
</div>}
