---
import { getAlternateUrl, type Locale } from "@i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  twitterCard?: "summary" | "summary_large_image";
  noindex?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  /** For recipe pages: the translation slug to build hreflang for the paired recipe */
  translationSlug?: string;
}

const {
  title,
  description,
  locale,
  canonical,
  ogImage,
  ogType = "website",
  twitterCard = "summary_large_image",
  noindex = false,
  publishDate,
  updatedDate,
  translationSlug,
} = Astro.props;

const siteUrl = "https://datemydish.com";
const fullCanonical = canonical.startsWith("http") ? canonical : `${siteUrl}${canonical}`;
const fullOgImage = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage}`
  : undefined;

// Build hreflang URLs
const targetLocale = locale === "en" ? "fr" : "en";
let alternateUrl: string;

if (translationSlug) {
  // Recipe page: use translationSlug for the paired recipe
  const prefix = targetLocale === "fr" ? "recettes" : "recipes";
  alternateUrl = `${siteUrl}/${targetLocale}/${prefix}/${translationSlug}`;
} else {
  // Non-recipe page: use route mapping
  alternateUrl = `${siteUrl}${getAlternateUrl(Astro.url, targetLocale)}`;
}

const currentUrl = fullCanonical;
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={fullCanonical} />

<!-- Hreflang -->
<link rel="alternate" hreflang={locale} href={currentUrl} />
<link rel="alternate" hreflang={targetLocale} href={alternateUrl} />
<link rel="alternate" hreflang="x-default" href={locale === "en" ? currentUrl : alternateUrl} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={fullCanonical} />
<meta property="og:locale" content={locale === "en" ? "en_US" : "fr_CA"} />
<meta property="og:locale:alternate" content={locale === "en" ? "fr_CA" : "en_US"} />
<meta property="og:site_name" content="Date My Dish" />
{fullOgImage && <meta property="og:image" content={fullOgImage} />}

<!-- Twitter Cards -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{fullOgImage && <meta name="twitter:image" content={fullOgImage} />}

<!-- Article dates -->
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
