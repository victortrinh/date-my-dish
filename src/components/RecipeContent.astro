---
import { t, type Locale } from "@i18n/utils";

interface HowToStep {
  text: string;
  image?: string;
}

interface IngredientGroup {
  group?: string;
  items: string[];
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Props {
  locale: Locale;
  ingredientGroups: IngredientGroup[];
  instructionGroups: InstructionGroup[];
}

const { locale, ingredientGroups, instructionGroups } = Astro.props;
---

<div id="recipe" class="scroll-mt-20">
  <!-- Ingredients -->
  <section class="mb-8 rounded-xl bg-amber-50 p-6">
    <h2 class="mb-4 font-heading text-2xl font-bold text-gray-900">
      {t(locale, "recipe.ingredients")}
    </h2>
    {ingredientGroups.map((group) => (
      <div class="mb-4 last:mb-0">
        {group.group && (
          <h3 class="mb-2 font-heading text-lg font-semibold text-gray-700">{group.group}</h3>
        )}
        <ul class="space-y-2">
          {group.items.map((item, i) => (
            <li class="flex items-start gap-3">
              <input
                type="checkbox"
                id={`ing-${ingredientGroups.indexOf(group)}-${i}`}
                class="mt-1 h-4 w-4 shrink-0 cursor-pointer rounded border-gray-300 text-brand-green accent-brand-green"
              />
              <label
                for={`ing-${ingredientGroups.indexOf(group)}-${i}`}
                class="cursor-pointer text-gray-700 peer-checked:text-gray-400 peer-checked:line-through"
              >
                {item}
              </label>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- Instructions -->
  <section class="mb-8">
    <h2 class="mb-4 font-heading text-2xl font-bold text-gray-900">
      {t(locale, "recipe.instructions")}
    </h2>
    {instructionGroups.map((group) => (
      <div class="mb-6 last:mb-0">
        {group.group && (
          <h3 class="mb-3 font-heading text-lg font-semibold text-gray-700">{group.group}</h3>
        )}
        <ol class="space-y-4">
          {group.steps.map((step, i) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-blue font-ui text-sm font-bold text-white">
                {i + 1}
              </span>
              <div class="pt-1">
                <p class="text-gray-700">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</div>

<style>
  @media print {
    input[type="checkbox"] {
      -webkit-appearance: none;
      appearance: none;
      width: 12px;
      height: 12px;
      border: 1px solid #000;
      border-radius: 2px;
    }
  }
</style>
