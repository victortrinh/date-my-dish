---
import { t, type Locale } from "@i18n/utils";
import { formatDuration } from "@utils/format";
import InstructionSteps from "./InstructionSteps.astro";
import type { ImageMetadata } from "astro";

interface HowToStep {
  text: string;
  image?: ImageMetadata;
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Props {
  locale: Locale;
  title: string;
  prepTime: string;
  cookTime: string;
  totalTime: string;
  recipeYield: string;
  difficulty: "easy" | "medium" | "hard";
  instructionGroups: InstructionGroup[];
  sourceUrl: string;
}

const {
  locale,
  title,
  prepTime,
  cookTime,
  totalTime,
  recipeYield,
  difficulty,
  instructionGroups,
  sourceUrl,
} = Astro.props;

const difficultyLabels = {
  easy: t(locale, "recipe.easy"),
  medium: t(locale, "recipe.medium"),
  hard: t(locale, "recipe.hard"),
};
---

<div id="recipe" class="scroll-mt-20">
  <!-- Print-only header -->
  <div class="print-recipe-header print-only mb-6 border-b border-warm-200 pb-6 dark:border-warm-600">
    <h2 class="mb-3 font-heading text-2xl font-bold text-warm-900 dark:text-warm-100">{title}</h2>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-warm-700 dark:text-warm-300">
      <span>{t(locale, "recipe.prepTime")}: {formatDuration(prepTime, locale)}</span>
      <span>{t(locale, "recipe.cookTime")}: {formatDuration(cookTime, locale)}</span>
      <span>{t(locale, "recipe.totalTime")}: {formatDuration(totalTime, locale)}</span>
      <span>{t(locale, "recipe.servings")}: {recipeYield}</span>
      <span>{t(locale, "recipe.difficulty")}: {difficultyLabels[difficulty]}</span>
    </div>
  </div>

  <!-- Instructions -->
  <InstructionSteps locale={locale} instructionGroups={instructionGroups} recipeUrl={sourceUrl} recipeTitle={title} />

  <!-- Print-only source URL -->
  <footer class="print-recipe-footer print-only border-t border-warm-300 pt-3 text-center text-xs text-warm-500">
    {t(locale, "recipe.source")}: {sourceUrl}
  </footer>
</div>

<style>
  .print-only {
    display: none;
  }

  @media print {
    .print-only {
      display: block;
    }
  }
</style>
