---
import { Picture } from "astro:assets";
import { t, type Locale } from "@i18n/utils";
import type { ImageMetadata } from "astro";

interface HowToStep {
  text: string;
  image?: ImageMetadata;
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Props {
  locale: Locale;
  instructionGroups: InstructionGroup[];
}

const { locale, instructionGroups } = Astro.props;
---

<section class="instruction-steps">
  <h2 class="mb-6 font-heading text-heading-2 font-bold text-gray-900 dark:text-neutral-100">
    {t(locale, "recipe.instructions")}
  </h2>
  {instructionGroups.map((group) => (
    <div class="mb-8 last:mb-0">
      {group.group && (
        <h3 class="mb-4 font-heading text-heading-3 font-semibold text-gray-700 dark:text-neutral-300">{group.group}</h3>
      )}
      <ol class="space-y-6">
        {group.steps.map((step, i) => (
          <li class="flex gap-4">
            <span aria-hidden="true" class="step-number flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-primary-dark font-ui text-lg font-bold text-white ring-4 ring-brand-primary/20">
              {i + 1}
            </span>
            <div class="pt-0.5">
              <p class="text-gray-700 dark:text-neutral-300">{step.text}</p>
              {step.image && (
                <Picture
                  src={step.image}
                  alt={`${t(locale, "recipe.instructions")} ${i + 1}: ${step.text.slice(0, 120)}`}
                  widths={[400, 600, 900]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 75vw, 60vw"
                  formats={["avif", "webp"]}
                  class="step-image mt-4 max-w-full rounded-lg sm:max-w-[75%] lg:max-w-[60%]"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  ))}
</section>
