---
import { Picture } from "astro:assets";
import { t, type Locale } from "@i18n/utils";
import type { ImageMetadata } from "astro";

interface HowToStep {
  text: string;
  image?: ImageMetadata;
  images?: ImageMetadata[];
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Props {
  locale: Locale;
  instructionGroups: InstructionGroup[];
  recipeUrl?: string;
  recipeTitle?: string;
}

const { locale, instructionGroups, recipeUrl, recipeTitle } = Astro.props;
let globalStepNumber = 0;
const allSingleStep = instructionGroups.every((g) => g.steps.length === 1);

function getStepImages(step: HowToStep): ImageMetadata[] {
  const imgs: ImageMetadata[] = [];
  if (step.image) imgs.push(step.image);
  if (step.images) imgs.push(...step.images);
  return imgs;
}
---

<section class="instruction-steps">
  <h2 class="mb-6 font-heading text-heading-2 font-normal text-warm-900 dark:text-warm-100">
    {t(locale, "recipe.instructions")}
  </h2>
  {allSingleStep ? (
    <ol class="space-y-6">
      {instructionGroups.map((group) => {
        const step = group.steps[0];
        globalStepNumber++;
        return (
          <li class="flex gap-4">
            <span aria-hidden="true" class="step-number flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-wine font-ui text-sm font-bold text-white">
              {globalStepNumber}
            </span>
            <div class="pt-0.5">
              <p class="text-warm-700 dark:text-warm-300">
                {group.group && <strong class="text-warm-900 dark:text-warm-100">{group.group}: </strong>}
                {step.text}
              </p>
              {(() => {
                const imgs = getStepImages(step);
                const isMulti = imgs.length > 1;
                return imgs.length > 0 && (
                  <div class={isMulti ? "mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2" : ""}>
                    {imgs.map((img) => (
                      <Picture
                        src={img}
                        alt={`${t(locale, "recipe.instructions")} ${globalStepNumber}: ${step.text.slice(0, 120)}`}
                        widths={[300, 450, 600]}
                        sizes={isMulti ? "(max-width: 640px) 100vw, 45vw" : "(max-width: 640px) 100vw, (max-width: 1024px) 75vw, 60vw"}
                        formats={["avif", "webp"]}
                        class={isMulti ? "step-image w-full rounded-lg" : "step-image mt-4 max-w-full rounded-lg sm:max-w-[75%] lg:max-w-[60%]"}
                        loading="lazy"
                        decoding="async"
                        data-pin-url={recipeUrl}
                        data-pin-description={recipeTitle ? `${recipeTitle} - Step ${globalStepNumber}: ${step.text.slice(0, 200)} | Date My Dish` : undefined}
                      />
                    ))}
                  </div>
                );
              })()}
            </div>
          </li>
        );
      })}
    </ol>
  ) : (
    instructionGroups.map((group) => (
      <div class="mb-8 last:mb-0">
        {group.group && (
          <h3 class="mb-4 font-heading text-heading-3 font-semibold text-warm-700 dark:text-warm-300">{group.group}</h3>
        )}
        <ol class="space-y-6">
          {group.steps.map((step, i) => {
            globalStepNumber++;
            return (
              <li class="flex gap-4">
                <span aria-hidden="true" class="step-number flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-wine font-ui text-sm font-bold text-white">
                  {i + 1}
                </span>
                <div class="pt-0.5">
                  <p class="text-warm-700 dark:text-warm-300">{step.text}</p>
                  {(() => {
                    const imgs = getStepImages(step);
                    const isMulti = imgs.length > 1;
                    return imgs.length > 0 && (
                      <div class={isMulti ? "mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2" : ""}>
                        {imgs.map((img) => (
                          <Picture
                            src={img}
                            alt={`${t(locale, "recipe.instructions")} ${i + 1}: ${step.text.slice(0, 120)}`}
                            widths={[300, 450, 600]}
                            sizes={isMulti ? "(max-width: 640px) 100vw, 45vw" : "(max-width: 640px) 100vw, (max-width: 1024px) 75vw, 60vw"}
                            formats={["avif", "webp"]}
                            class={isMulti ? "step-image w-full rounded-lg" : "step-image mt-4 max-w-full rounded-lg sm:max-w-[75%] lg:max-w-[60%]"}
                            loading="lazy"
                            decoding="async"
                            data-pin-url={recipeUrl}
                            data-pin-description={recipeTitle ? `${recipeTitle} - Step ${globalStepNumber}: ${step.text.slice(0, 200)} | Date My Dish` : undefined}
                          />
                        ))}
                      </div>
                    );
                  })()}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))
  )}
</section>
