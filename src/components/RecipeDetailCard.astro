---
import { t, type Locale } from "@i18n/utils";
import type { ImageMetadata } from "astro";

interface IngredientGroup {
  group?: string;
  items: string[];
}

interface HowToStep {
  text: string;
  image?: ImageMetadata;
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Nutrition {
  calories?: string;
  fatContent?: string;
  carbohydrateContent?: string;
  proteinContent?: string;
}

interface Props {
  locale: Locale;
  title: string;
  heroImageSrc: string;
  prepTime: string;
  cookTime: string;
  totalTime: string;
  recipeYield: string;
  ingredientGroups: IngredientGroup[];
  instructionGroups: InstructionGroup[];
  nutrition?: Nutrition;
  impressFactor?: number;
  sourceUrl: string;
}

const {
  locale,
  title,
  heroImageSrc,
  prepTime,
  cookTime,
  totalTime,
  recipeYield,
  ingredientGroups,
  instructionGroups,
  nutrition,
  impressFactor,
  sourceUrl,
} = Astro.props;

const hasNutrition = nutrition && (nutrition.calories || nutrition.fatContent || nutrition.carbohydrateContent || nutrition.proteinContent);
const allSingleStep = instructionGroups.every((g) => g.steps.length === 1);

const hearts = impressFactor ? Array.from({ length: 5 }, (_, i) => i < impressFactor) : [];
---

<article
  id="recipe-card"
  itemscope
  itemtype="https://schema.org/Recipe"
  class="recipe-detail-card scroll-mt-20 overflow-hidden rounded-2xl border border-brand-wine/5 bg-white shadow-2xl dark:border-warm-700 dark:bg-warm-900"
>
  <!-- Burgundy Header Bar -->
  <div class="no-print flex flex-wrap items-center justify-between bg-brand-wine px-6 py-5 lg:px-8">
    <div>
      <h2 class="font-heading text-2xl italic text-white sm:text-3xl">
        {t(locale, "recipe.theOfficialRecipe")}
      </h2>
      <meta itemprop="name" content={title} />
      <meta itemprop="image" content={heroImageSrc} />
      {impressFactor && (
        <div class="mt-1 flex items-center gap-2">
          <span class="text-xs font-medium uppercase tracking-widest text-white/60">
            {t(locale, "dateNight.impressFactor")}:
          </span>
          <div class="flex gap-0.5">
            {hearts.map((filled) => (
              <svg xmlns="http://www.w3.org/2000/svg" class:list={["h-4 w-4", filled ? "text-brand-rose" : "text-white/30"]} viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
              </svg>
            ))}
          </div>
        </div>
      )}
    </div>
    <div class="mt-4 flex gap-2 sm:mt-0">
      <button
        onclick="window.print()"
        class="rounded-lg bg-white/10 p-2 text-white transition-colors hover:bg-white/20"
        aria-label={t(locale, "recipe.printRecipe")}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
      </button>
      <button
        class="card-share-btn rounded-lg bg-white/10 p-2 text-white transition-colors hover:bg-white/20"
        data-url={sourceUrl}
        data-title={title}
        aria-label={t(locale, "recipe.share")}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Print-only title -->
  <div class="recipe-detail-card-print-title px-6 pt-6 lg:px-8">
    <h2 itemprop="name" class="font-heading text-2xl font-normal text-warm-900 sm:text-3xl dark:text-warm-100">
      {title}
    </h2>
  </div>

  <!-- Recipe Details -->
  <div class="recipe-detail-card-content divide-y divide-warm-100 dark:divide-warm-800">

      <!-- Hidden structured data meta tags -->
      <meta itemprop="prepTime" content={prepTime} />
      <meta itemprop="cookTime" content={cookTime} />
      <meta itemprop="totalTime" content={totalTime} />
      <meta itemprop="recipeYield" content={recipeYield} />

      <!-- Nutrition -->
      {hasNutrition && (
        <div class="p-6 lg:p-8">
          <h3 class="mb-3 font-heading text-base font-normal text-warm-900 dark:text-warm-100">
            {t(locale, "recipe.nutrition")}
            <span class="ml-2 text-xs font-normal text-warm-500 dark:text-warm-400">
              ({t(locale, "recipe.perServing")})
            </span>
          </h3>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            {nutrition!.calories && (
              <div class="rounded-lg bg-warm-50 p-3 text-center dark:bg-warm-800">
                <p class="text-base font-bold text-brand-wine-text">{nutrition!.calories}</p>
                <p class="text-xs font-medium uppercase tracking-wider text-warm-500 dark:text-warm-400">{t(locale, "recipe.calories")}</p>
              </div>
            )}
            {nutrition!.fatContent && (
              <div class="rounded-lg bg-warm-50 p-3 text-center dark:bg-warm-800">
                <p class="text-base font-bold text-brand-wine-text">{nutrition!.fatContent}</p>
                <p class="text-xs font-medium uppercase tracking-wider text-warm-500 dark:text-warm-400">{t(locale, "recipe.fat")}</p>
              </div>
            )}
            {nutrition!.carbohydrateContent && (
              <div class="rounded-lg bg-warm-50 p-3 text-center dark:bg-warm-800">
                <p class="text-base font-bold text-brand-wine-text">{nutrition!.carbohydrateContent}</p>
                <p class="text-xs font-medium uppercase tracking-wider text-warm-500 dark:text-warm-400">{t(locale, "recipe.carbs")}</p>
              </div>
            )}
            {nutrition!.proteinContent && (
              <div class="rounded-lg bg-warm-50 p-3 text-center dark:bg-warm-800">
                <p class="text-base font-bold text-brand-wine-text">{nutrition!.proteinContent}</p>
                <p class="text-xs font-medium uppercase tracking-wider text-warm-500 dark:text-warm-400">{t(locale, "recipe.protein")}</p>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Ingredients + Instructions -->
      <div class="recipe-detail-card-body grid grid-cols-1 gap-8 p-6 sm:grid-cols-2 lg:p-8">

        <!-- Ingredients -->
        <section class="recipe-detail-card-ingredients">
          <h3 class="mb-4 font-heading text-xl font-normal text-warm-900 dark:text-warm-100">
            {t(locale, "recipe.ingredients")}
          </h3>
          {ingredientGroups.map((group, gi) => (
            <div class="mb-4 last:mb-0">
              {group.group && (
                <h4 class="mb-2 font-heading text-xs font-semibold normal-case tracking-wide text-warm-500 dark:text-warm-400">
                  {group.group}
                </h4>
              )}
              <ul class="space-y-2">
                {group.items.map((item, i) => (
                  <li class="flex items-start gap-3">
                    <input
                      type="checkbox"
                      id={`card-ing-${gi}-${i}`}
                      class="peer mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded border-warm-400 accent-brand-rose"
                    />
                    <label
                      for={`card-ing-${gi}-${i}`}
                      itemprop="recipeIngredient"
                      class="cursor-pointer text-sm text-warm-700 peer-checked:text-warm-400 peer-checked:line-through dark:text-warm-300 dark:peer-checked:text-warm-500"
                    >
                      {item}
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <!-- Instructions -->
        <section class="recipe-detail-card-instructions">
          <h3 class="mb-4 font-heading text-xl font-normal text-warm-900 dark:text-warm-100">
            {t(locale, "recipe.instructions")}
          </h3>
          {allSingleStep ? (
            <ol class="space-y-4">
              {instructionGroups.map((group, idx) => {
                const step = group.steps[0];
                return (
                  <li itemprop="recipeInstructions" class="flex gap-3">
                    <span
                      aria-hidden="true"
                      class="recipe-detail-step-number flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-wine font-ui text-xs font-bold text-white"
                    >
                      {idx + 1}
                    </span>
                    <p class="pt-0.5 text-body-sm leading-relaxed text-warm-700 dark:text-warm-300">
                      {group.group && <strong class="text-warm-900 dark:text-warm-100">{group.group}: </strong>}
                      {step.text}
                    </p>
                  </li>
                );
              })}
            </ol>
          ) : (
            instructionGroups.map((group) => (
              <div class="mb-6 last:mb-0">
                {group.group && (
                  <h4 class="mb-3 font-heading text-xs font-semibold normal-case tracking-wide text-warm-500 dark:text-warm-400">
                    {group.group}
                  </h4>
                )}
                <ol class="space-y-4">
                  {group.steps.map((step, i) => (
                    <li itemprop="recipeInstructions" class="flex gap-3">
                      <span
                        aria-hidden="true"
                        class="recipe-detail-step-number flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-wine font-ui text-xs font-bold text-white"
                      >
                        {i + 1}
                      </span>
                      <p class="pt-0.5 text-body-sm leading-relaxed text-warm-700 dark:text-warm-300">
                        {step.text}
                      </p>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          )}
        </section>

      </div>

      <!-- Social Actions Slot -->
      <slot name="social" />

      <!-- Print-only source footer -->
      <div class="recipe-detail-card-footer px-6 py-3 text-center text-xs text-warm-500">
        {t(locale, "recipe.source")}: {sourceUrl}
      </div>

  </div>
</article>

<style>
  .recipe-detail-card-print-title {
    display: none;
  }

  .recipe-detail-card-footer {
    display: none;
  }

  @media print {
    .recipe-detail-card-print-title {
      display: block;
    }

    .recipe-detail-card-footer {
      display: block;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.card-share-btn').forEach(function(btn) {
    if (btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    btn.addEventListener('click', async function() {
      var url = this.dataset.url;
      var title = this.dataset.title;
      if (navigator.share) {
        try { await navigator.share({ title: title, url: url }); } catch (e) {}
      } else if (navigator.clipboard) {
        await navigator.clipboard.writeText(url);
      }
    });
  });
</script>
