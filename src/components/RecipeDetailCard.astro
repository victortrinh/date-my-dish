---
import { Picture } from "astro:assets";
import { t, type Locale } from "@i18n/utils";
import { formatDuration } from "@utils/format";
import ImpressFactor from "@components/ImpressFactor.astro";
import type { ImageMetadata } from "astro";

interface IngredientGroup {
  group?: string;
  items: string[];
}

interface HowToStep {
  text: string;
  image?: ImageMetadata;
}

interface InstructionGroup {
  group?: string;
  steps: HowToStep[];
}

interface Props {
  locale: Locale;
  title: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  prepTime: string;
  cookTime: string;
  totalTime: string;
  recipeYield: string;
  difficulty: "easy" | "medium" | "hard";
  ingredientGroups: IngredientGroup[];
  instructionGroups: InstructionGroup[];
  calories?: string;
  impressFactor?: number;
  sourceUrl: string;
}

const {
  locale,
  title,
  heroImage,
  heroImageAlt,
  prepTime,
  cookTime,
  totalTime,
  recipeYield,
  difficulty,
  ingredientGroups,
  instructionGroups,
  calories,
  impressFactor,
  sourceUrl,
} = Astro.props;

const difficultyColors = {
  easy: "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
  medium: "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400",
  hard: "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400",
};
---

<article
  id="recipe"
  itemscope
  itemtype="https://schema.org/Recipe"
  class="recipe-detail-card scroll-mt-20 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-neutral-700 dark:bg-neutral-900"
>
  <!-- Hero Image (hidden in print) -->
  <div class="recipe-detail-card-image">
    <Picture
      src={heroImage}
      alt={heroImageAlt}
      widths={[400, 600, 900]}
      sizes="(max-width: 768px) 100vw, 768px"
      formats={["avif", "webp"]}
      class="h-56 w-full object-cover sm:h-72"
      loading="lazy"
    />
  </div>

  <!-- Recipe Details -->
  <div class="recipe-detail-card-content divide-y divide-gray-100 dark:divide-neutral-800">

      <!-- Title + Meta Stats -->
      <div class="p-6 lg:p-8">
        <h2
          itemprop="name"
          class="mb-5 font-heading text-2xl font-bold text-gray-900 sm:text-3xl dark:text-neutral-100"
        >
          {title}
        </h2>

        <!-- Meta Stats Bar -->
        <div class="recipe-detail-card-meta flex flex-wrap items-center gap-x-4 gap-y-3 rounded-xl bg-gray-50 px-4 py-3 dark:bg-neutral-800">

          <!-- Prep time -->
          <div class="flex flex-col items-start">
            <span class="text-xs text-gray-500 dark:text-neutral-400">{t(locale, "recipe.prepTime")}</span>
            <time itemprop="prepTime" datetime={prepTime} class="text-sm font-semibold text-gray-900 dark:text-neutral-100">
              {formatDuration(prepTime, locale)}
            </time>
          </div>

          <div aria-hidden="true" class="h-8 w-px bg-gray-200 dark:bg-neutral-700"></div>

          <!-- Cook time -->
          <div class="flex flex-col items-start">
            <span class="text-xs text-gray-500 dark:text-neutral-400">{t(locale, "recipe.cookTime")}</span>
            <time itemprop="cookTime" datetime={cookTime} class="text-sm font-semibold text-gray-900 dark:text-neutral-100">
              {formatDuration(cookTime, locale)}
            </time>
          </div>

          <div aria-hidden="true" class="h-8 w-px bg-gray-200 dark:bg-neutral-700"></div>

          <!-- Total time -->
          <div class="flex flex-col items-start">
            <span class="text-xs text-gray-500 dark:text-neutral-400">{t(locale, "recipe.totalTime")}</span>
            <time itemprop="totalTime" datetime={totalTime} class="text-sm font-semibold text-gray-900 dark:text-neutral-100">
              {formatDuration(totalTime, locale)}
            </time>
          </div>

          <div aria-hidden="true" class="h-8 w-px bg-gray-200 dark:bg-neutral-700"></div>

          <!-- Servings -->
          <div class="flex flex-col items-start">
            <span class="text-xs text-gray-500 dark:text-neutral-400">{t(locale, "recipe.servings")}</span>
            <span itemprop="recipeYield" class="text-sm font-semibold text-gray-900 dark:text-neutral-100">{recipeYield}</span>
          </div>

          <div aria-hidden="true" class="h-8 w-px bg-gray-200 dark:bg-neutral-700"></div>

          <!-- Difficulty -->
          <div class="flex flex-col items-start">
            <span class="text-xs text-gray-500 dark:text-neutral-400">{t(locale, "recipe.difficulty")}</span>
            <span class={`mt-0.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${difficultyColors[difficulty]}`}>
              {t(locale, `recipe.${difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard")}
            </span>
          </div>

          {calories && (
            <>
              <div aria-hidden="true" class="h-8 w-px bg-gray-200 dark:bg-neutral-700"></div>
              <div class="flex flex-col items-start">
                <span class="text-xs text-gray-500 dark:text-neutral-400">{t(locale, "recipe.calories")}</span>
                <span class="text-sm font-semibold text-gray-900 dark:text-neutral-100">{calories}</span>
              </div>
            </>
          )}

          {impressFactor && (
            <>
              <div aria-hidden="true" class="h-8 w-px bg-gray-200 dark:bg-neutral-700"></div>
              <ImpressFactor locale={locale} rating={impressFactor} />
            </>
          )}

        </div>
      </div>

      <!-- Ingredients + Instructions -->
      <div class="recipe-detail-card-body p-6 lg:p-8">

        <!-- Ingredients -->
        <section class="recipe-detail-card-ingredients mb-8">
          <h3 class="mb-4 font-heading text-xl font-bold text-gray-900 dark:text-neutral-100">
            {t(locale, "recipe.ingredients")}
          </h3>
          {ingredientGroups.map((group, gi) => (
            <div class="mb-4 last:mb-0">
              {group.group && (
                <h4 class="mb-2 font-heading text-xs font-semibold normal-case tracking-wide text-gray-500 dark:text-neutral-400">
                  {group.group}
                </h4>
              )}
              <ul class="space-y-2">
                {group.items.map((item, i) => (
                  <li class="flex items-start gap-3">
                    <input
                      type="checkbox"
                      id={`card-ing-${gi}-${i}`}
                      class="peer mt-0.5 h-4 w-4 shrink-0 cursor-pointer rounded border-gray-400 accent-brand-accent"
                    />
                    <label
                      for={`card-ing-${gi}-${i}`}
                      itemprop="recipeIngredient"
                      class="cursor-pointer text-sm text-gray-700 peer-checked:text-gray-400 peer-checked:line-through dark:text-neutral-300 dark:peer-checked:text-neutral-500"
                    >
                      {item}
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <!-- Instructions -->
        <section class="recipe-detail-card-instructions">
          <h3 class="mb-4 font-heading text-xl font-bold text-gray-900 dark:text-neutral-100">
            {t(locale, "recipe.instructions")}
          </h3>
          {instructionGroups.map((group) => (
            <div class="mb-6 last:mb-0">
              {group.group && (
                <h4 class="mb-3 font-heading text-xs font-semibold normal-case tracking-wide text-gray-500 dark:text-neutral-400">
                  {group.group}
                </h4>
              )}
              <ol class="space-y-4">
                {group.steps.map((step, i) => (
                  <li itemprop="recipeInstructions" class="flex gap-3">
                    <span
                      aria-hidden="true"
                      class="recipe-detail-step-number flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-primary-dark font-ui text-xs font-bold text-white"
                    >
                      {i + 1}
                    </span>
                    <p class="pt-0.5 text-sm leading-relaxed text-gray-700 dark:text-neutral-300">
                      {step.text}
                    </p>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </section>

      </div>

      <!-- Print-only source footer -->
      <div class="recipe-detail-card-footer px-6 py-3 text-center text-xs text-gray-500">
        {t(locale, "recipe.source")}: {sourceUrl}
      </div>

  </div>
</article>

<style>
  .recipe-detail-card-footer {
    display: none;
  }

  @media print {
    .recipe-detail-card-footer {
      display: block;
    }
  }
</style>
