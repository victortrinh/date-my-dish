---
import "../styles/global.css";
import SEOHead from "@components/SEOHead.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import SearchOverlay from "@components/SearchOverlay.astro";
import { getLocaleFromUrl, type Locale } from "@i18n/utils";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  translationSlug?: string;
  ogType?: string;
  publishDate?: Date;
  updatedDate?: Date;
  contentType?: "recipe" | "article";
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  translationSlug,
  ogType,
  publishDate,
  updatedDate,
  contentType,
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const resolvedCanonical = canonical || Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Google Fonts: loaded via <link> instead of CSS @import to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=Caveat:wght@400;700&family=Fira+Sans:wght@400;500;600;700&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=Caveat:wght@400;700&family=Fira+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      translationSlug={translationSlug}
      publishDate={publishDate}
      updatedDate={updatedDate}
      contentType={contentType}
    />
    <link rel="alternate" type="application/rss+xml" title="Date My Dish (English)" href="/en/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Date My Dish (Français)" href="/fr/rss.xml" />
    <meta name="p:domain_verify" content="f73563c227b19a404524ccf1d3167dd6"/>
    <script is:inline>
      (function(){var t=localStorage.getItem('dmd_theme');if(!t){var o=localStorage.getItem('theme');if(o){t=o;localStorage.setItem('dmd_theme',o);localStorage.removeItem('theme')}}if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.classList.add('dark')}})();
    </script>
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "2acfc6a04df0427b80b87ca6498542a3"}' is:inline></script>
    <!-- Pinterest Tag (must be before head slot so pintrk is defined for page-specific events) -->
    <script is:inline>
      !function(e){if(!window.pintrk){window.pintrk=function(){window.pintrk.queue.push(Array.prototype.slice.call(arguments))};var n=window.pintrk;n.queue=[],n.version="3.0";var t=document.createElement("script");t.async=!0,t.src=e;var r=document.getElementsByTagName("script")[0];r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
      pintrk('load','2613431123607');
      pintrk('page');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none;" alt="" src="https://ct.pinterest.com/v3/?event=init&tid=2613431123607&noscript=1" />
    </noscript>
    <!-- end Pinterest Tag -->
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-gray-100 dark:bg-neutral-950">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-ui focus:text-sm focus:font-medium focus:text-brand-primary focus:shadow-lg dark:focus:bg-neutral-800 dark:focus:text-brand-primary">
      {locale === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>
    <Navigation locale={locale} translationSlug={translationSlug} contentType={contentType} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchOverlay locale={locale} />
    <script is:inline>
      (function(){
        if(window.matchMedia('(prefers-reduced-motion:reduce)').matches){
          document.querySelectorAll('[data-animate-stagger]>*').forEach(function(el){el.style.opacity='1';el.style.transform='none';});
          return;
        }
        var s=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){var children=e.target.children;for(var i=0;i<children.length;i++){(function(child,delay){setTimeout(function(){child.classList.add('animate-in');},delay);})(children[i],i*100);}s.unobserve(e.target);}});},{threshold:0.05});
        document.querySelectorAll('[data-animate-stagger]').forEach(function(el){s.observe(el);});
      })();
    </script>
  </body>
</html>
