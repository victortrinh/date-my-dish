---
import "../styles/global.css";
import SEOHead from "@components/SEOHead.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import { getLocaleFromUrl, type Locale } from "@i18n/utils";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  translationSlug?: string;
  ogType?: string;
  publishDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  translationSlug,
  ogType,
  publishDate,
  updatedDate,
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const resolvedCanonical = canonical || Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Preload critical fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      translationSlug={translationSlug}
      publishDate={publishDate}
      updatedDate={updatedDate}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <Navigation locale={locale} translationSlug={translationSlug} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": ""}'></script>
  </body>
</html>
