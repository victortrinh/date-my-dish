---
import "../styles/global.css";
import SEOHead from "@components/SEOHead.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import SearchOverlay from "@components/SearchOverlay.astro";
import { getLocaleFromUrl, type Locale } from "@i18n/utils";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  translationSlug?: string;
  ogType?: string;
  publishDate?: Date;
  updatedDate?: Date;
  contentType?: "recipe" | "article" | "review" | "date-spot";
  /** The paired page's path in the other locale; overrides translationSlug/contentType. */
  alternatePath?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  translationSlug,
  ogType,
  publishDate,
  updatedDate,
  contentType,
  alternatePath,
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url) as Locale;
const resolvedCanonical = canonical || Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#e7e5e1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171a" media="(prefers-color-scheme: dark)" />
    <!-- Google Fonts: variable fonts via CSS2 API. The stylesheet loads as
         media="print" and switches to "all" once fetched, so the font files never block first paint on mobile (performance budget:
         mobile 95+, LCP 2.5 s). Text paints in the fallback font, then swaps. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Hanken+Grotesk:wght@400..700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Hanken+Grotesk:wght@400..700&display=swap" rel="stylesheet" /></noscript>
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonical={resolvedCanonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      translationSlug={translationSlug}
      publishDate={publishDate}
      updatedDate={updatedDate}
      contentType={contentType}
      alternatePath={alternatePath}
    />
    <link rel="alternate" type="application/rss+xml" title="Date My Dish (English)" href="/en/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Date My Dish (Français)" href="/fr/rss.xml" />
    <meta name="p:domain_verify" content="f73563c227b19a404524ccf1d3167dd6"/>
    <!-- Before first paint: the theme, then .js-reveal, which lets the reveal
         script below hide what starts below the fold (only with JS on and
         motion allowed; without it every element stays visible). -->
    <script is:inline>
      (function(){var d=document.documentElement;if('IntersectionObserver' in window&&matchMedia('(prefers-reduced-motion: no-preference)').matches)d.classList.add('js-reveal');var t=localStorage.getItem('dmd_theme');if(!t){var o=localStorage.getItem('theme');if(o){t=o;localStorage.setItem('dmd_theme',o);localStorage.removeItem('theme')}}if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.classList.add('dark')}})();
    </script>
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "2acfc6a04df0427b80b87ca6498542a3"}' is:inline></script>
    <!-- Google Analytics 4 -->
    <!-- gtag.js (~180 KB) is fetched after the load event so it never competes
         with the hero for bandwidth (performance budget: mobile 95+, LCP 2.5 s).
         Calls made before it arrives queue in dataLayer. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-95FS4CF63K');
      window.addEventListener('load', function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-95FS4CF63K';document.head.appendChild(s);});
    </script>
    <!-- Ahrefs Analytics -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="t2xKSou59Mr4fNd9hqYmEg" async is:inline></script>
    <!-- Pinterest Tag (must be before head slot so pintrk is defined for page-specific events) -->
    <script is:inline>
      !function(e){if(!window.pintrk){window.pintrk=function(){window.pintrk.queue.push(Array.prototype.slice.call(arguments))};var n=window.pintrk;n.queue=[],n.version="3.0";var t=document.createElement("script");t.async=!0,t.src=e;var r=document.getElementsByTagName("script")[0];r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
      pintrk('load','2613431123607');
      pintrk('page');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none;" alt="" src="https://ct.pinterest.com/v3/?event=init&tid=2613431123607&noscript=1" />
    </noscript>
    <!-- end Pinterest Tag -->
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:font-ui focus:text-sm focus:font-medium focus:text-surface focus:no-underline">
      {locale === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>
    <Navigation locale={locale} translationSlug={translationSlug} contentType={contentType} alternatePath={alternatePath} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchOverlay locale={locale} />
    <!-- Quiet reveals and the verdict settle (DESIGN.md, Motion). Emitted once,
         here. Anything on screen at load is left alone (LCP, CLS); anything
         below the fold is marked .reveal-pending and revealed once when it
         scrolls in. Elements entering together are staggered. Skipped on
         back/forward, where the reader has already seen the page. -->
    <script is:inline>
      (function(){
        var d=document.documentElement;
        if(!d.classList.contains('js-reveal'))return;
        var nav=performance.getEntriesByType&&performance.getEntriesByType('navigation')[0];
        if(nav&&nav.type==='back_forward')return;
        var io=new IntersectionObserver(function(entries){
          var step=0;
          entries.forEach(function(entry){
            if(!entry.isIntersecting)return;
            var el=entry.target;
            io.unobserve(el);
            if(el.hasAttribute('data-reveal'))el.style.setProperty('--reveal-delay',Math.min(step++,4)*90+'ms');
            el.classList.remove('reveal-pending');
            el.classList.add('is-revealed');
          });
        },{rootMargin:'0px 0px -8% 0px'});
        var fold=window.innerHeight;
        document.querySelectorAll('[data-reveal],[data-settle]').forEach(function(el){
          var box=el.getBoundingClientRect();
          if(box.bottom>0&&box.top<fold){if(el.hasAttribute('data-settle'))el.classList.add('is-revealed');return;}
          el.classList.add('reveal-pending');
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
