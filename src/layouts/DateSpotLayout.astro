---
import BaseLayout from "./BaseLayout.astro";
import type { Locale } from "@i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonical: string;
  ogImage: string;
  translationSlug: string;
  published: string;
  lastChecked: string;
}

const { title, description, locale, canonical, ogImage, translationSlug, published, lastChecked } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  translationSlug={translationSlug}
  ogType="article"
  publishDate={new Date(`${published}T00:00:00Z`)}
  updatedDate={new Date(`${lastChecked}T00:00:00Z`)}
  contentType="date-spot"
>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
