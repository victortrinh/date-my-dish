{
  "name": "date-my-dish",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/validate-descriptions.mjs && node scripts/validate-source.mjs && node scripts/fetch-ratings.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "validate:source": "node scripts/validate-descriptions.mjs && node scripts/validate-source.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "postbuild": "node scripts/generate-recipe-index.mjs && npx pagefind --site dist/client && node scripts/validate-build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "npx playwright test",
    "test:update-snapshots": "npx playwright test --update-snapshots"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "googleapis": "^174.0.0",
    "gray-matter": "^4.0.3",
    "notion-client": "^7.8.2",
    "notion-types": "^7.8.2",
    "notion-utils": "^7.8.2",
    "pagefind": "^1.3.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.0",
    "wrangler": "^4.68.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.1"
  },
  "overrides": {
    "@astrojs/check": {
      "typescript": "$typescript"
    }
  }
}
