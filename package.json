{
  "name": "date-my-dish",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetch-ratings.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "postbuild": "node scripts/generate-recipe-index.mjs && npx pagefind --site dist",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "npx playwright test",
    "test:update-snapshots": "npx playwright test --update-snapshots"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.5.0",
    "sharp": "^0.33.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@astrojs/check": "^0.9.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "notion-client": "^7.8.2",
    "notion-types": "^7.8.2",
    "notion-utils": "^7.8.2",
    "pagefind": "^1.3.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.68.0"
  }
}
